|\n            document.querySelector(`gux-tab[tab-id=\"${tabId}\"]`);\n        if (tab && typeof tab.guxFocus === \"function\") {\n            void Promise.resolve(tab.guxFocus()).catch(function () {});\n        }\n    }, 0);\n\n    const deleteCalibrationCallback = function (calibrationId, evaluationIds) {\n        if (qualityAuthorization.canDeleteCalibration()) {\n            evaluationIds.forEach((evaluationId) =>\n                self.removeSidePanelEvaluation(evaluationId)\n            );\n            return qualityManagementService\n                .deleteCalibration(calibrationId)\n                .then(function () {\n                    self.calibrations().entities = self\n                        .calibrations()\n                        .entities.filter(\n                            (entity) => entity.id !== calibrationId\n                        );\n                    self.tabbedDetails.removeActiveTabView();\n                    focusConversationDetailsNavControl();\n                    toasts.notifyMessage(\n                        \"playback.nav.calibration.deleted.title\",\n                        {\n                            bodyMessageKey:\n                                \"playback.nav.calibration.deleted.msg\",\n                        }\n                    );\n                })\n                .catch(function () {\n                    toasts.notifyMinorAlert(\n                        \"playback.nav.calibration.not.deleted.title\",\n                        {\n                            bodyMessageKey:\n                                \"playback.nav.calibration.not.deleted.msg\",\n                        }\n                    );\n                });\n        }\n    };\n\n    self.addSidePanelEvaluation = async function (\n        conversationId,\n        assignedEvaluationId,\n        isAdminContext\n    ) {\n        if (!self.sidepanel.containsView(assignedEvaluationId)) {\n            const evaluation =\n                await qualityManagementService.getAssignedEvaluation(\n                    conversationId,\n                    assignedEvaluationId\n                );\n            const args = [\n                FormType.evaluation,\n                assignedEvaluationId,\n                conversationId,\n                isAdminContext,\n                self.deleteEvaluation,\n                self.closePanel,\n            ];\n            const queryParams = getDecodedQueryParamsFromWindow();\n            args.push(queryParams.assignmentPanel);\n            const qualityFormTimeMachineBranch = queryParams.qualityFormVersion;\n            if (qualityFormTimeMachineBranch) {\n                args.push(qualityFormTimeMachineBranch);\n            }\n            self.sidepanel.addView(assignedEvaluationId, {\n                view: EmbeddedQualityFormEditor,\n                viewTitle: evaluation.evaluationForm.name,\n                onClose: () => {\n                    navHelper.navigateTo(\n                        navHelper.asHostHash(\n                            removeQueryParamFromWindow(\"evaluationId\")\n                        ),\n                        undefined,\n                        false\n                    );\n                },\n                arguments: args,\n                template: \"templates/composer/forms/embeddedQualityFormEditor\",\n                persist: true,\n                showHeader: false,\n            });\n        }\n    };\n\n    self.activateSidePanelEvaluation = async function (assignedEvaluationId) {\n        const isAdminContext = hashContext === PlaybackContext.ADMIN;\n        await self.addSidePanelEvaluation(\n            self.conversationId(),\n            assignedEvaluationId,\n            isAdminContext\n        );\n        self.sidepanel.setActiveView(\n            assignedEvaluationId,\n            self.conversationId(),\n            assignedEvaluationId,\n            isAdminContext,\n            self.deleteEvaluation\n        );\n    };\n\n    self.removeSidePanelEvaluation = function (assignedEvaluationId) {\n        self.sidepanel.removeView(assignedEvaluationId);\n    };\n\n    self.subscribe(self.evaluationId, (evaluationId) => {\n        if (evaluationId) {\n            self.activateSidePanelEvaluation(evaluationId);\n        }\n    });\n\n    self.activateSurvey = async function (surveyId) {\n        if (qualityAuthorization.canViewSurvey()) {\n            if (!self.sidepanel.containsView(surveyId)) {\n                const survey = await qualityManagementService.getSurvey(\n                    surveyId\n                );\n                self.sidepanel.addView(surveyId, {\n                    view: EmbeddedQualityFormEditor,\n                    arguments: [\n                        FormType.survey,\n                        surveyId,\n                        conversationId,\n                        undefined,\n                        undefined,\n                        self.closePanel,\n                    ],\n                    template:\n                        \"templates/composer/forms/embeddedQualityFormEditor\",\n                    persist: true,\n                    showHeader: false,\n                    viewTitle: survey.surveyForm.name,\n                    onClose: () => {\n                        navHelper.navigateTo(\n                            navHelper.asHostHash(\n                                removeQueryParamFromWindow(\"surveyId\")\n                            ),\n                            undefined,\n                            false\n                        );\n                    },\n                });\n            }\n            self.sidepanel.setActiveView(surveyId);\n        }\n    };\n\n    self.subscribe(self.surveyId, (surveyId) => {\n        if (surveyId) {\n            self.activateSurvey(surveyId);\n        }\n    });\n\n    self.activateCreateEvaluationView = function () {\n        stopTabDefaultBehavior();\n        if (qualityAuthorization.canAddEvaluation()) {\n  