   private subViews: ViewModel[] = [];\n\n    // lifecycle\n    onDispose?(...args: any[]): void;\n\n    /**\n     * Creates a new computed value that will be disposed\n     * of when the dispose method is called on the view model.\n     * Otherwise, this works like the standard ko.computed\n     */\n    computed = ((...args: Parameters<typeof ko.computed>) => {\n        const computed = ko.computed(...args);\n        this.computedValues.push(computed);\n        return computed;\n    }) as typeof ko.computed;\n\n    pureComputed = ((...args: Parameters<typeof ko.pureComputed>) => {\n        const pureComputed = ko.pureComputed(...args);\n        this.computedValues.push(pureComputed);\n        return pureComputed;\n    }) as typeof ko.pureComputed;\n\n    asyncComputed(callback: () => any, errorCallback: () => any, owner: any) {\n        const asyncComputed = ko.asyncComputed(callback, errorCallback, owner);\n        this.computedValues.push(asyncComputed);\n        return asyncComputed;\n    }\n\n    subscribe<T>(\n        observable: ko.Subscribable<T> | ko.Computed<T>,\n        callback: (val: T) => void\n    ): ko.Subscription {\n        const subscription = observable.subscribe(callback);\n        this.subscriptions.push(subscription);\n        return subscription;\n    }\n\n    multiSubscribe(\n        targets: ko.Subscribable<any>[],\n        callback: (...args: any[]) => void\n    ): ko.Subscription {\n        const subscription = ko.multiSubscribe(\n            targets as ko.Observable<any>[],\n            callback\n        );\n        this.subscriptions.push(subscription);\n        return subscription;\n    }\n\n    /**\n     * Creates and returns a new view from the provided constructor.\n     * Subsequent arguments are passed to the constructor when the\n     * subView is created. The subView is also registered for cleanup\n     * when dispose is called.\n     */\n    subView(SubViewConstructor: any, ...rest: any[]) {\n        /*\n         * Instantiates