   self.dateStart = ko.observable();\n    self.dateEnd = ko.observable();\n    self.pcapFileUrl = ko.observable();\n\n    // We don't want to always use a new fallback end time whenever conversationObservable is updated.\n    // Instead the fallback end time will be updated whenever the conversation Id changes.\n    self.fallbackEndTime = new Date();\n\n    self.computed(() => {\n        const { id, startTime, endTime } =\n            ko.toJS(conversationObservable) || {};\n        if (self.conversationId() !== id && !endTime) {\n            self.fallbackEndTime = new Date();\n        }\n        self.conversationId(id);\n        self.dateStart(moment(startTime).add(-1, \"day\").toISOString());\n        self.dateEnd(\n            (endTime ? moment(endTime) : moment(self.fallbackEndTime))\n                .add(1, \"day\")\n                .toISOString()\n        );\n    });\n\n    const getDownloadWithRetry = function (downloadId) {\n        return withRequestRetry(\n            function () {\n                return apiCore.v2.get(\n                    \"/telephony/siptraces/download/\" + downloadId,\n                    {\n                        file: \"sipDiagnostics.pcap\",\n                    }\n                );\n            },\n            function (downloadResult) {\n                // retry 202s -- successful requests with empty response\n                loggingService.info(\n                    \"getDownloadWithRetry -  Retrying: \" + !downloadResult\n                );\n                return !downloadResult;\n            },\n            function (error) {\n                loggingService.info(\"getDownloadWithRetry - Error: \", error);\n                return false;\n            },\n            { maxRetries: 5 }\n        )(downloadId);\n    };\n\n    const getSiptraces = function () {\n        const siptracesParams = {\n            conversationId: self.conversationId(),\n            dateStart: self.dateStart(),\n            dateEnd: self.dateEnd(),\n        };\n        return apiCore.v2\n            .get(\"/telephony/siptraces\", siptracesParams)\n            .then(function (siptracesResult) {\n                if (siptracesResult.count > 0) {\n                    self.siptraces(siptracesResult);\n                    if (self.canAddPcap) {\n                        return apiCore.v2\n                            .post(\n                                \"/telephony/siptraces/download\",\n                                siptracesParams\n                            )\n                            .then(function (pcapResults) {\n                                return getDownloadWithRetry(\n                                    pcapResults.downloadId\n                                );\n                            })\n                            .then(function (downloadResults) {\n                                self.pcapFileUrl(downloadResults.url);\n                            });\n                    }\n                }\n            })\n            .catch(function (errorResult) {\n                loggingService.error(\n                    \"Unexpected error when fetching sip diagnostics.\",\n                    { errorResult }\n                );\n            });\n    };\n\n    const makeFileUrl = function (content, contentType) {\n        const fileJSON = JSON.stringify(content, undefined, 4);\n        const fileBlob = new Blob([fileJSON], { type: contentType });\n        return URL.createObjectURL(fileBlob);\n    };\n\n    self.computed(function () {\n        if (hasCalls() && self.dateStart()) {\n            if (self.canViewPcap) {\n                getSiptraces();\n            }\n        }\n    });\n\n    self.siptracesFileUrl = self.computed(function () {\n        if (self.siptraces()) {\n            return makeFileUrl(self.siptraces(), \"application/json\");\n        }\n    });\n});\n\nexport default SiptracesView;\n","export default {\n    HANDLE_EMAIL_EVALUATION_TOPIC: \"handleEmailEvaluation\",\n    ACTIVATED_EVALUATION: \"activatedEvaluation\",\n    USER_IMAGES_AVAILABLE: \"userImagesAvailable\",\n};\n","import ViewModel from \"viewModels/ViewModel\";\nimport navHelper from \"services/navHelper\";\n\nconst CategoryTagView = ViewModel.extend(function CategoryTagView(\n    category,\n    isCategoryChanged,\n    hasCategoryPermission\n) {\n    const self = this;\n\n    self.id = category.id;\n    self.name = category.name;\n    self.description = category.description;\n    self.isCategoryChanged = isCategoryChanged;\n    self.hasCategoryPermission = hasCategoryPermission;\n\n    // link to category editor page\n    self.link = navHelper.asHostUrl(\n        `directory/#/quality/admin/sta-category-definitions/categoryItem/${self.id}?tab=criteria`\n    );\n});\n\nexport default CategoryTagView;\n","import ko from \"knockout\";\nimport CategoryTagView from \"viewModels/CategoryTagView\";\nimport ViewModel from \"viewModels/ViewModel\";\nimport loggingService from \"services/loggingService\";\nimport speechAndTextAnalyticsService from \"services/speechAndTextAnalyticsService\";\nimport authService from \"services/authService\";\n\nconst CategoriesView = ViewModel.extend(function CategoriesView(\n    conversationId\n) {\n    const DEFAULT_PAGE_SIZE = 25;\n    const STA_DATA_VIEW_PERMISSION = \"perm:speechAndTextAnalytics:data:view\";\n    const STA_CATEGORY_VIEW_PERMISSION =\n        \"perm:speechAndTextAnalytics:category:view\";\n\n    const self = this;\n\n    self.hasDataPermission = ko.observable(\n        authService.hasAuthorization(STA_DATA_VIEW_PERMISSION)\n    );\n    self.useCategorizerResults = ko.observable(\n        !authService.hasAuthorization(STA_CATEGORY_VIEW_PERMISSION)\n    );\n\n    self.categoryTagViews = ko.observableArray([]);\n    self.orgCategories = ko.observableArray([]);\n    self.currentBatchFailed = ko.observable(false);\n    self.categorizerResponse = ko.observable();\n    self.pageNumber = ko.observable(1);\n    self.isLastPage = ko.observable(false);\n    self.noResults = ko.observable(false);\n    self.categoriesLoaded = ko.observable(false);\n\n    // compare category name, description, interactionType, criteria\n    const isCategoryChanged = function (category, entity) {\n        // interactionType and criteria fields are currently considered optional from categorizer response\n        return (\n            category.name !== entity.name ||\n            category.description !== entity.description ||\n            (entity.interactionType &&\n                category.interactionType !== entity.interactionType) ||\n            (entity.criteria &&\n                JSON.stringify(category.criteria) !==\n                    JSON.stringify(entity.criteria))\n        );\n    };\n\n    // create a tag for each category\n    self.addCategoryTagViews = function () {\n        // isLastPage=true disables the \"See more\" button\n        self.isLastPage(\n            self.categorizerResponse().pageCount <= self.pageNumber()\n        );\n        const newViews = [];\n        // find category in orgCategories by ID, then create a new subView if necessary\n        self.categorizerResponse().entities.forEach((entity) => {\n            // if no category view permission OR if a call to category definitions fails, use data from categorizer\n            const category =\n                self.useCategorizerResults() || self.currentBatchFailed()\n                    ? entity\n                    : self.orgCategories().find((c) => c.id === entity.id);\n            if (category && category.name) {\n                let displayLink = true;\n                if (self.useCategorizerResults() || self.currentBatchFailed()) {\n                    displayLink = false;\n                }\n                const categoryTagView = self.subView(\n                    CategoryTagView,\n                    category,\n                    isCategoryChanged(category, entity),\n                    displayLink\n                );\n                newViews.push(categoryTagView);\n            }\n        });\n        // if no new views created, check if any results at all\n        if (newViews.length === 0) {\n            if (self.isLastPage()) {\n                self.noResults(self.categoryTagViews().length === 0);\n            } else {\n                self.pageNumber(self.pageNumber() + 1);\n            }\n        } else {\n            self.categoryTagViews.push(...newViews);\n            self.categoryTagViews.sort((a, b) =>\n                a.name.toLowerCase() > b.name.toLowerCase() ? 1 : -1\n            );\n        }\n    };\n\n    self.loadMore = function () {\n        self.pageNumber(self.pageNumber() + 1);\n        self.categoriesLoaded(false);\n    };\n\n    // Get detected categories and their matching current categories\n    self.getCategoriesResponses = function () {\n        speechAndTextAnalyticsService\n            .getConversationCategories(\n                conversationId(),\n                self.pageNumber(),\n                DEFAULT_PAGE_SIZE\n            )\n            .then(async (categorizerResponse) => {\n                self.categorizerResponse(categorizerResponse);\n                self.noResults(\n                    self.categorizerResponse().entities.length === 0 &&\n                        self.pageNumber() === 1\n                );\n                if (!self.noResults()) {\n                    // No detected categories\n                    if (!self.useCategorizerResults()) {\n                        await self.batchGetOrgCategories();\n                    }\n                    self.addCategoryTagViews();\n                }\n            })\n            .catch((err) => {\n                loggingService.error(\n                    \"Unexpected error when fetching Categorizer response.\",\n                    err\n                );\n                if (self.pageNumber() === 1) {\n                    self.noResults(true);\n                } else {\n                    self.isLastPage(true);\n                }\n            })\n            .finally(() => {\n                self.categoriesLoaded(true);\n            });\n    };\n\n    self.computed(function () {\n        if (self.hasDataPermission()) {\n            self.getCategoriesResponses();\n        }\n    });\n\n    // Get current categories from Category Definitions service with detected category ids from Categorizer service\n    self.batchGetOrgCategories = async function () {\n        self.currentBatchFailed(false);\n        try {\n            const categorizerObjects = self.categorizerResponse().entities;\n            const requestedIds = categorizerObjects.map(\n                (category) => category.id\n            );\n            const requestedIdsParam = requestedIds.join(\",\");\n\n            const response =\n                await speechAndTextAnalyticsService.batchGetCategories(\n                    requestedIdsParam\n                );\n            self.orgCategories().push(...response.entities);\n        } catch (err) {\n            loggingService.error(\n                \"Unexpected error when fetching Category Definitions batch GET response.\",\n                err\n            );\n            self.currentBatchFailed(true);\n        }\n    };\n});\n\nexport default CategoriesView;\n","import ko from \"knockout\";\nimport Wrapup from \"models/Wrapup\";\nimport liveDataService from \"services/liveDataService\";\nimport ObservableModel from \"util/ObservableModel\";\nimport Contact from \"models/outbound/Contact\";\nimport Participant from \"models/Participant\";\nimport communicationMixin from \"models/comunicationMixin\";\n\n/**\n * @constructor\n * @this Message\n * Observable representation of a message. In addition to the\n * public API fields, exposes an observable field 'active'\n * that indicates whether or not the messages is live. The message object that is returned\n * from the server is expected to have the following data:\n *\n * <pre><code>\n * {\n *     id: \"1234a\",\n *     selfuri: \"http://inin.com/blah\",\n *     participants: [\n *       {\n *           \"id\": 1233,\n *           \"startTime\": \"2023-02-03T09:48:14.014Z\",\n *           \"connectedTime\": \"2023-02-03T09:48:14.029Z\",\n *           \"purpose\": \"customer\",\n *           \"direction\": \"inbound\",\n *           \"held\": false,\n *            messages: [{\n *              state: \"CONNECTING|ALERTING|CONNECTED|DISCONNECTED\"\n *            }],\n *            userId: \"passwordIsTaco\",\n *            selfUri: \"http://inin.com/foo\"\n *       }\n *  ]\n * }\n * </code></pre>\n *\n * Participants on a message can have the following purpose values:\n *   workflow\n *   customer:\n *   agent:\n *   acd: The agent routing/matching engine for inbound/outbound messages\n *   ivr: The IVR/menu engine for inbound message\n *\n * @return {Message} a message\n */\nconst Message = ObservableModel.extend(\n    {\n        defaults: {\n            maxParticipants: null,\n            participants: [],\n            wrapup: null,\n        },\n        modelProperties: {\n            wrapup: Wrapup,\n            contact: Contact,\n            participants: Participant,\n        },\n    },\n    function () {\n        const self = this;\n\n        self.interactionType = ko.observable(\"message\");\n\n        communicationMixin(self); //Adds functionality shared between different communication types.\n\n        self.errorInfo = ko.computed(function () {\n            if (\n                self.participantForCurrentUser() &&\n                self.participantForCurrentUser().errorInformation()\n            ) {\n                return self.participantForCurrentUser().errorInformation();\n            }\n            return null;\n        });\n\n        /**\n         * Returns whether or not this message is a monitored message\n         *\n         * @return {Boolean} true if the message is monitored, otherwise false\n         */\n        self.isMonitor = ko.computed(function () {\n            if (!self.participantForCurrentUser()) {\n                return false;\n            }\n            return (\n                self.participantForCurrentUser().monitoredParticipantId() !==\n                null\n            );\n        });\n\n        /**\n         * A helper method to determine if this is a user message\n         *\n         * @return {Boolean} true if it is a user message, otherwise false.\n         */\n        self.isUserMessage = ko.computed(function () {\n            if (self.participantForCurrentUser()) {\n                return self.participantForCurrentUser().isUser();\n            }\n            return false;\n        });\n\n        /**\n         * A helper method to determine if this is an agent message\n         *\n         * @return {Boolean} true if it is a agent message, otherwise false.\n         */\n        self.isAgentMessage = ko.computed(function () {\n            if (self.participantForCurrentUser()) {\n                return self.participantForCurrentUser().isAgent();\n            }\n            return false;\n        });\n\n        /**\n         * A helper method to determine if the user's message is in an active status (i.e. a\n         * a status where the user has not disconnected from the message).\n         *\n         * @return {Boolean} true if the message is in a connected status, false otherwise.\n         */\n        self.isActive = ko.computed(function () {\n            if (!self.participantForCurrentUser()) {\n                return false;\n            }\n\n            // message is active if status is in a connected state or the message is in\n            // ACW and doesn't already have any wrapup saved for the current user\n            return (\n                !self.isDisconnected() ||\n                (self.participantForCurrentUser().wrapupRequired() &&\n                    !self.participantForCurrentUser().wrapup())\n            );\n        });\n    }\n);\n\nliveDataService.registerTopic(\"messages\", Message);\n\nexport default Message;\n","import participantStatus from \"enums/participantStatus\";\nimport Promise from \"bluebird\";\nimport ko from \"knockout\";\nimport _ from \"lodash\";\nimport Message from \"models/Message\";\nimport apiCore from \"services/apiCore\";\nimport communicationService from \"services/communicationService\";\nimport LOG from \"services/loggingService\";\nimport toasts from \"services/toastService\";\nimport PubSub from \"util/PubSub\";\nimport { withRequestRetry } from \"util/withRequestRetry\";\nimport errorCallbackFactory from \"util/errorCallbackFactory\";\nimport { rejectOrResolveParticipantForCurrentUser } from \"util/rejectOrResolveParticipantForCurrentUser\";\n\nconst MAKE_MESSAGE_NOTIFICATION_TOPIC =\n    \"messageService.notifications.makeMessage\";\n\nconst activeMessages = ko.observableArray([]);\n\nconst MESSAGE_TYPES = {\n    MONITOR: \"monitor\",\n};\n\nconst MAX_RETRIES = 10;\n\n/**\n * Message service. Handles Message retrieval, updates & subscriptions.\n * @exports services/messageService\n */\nconst messageService = {\n    uriBuilder: communicationService.createUriBuilder(\n        \"/conversations/messages\"\n    ),\n\n    // ===============================================================================\n    // Properties\n    // ===============================================================================\n\n    /**\n     * Observable array of all active Message conversation\n     */\n    activeMessages: activeMessages,\n    /**\n     * Observable array of all active user Messages. This is a subset of activeMessages.\n     */\n    activeUserMessages: ko.computed(function () {\n        return _.filter(activeMessages(), function (message) {\n            return message.isUserMessage();\n        });\n    }),\n\n    /**\n     * Observable array of all active agent Messages. This is a subset of activeMessages.\n     */\n    activeAgentMessages: ko.computed(function () {\n        return _.filter(activeMessages(), function (message) {\n            return message.isAgentMessage();\n        });\n    }),\n\n    // ===============================================================================\n    // Methods\n    // ===============================================================================\n\n    getMessage: function (messageId, options) {\n        const opts = _.assign(\n            {\n                shouldReturnRawData: false,\n            },\n            options\n        );\n\n        return communicationService\n            .getCommunication(this.uriBuilder, messageId)\n            .then(function (messageData) {\n                if (opts.shouldReturnRawData) {\n                    return messageData;\n                }\n\n                return new Message(messageData);\n            });\n    },\n\n    /**\n     * Get the messages for a current user\n     * @return {Promise}\n     */\n    getActiveMessages: function () {\n        return apiCore.v2.get(\n            messageService.uriBuilder.communicationsByType(\"message\")\n        );\n    },\n\n    /**\n     * Monitor a participant on a messaging\n     * @param {string} id the id of the messages to monitor.\n     * @param {string} participantId the id of the participant to monitor.\n     * @param {Boolean} notifySubscribers indicates if subscribes to new answered messages should be notified\n     *                  of the newly monitored messages.\n     *\n     * @return {promise} a promise that resolves with the {@link Message} object\n     */\n\n    monitorMessage: function (id, participantId, notifySubscribers) {\n        const self = this;\n\n        // This is a chat conversation  that the current user is currently not a participant of.  So, we have to request\n        // to be added as a monitor and then wait for the new chat conversation to show up in the active chat list, and then\n        // verify that the current user's monitor attribute is set to true.\n        return apiCore.v2\n            .post(\n                messageService.uriBuilder.monitor(id, participantId),\n                null,\n                null\n            )\n            .then(function () {\n                return waitForNewMessagesToBeCreated(id, MESSAGE_TYPES.MONITOR);\n            })\n            .then(function (message) {\n                return rejectOrResolveParticipantForCurrentUser(message).then(\n                    function (participant) {\n                        return communicationService.validateActionSucceeded(\n                            message.id,\n                            participant.id,\n                            Message,\n                            \"status\",\n                            participantStatus.CONNECTED,\n                            self.activeMessages,\n                            self.uriBuilder\n                        );\n                    }\n                );\n            })\n            .then(function (message) {\n                if (notifySubscribers) {\n                    PubSub.Topic(MAKE_MESSAGE_NOTIFICATION_TOPIC).publish(id);\n                }\n                return message;\n            })\n            .catch(function (err) {\n                if (err.participantMissing) {\n                    toasts.notifyMajorAlert(\n                        \"digital.monitorMessage.error.generic\"\n                    );\n                    return;\n                }\n                LOG.error(\"Error while monitoring message:\", err);\n                if (\n                    err.details &&\n                    err.details.response &&\n                    err.details.response.code\n                ) {\n                    toasts.notifyMajorAlert(\n                        \"digital.monitorMessage.error.\" +\n                            err.details.response.code\n                    );\n                } else {\n                    toasts.notifyMajorAlert(\n                        \"digital.monitorMessage.error.generic\"\n                    );\n                }\n            });\n    },\n    /**\n     * Create a new Message for the current user\n     * @param {Object} options the Message options object that can have the following properties:\n     *              Message - the phone number/address to Message\n     *              MessageUserId - the id of the user to Message\n     *              MessageQueueId - the id of the queue to Message\n     *              MessageFrom - the id of the queue to Message on behalf of\n     * @param {Boolean} notifySubscribers indicates if subscribes to new answered Messages should be notified\n     *                  of the newly monitored Message.\n     * @return {promise} a promise that resolves with the {@link Message} object\n     */\n    createMessage: function (options, notifySubscribers) {\n        return apiCore.v2\n            .post(messageService.uriBuilder.base(), null, options)\n            .then(function (messageData) {\n                return waitForNewMessagesToBeCreated(messageData.id).then(\n                    function (message) {\n                        if (notifySubscribers) {\n                            PubSub.Topic(\n                                MAKE_MESSAGE_NOTIFICATION_TOPIC\n                            ).publish(message.id);\n                        }\n                        return message;\n                    }\n                );\n            });\n    },\n\n    /**\n     * Creates a new Message from the current user to the\n     * provided destination address.\n     * @param {string} destAddress the telephony address to Message\n     * @param {Boolean} notifySubscribers indicates if subscribes to new answered Messages should be notified\n     *                  of the newly monitored Message.\n     * @return {promise} a promise that resolves with the {@link Message} object\n     */\n    makeMessage: function (destAddress, notifySubscribers) {\n        return messageService.createMessage(\n            { message: destAddress },\n            notifySubscribers\n        );\n    },\n\n    /**\n     * Ends an ongoing message conversation.\n     * @param {string} messageid the id of the messaging to end.\n     * @param {string} participant the id of the participent to disconnect from the messaging.\n     * @return {promise} a promise that resolves with the {@link Message} object\n     */\n    endMessage: function (id, participantId) {\n        return communicationService.disconnect(\n            this.uriBuilder,\n            id,\n            participantId,\n            this.activeMessages,\n            Message\n        );\n    },\n\n    saveAfterMessageWork: function (messageId, participantId, data) {\n        return apiCore.v2.patch(\n            this.uriBuilder.participant(messageId, participantId),\n            data\n        );\n    },\n};\n\ncommunicationService.subscribeToTopic(\n    \"conversations.messages\",\n    messageService.activeMessages,\n    messageService.getActiveMessages,\n    Message\n);\n\n/**\n * Handler for  new message that are added to a user's live\n * Message data.\n */\nconst onNewUserMessage = function (message) {\n    LOG.debug(\"Message state tracked in active message \", message.id);\n};\n\n/**\n * Pushes message data into active messages, replacing any missing data,\n * but never overwriting existing data from push events. This\n * behavior ensures eventual consistency, provided that the\n * messageData is fetched after activeMessages becomes live.\n *\n * @param {object} messageData raw message data to push to active messaging\n */\nconst fillToActiveMessages = function (messageData) {\n    const activeMessages = messageService.activeMessages;\n    let message = _.find(activeMessages(), { id: messageData.id });\n    if (message) {\n        LOG.debug(\"Filling data into active messages\", message);\n        Message.fill(message, messageData);\n    } else {\n        LOG.debug(\"Adding Messages to activeMessages\", messageData);\n        message = addToActiveMessages(messageData);\n    }\n    return message;\n};\n\n/**\n * Adds a new Message object to the list of active Message based on\n * the provided Message data, and sets up tracking so the Message\n * will be remove when the user disconnects.\n * @param {object} messageData raw message data to add to active Messages\n */\nconst addToActiveMessages = function (messageData) {\n    const message = new Message(messageData);\n    messageService.activeMessages.push(message);\n    onNewUserMessage(message);\n    return message;\n};\n\nconst waitForNewMessagesToBeCreated = function (messageId, waitingFor = \"\") {\n    let resolvePromise, rejectPromise;\n    const promise = new Promise((resolve, reject) => {\n        resolvePromise = resolve;\n        rejectPromise = reject;\n    });\n\n    const message = _.find(activeMessages(), { id: messageId });\n\n    if (message) {\n        if (\n            message.participantForCurrentUser() &&\n            message.participantForCurrentUser().monitoredParticipantId() !==\n                null\n        ) {\n            const getActiveMessagesWithMorphedParticipantId = () =>\n                messageService.getActiveMessages({\n                    shouldReturnRawData: true,\n                });\n            pollFunction(getActiveMessagesWithMorphedParticipantId);\n        } else {\n            resolvePromise(message);\n        }\n        return promise;\n    }\n    function pollFunction(callback) {\n        return withRequestRetry(\n            callback,\n            function (messageData) {\n                const entity = _.find(messageData.entities, function (entity) {\n                    return entity.id == messageId;\n                });\n                const { monitoredParticipantId } = _.find(\n                    entity.participants,\n                    function (participant) {\n                        return (\n                            participant.purpose === \"user\" &&\n                            message.participantForCurrentUser().userId() ==\n                                participant.user.id &&\n                            !participant.endTime\n                        );\n                    }\n                );\n\n                //We know which supervisor has requested to Monitor and using waitingFor\n                //we will retry until we get monitored participant id's\n\n                if (\n                    (waitingFor == MESSAGE_TYPES.MONITOR &&\n                        monitoredParticipantId) ||\n                    waitingFor == \"\"\n                ) {\n                    message\n                        .participantForCurrentUser()\n                        .monitoredParticipantId(monitoredParticipantId);\n                    resolvePromise(message);\n                    return;\n                }\n                return true;\n            },\n            function (error) {\n                rejectPromise(error);\n                errorCallbackFactory.createCallback({\n                    namespace: \"conversationDetails.message.error\",\n                })(error);\n            },\n            { maxRetries: MAX_RETRIES, startIntervalMs: 1000 }\n        )();\n    }\n\n    const pollingObj = {\n        timeout: null,\n        xhrRequest: null,\n    };\n\n    const subscription = messageService.activeMessages.subscribe(function () {\n        const message = _.find(activeMessages(), { id: messageId });\n\n        if (message) {\n            resolvePromise(message);\n\n            if (pollingObj.timeout) {\n                clearTimeout(pollingObj.timeout);\n            }\n\n            if (pollingObj.xhrRequest) {\n                pollingObj.xhrRequest.cancel();\n            }\n\n            subscription.dispose();\n        }\n    });\n\n    let tries = 0;\n    let messageIsDisconnected = false;\n\n    const getMessageTimeout = function () {\n        pollingObj.xhrRequest = messageService.getMessage(messageId, {\n            shouldReturnRawData: true,\n        });\n\n        pollingObj.xhrRequest\n            .then(function (messageData) {\n                if (_.has(messageData, \"participants\")) {\n                    if (subscription) {\n                        // get rid of the subscription on success becuase we\n                        // just got the latest data from the backend.\n                        subscription.dispose();\n                    }\n\n                    let message = new Message(messageData);\n                    // only add in the message if it is active.\n                    if (!message.isDisconnected()) {\n                        message = fillToActiveMessages(messageData);\n                    }\n                    messageIsDisconnected = message.isDisconnected();\n                    resolvePromise(message);\n                }\n            })\n            .catch(Promise.CancellationError, _.noop)\n            .finally(function () {\n                const message = _.find(activeMessages(), { id: messageId });\n\n                // if the message is found or is not active then don't try anymore\n                if (message || messageIsDisconnected) {\n                    if (subscription) {\n                        subscription.dispose();\n                    }\n                    pollingObj.xhrRequest = null;\n                } else {\n                    if (tries > 15) {\n                        // stop trying to get the messages's data after 15 seconds as there\n                        // was most likely an error in creating the message. This number\n                        // came from Anthony Roach.\n                        if (subscription) {\n                            subscription.dispose();\n                        }\n                        rejectPromise(\n                            new Error(\"Timeout waiting for message creation\")\n                        );\n                    } else {\n                        // The message has not been fully created yet, so try again\n                        pollingObj.timeout = setTimeout(\n                            getMessageTimeout,\n                            1000\n                        );\n                        tries++;\n                    }\n                }\n            });\n    };\n\n    // Poll for the new message after waiting for 15s\n    pollingObj.timeout = setTimeout(getMessageTimeout, 1000);\n\n    return promise;\n};\n\nko.computed(function () {\n    messageService.activeMessages(\n        _.filter(messageService.activeMessages(), function (message) {\n            if (_.has(message, \"isActive\")) {\n                return message.isActive();\n            }\n\n            return false;\n        })\n    );\n});\n\nexport default messageService;\n","import ko from \"knockout\";\nimport ObservableModel from \"util/ObservableModel\";\nimport communicationMixin from \"models/comunicationMixin\";\nimport Participant from \"models/Participant\";\nimport screenMonitoringUtils from \"util/screenMonitoringUtils\";\nimport liveDataService from \"services/liveDataService\";\nimport LOG from \"services/loggingService\";\nimport featureToggleService, {\n    FeatureToggle,\n} from \"services/featureToggleService\";\n\n/**\n * @constructor\n * @this ScreenMonitor\n * Observable representation of a screen monitoring conversation. Tracks screen monitoring\n * state for conversations. The screen monitor object that is returned from the server\n * is a conversation object with participants. Each participant may have a screenMonitorings\n * array with the following structure:\n *\n * <pre><code>\n * {\n *     id: \"conversation-id\",\n *     participants: [\n *         {\n *             id: \"participant-id\",\n *             screenMonitorings: [\n *                 {\n *                     id: \"screen-monitoring-id\",\n *                     state: \"connected|disconnected\",\n *                     targetUser: {\n *                         id: \"user-id-being-monitored\"\n *                     },\n *                     screenMonitoring: {\n *                         id: \"unique-screen-monitoring-session-id\"\n *                     },\n *                     monitoringType: \"AgentLevel|ConversationLevel\",\n *                     count: 1\n *                 }\n *             ]\n *         }\n *     ]\n * }\n * </code></pre>\n *\n * @return {ScreenMonitor} a screen monitor conversation\n */\nconst ScreenMonitor = ObservableModel.extend(\n    {\n        defaults: {\n            participants: [] as any[],\n        },\n        modelProperties: {\n            participants: Participant,\n        },\n    },\n    function (this: any) {\n        const self = this;\n\n        communicationMixin(self); // Adds functionality shared between different communication types.\n\n        /**\n         * A helper method to determine if this is a user screen monitor\n         *\n         * @return {Boolean} true if it is a user screen monitor, otherwise false.\n         */\n        self.isUserScreenMonitor = ko.computed(function () {\n            const participant = self.screenMonitorParticipantForCurrentUser();\n            return participant ? participant.isUserOrAgent() : false;\n        });\n\n        /**\n         * Returns whether or not this screen monitor is a monitoring session\n         *\n         * @return {Boolean} true if the screen monitor is monitoring, otherwise false\n         */\n        self.isScreenMonitor = ko.computed(function () {\n            const participant = self.screenMonitorParticipantForCurrentUser();\n            if (!participant) {\n                return false;\n            }\n            const screenMonitorings = participant.screenMonitorings;\n            const targetUserId =\n                screenMonitoringUtils.getConnectedTargetUserId(\n                    screenMonitorings\n                );\n            return targetUserId !== null;\n        });\n\n        /**\n         * A helper method to determine if the screen monitoring session is in an active status\n         *\n         * @return {Boolean} true if the screen monitoring is active, false otherwise.\n         */\n        self.isActive = ko.computed(function () {\n            const participant = self.screenMonitorParticipantForCurrentUser();\n            if (!participant) {\n                return false;\n            }\n\n            // Active if SM participant is not disconnected and has connected screenMonitorings\n            const screenMonitorings = participant.screenMonitorings;\n            const targetUserId =\n                screenMonitoringUtils.getConnectedTargetUserId(\n                    screenMonitorings\n                );\n            return !participant.isDisconnected() && targetUserId !== null;\n        });\n    }\n);\n\n// Conditionally register topic when feature toggle is enabled\n// Use observable pattern to react to feature toggle changes\nconst screenMonitoringToggle = featureToggleService.getFeatureToggle(\n    FeatureToggle.WEM_437_SCREEN_MONITORING\n);\n\n// Subscribe to feature toggle changes and register topic when enabled\nlet topicRegistered = false;\nscreenMonitoringToggle.subscribe(function (isEnabled: boolean) {\n    if (isEnabled && !topicRegistered) {\n        try {\n            liveDataService.registerTopic(\"screenMonitors\", ScreenMonitor);\n            topicRegistered = true;\n        } catch (error) {\n            LOG.error(\"Error subscribing to screen monitoring topic\", error);\n        }\n    }\n});\n\nexport default ScreenMonitor;\n","/* Example of query param for using localhost Volt with an idui branch and a webdir branch:\n * https://apps.inindca.com/directory/feature/STREAM-1640/?voltLocalHost=true#/analytics/interactions/f6472f13-3a69-4cc4-ae44-3ea8370cfc4b/admin?tabId=40dbb5fa-e2d9-4113-b235-622e7da8bb8c&iduiVersion=STREAM-1640\n */\n\nexport function getVoltMonitorWindowFeatures(): string {\n    const screen = window.screen;\n    const width = screen.availWidth || 1200;\n    const height = screen.availHeight || 900;\n\n    // These help place the popout on the current monitor. These properties are non-standard.\n    // https://developer.mozilla.org/en-US/docs/Web/API/Screen#non-standard_properties\n    const left = (screen as any).availLeft || 0;\n    const top = (screen as any).availTop || 0;\n\n    return `width=${width},height=${height},left=${left},top=${top},menubar=no,toolbar=no,location=no,status=no`;\n}\n\nexport function buildVoltMonitorUrl(): string {\n    return `${getVoltOrigin()}${getVoltAppPath()}/#/staging?monitoringClient=true`;\n}\n\nfunction getTopLocationValue(key: \"origin\" | \"pathname\" | \"search\"): string {\n    // this could throw due to CORS\n    try {\n        return window.top?.location[key] || \"\";\n    } catch {\n        return \"\";\n    }\n}\n\nfunction getQueryParams(): URLSearchParams {\n    return new URLSearchParams(\n        getTopLocationValue(\"search\") || window.location.search\n    );\n}\n\nfunction isVoltLocalhost(): boolean {\n    const queryParams = getQueryParams();\n    return (\n        queryParams.get(\"voltLocalHost\") === \"true\" ||\n        queryParams.get(\"voltLocalhost\") === \"true\"\n    );\n}\n\nfunction getLocalWebDirEnv(): string {\n    const env = getTopLocationValue(\"pathname\").split(\"/\")[1];\n    switch (env) {\n        case \"dev\":\n            return \"https://apps.inindca.com\";\n        case \"tca\":\n            return \"https://apps.inintca.com\";\n        case \"prod\":\n            return \"https://apps.mypurecloud.com\";\n        default:\n            return \"https://localhost:8443\";\n    }\n}\n\nfunction getVoltOrigin(): string {\n    if (isVoltLocalhost()) {\n        return \"https://localhost:8443\";\n    }\n\n    if (getTopLocationValue(\"origin\") === \"https://localhost:4300\") {\n        return getLocalWebDirEnv();\n    }\n\n    return getTopLocationValue(\"origin\") || window.location.origin;\n}\n\nfunction getVoltAppPath(): string {\n    if (isVoltLocalhost()) {\n        return \"\";\n    }\n\n    const voltBranch = getQueryParams().get(\"volt\");\n    if (voltBranch) {\n        return `/volt/${voltBranch}`;\n    }\n\n    return \"/volt\";\n}\n","import Promise from \"bluebird\";\nimport ko from \"knockout\";\nimport apiCore from \"services/apiCore\";\nimport communicationService from \"services/communicationService\";\nimport LOG from \"services/loggingService\";\nimport ScreenMonitor from \"models/ScreenMonitor\";\nimport { withRequestRetry } from \"util/withRequestRetry\";\nimport errorCallbackFactory from \"util/errorCallbackFactory\";\nimport screenMonitoringUtils from \"util/screenMonitoringUtils\";\nimport participantStatus from \"enums/participantStatus\";\nimport featureToggleService, {\n    FeatureToggle,\n} from \"services/featureToggleService\";\nimport {\n    buildVoltMonitorUrl,\n    getVoltMonitorWindowFeatures,\n} from \"util/volt-popout\";\n\ninterface GetScreenMonitorOptions {\n    shouldReturnRawData?: boolean;\n}\n\ninterface ApiCoreV2 {\n    get: (path: string, parameters?: any) => Promise<any>;\n    post: (path: string, data?: any, parameters?: any) => Promise<any>;\n    del: (path: string, parameters?: any) => Promise<any>;\n}\n\nconst apiCoreV2 = (apiCore as any).v2 as ApiCoreV2;\n\nconst MAX_RETRIES = 10;\n// Timeout for waiting for user to accept call in volt UI and participant to be added\n// Recommended: 30-45 seconds to account for:\n// - Time for volt UI to load (1-2 seconds)\n// - User to see and accept the call (5-20 seconds typical)\n// - Backend to process and add participant (1-2 seconds)\nconst INITIAL_POLL_DELAY_MS = 2000; // Wait 2 seconds before first poll to give volt UI time to open\nconst MAX_POLLING_ATTEMPTS = 15;\nconst BACKOFF_MULTIPLIER = 1.2;\nconst BASE_BACKOFF_DELAY_MS = 1000;\nconst MAX_BACKOFF_DELAY_MS = 3000;\n\n/**\n * Observable array of all active screen monitors.\n *\n * This is defined as a separate constant (rather than directly in the service object)\n * to avoid circular reference errors during initialization. When a computed property\n * inside the service object needs to reference `screenMonitoringService.activeScreenMonitors`,\n * the service object doesn't exist yet during its own initialization, causing a\n * \"Cannot access before initialization\" error.\n *\n * By creating the observable array first, we can:\n * 1. Reference it directly in computed functions without needing the service object\n * 2. Still assign it to the service object so it's accessible via `screenMonitoringService.activeScreenMonitors`\n * 3. Follow the same pattern used in other services (messageService, callService)\n *\n * @see {@link https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Errors/Cant_access_lexical_declaration_before_init|MDN: Temporal Dead Zone}\n */\nconst activeScreenMonitors = ko.observableArray<any>([]);\n\n/**\n * Screen monitoring service. Handles screen monitoring for all conversation types.\n * @exports services/screenMonitoringService\n */\nconst screenMonitoringService: any = {\n    uriBuilder: communicationService.createUriBuilder(\"/conversations\"),\n\n    /**\n     * Observable array of all active screen monitors\n     */\n    activeScreenMonitors: activeScreenMonitors,\n\n    /**\n     * Observable array of all active user screen monitors. This is a subset of activeScreenMonitors.\n     */\n    activeUserScreenMonitors: ko.computed(function (): any[] {\n        return activeScreenMonitors().filter(function (screenMonitor: any) {\n            return (\n                screenMonitor.isUserScreenMonitor &&\n                screenMonitor.isUserScreenMonitor()\n            );\n        });\n    }),\n\n    // ===============================================================================\n    // Methods\n    // ===============================================================================\n\n    getScreenMonitor: function (\n        conversationId: string,\n        options?: GetScreenMonitorOptions\n    ) {\n        const opts = Object.assign(\n            {\n                shouldReturnRawData: false,\n            },\n            options\n        );\n\n        return communicationService\n            .getCommunication(this.uriBuilder, conversationId)\n            .then(function (conversationData: any) {\n                if (opts.shouldReturnRawData) {\n                    return conversationData;\n                }\n\n                return new (ScreenMonitor as any)(conversationData);\n            });\n    },\n\n    /**\n     * Get the screen monitors for a current user\n     * @return {Promise}\n     */\n    getActiveScreenMonitors: function () {\n        return apiCoreV2.get(\n            screenMonitoringService.uriBuilder.communicationsByType(\n                \"screen_monitoring\"\n            )\n        );\n    },\n\n    /**\n     * Start screen monitoring for any conversation type\n     * @param {String} conversationId the id of the conversation to monitor\n     * @param {String} participantId the id of the participant to monitor\n     * @return {promise} a promise that resolves with the screen monitoring response\n     */\n    startScreenMonitoring: function (\n        conversationId: string,\n        participantId: string\n    ) {\n        const self = this;\n\n        return apiCoreV2\n            .post(\n                screenMonitoringService.uriBuilder.conversationLevelScreenMonitor(\n                    conversationId,\n                    participantId\n                )\n            )\n            .then(function () {\n                window.open(\n                    buildVoltMonitorUrl(),\n                    \"volt-monitor\",\n                    getVoltMonitorWindowFeatures()\n                );\n\n                return waitForNewScreenMonitorToBeCreated(conversationId);\n            })\n            .then(function (screenMonitor: any) {\n                const smParticipant =\n                    screenMonitor.screenMonitorParticipantForCurrentUser();\n                return communicationService.validateActionSucceeded(\n                    screenMonitor.id,\n                    smParticipant ? smParticipant.id : null,\n                    ScreenMonitor,\n                    \"status\",\n                    participantStatus.CONNECTED,\n                    self.activeScreenMonitors,\n                    self.uriBuilder\n                );\n            });\n    },\n\n    /**\n     * Stop screen monitoring for any conversation type\n     * @param {String} conversationId the id of the conversation being monitored\n     * @param {String} participantId the id of the participant being monitored\n     * @param {String} screenMonitoringId the id of the screen monitoring session\n     * @return {promise} a promise that resolves with the screen monitoring response\n     */\n    stopConversationLevelScreenMonitoring: function (\n        conversationId: string,\n        participantId: string,\n        screenMonitoringId: string\n    ) {\n        const self = this;\n\n        if (!conversationId) {\n            return Promise.reject(new Error(\"Conversation ID is required\"));\n        }\n\n        if (!participantId) {\n            return Promise.reject(new Error(\"Participant ID is required\"));\n        }\n\n        if (!screenMonitoringId) {\n            return Promise.reject(\n                new Error(\"Screen monitoring ID is required\")\n            );\n        }\n\n        return apiCoreV2\n            .del(\n                this.uriBuilder.stopConversationLevelScreenMonitor(\n                    conversationId,\n                    participantId,\n                    screenMonitoringId\n                )\n            )\n            .then(function () {\n                return communicationService.validateActionSucceeded(\n                    conversationId,\n                    participantId,\n                    ScreenMonitor,\n                    \"status\",\n                    participantStatus.DISCONNECTED,\n                    self.activeScreenMonitors,\n                    self.uriBuilder\n                );\n            });\n    },\n\n    /**\n     * Stop agent-level screen monitoring\n     * @param {String} userId the id of the user whose screen monitoring session to stop\n     * @param {String} screenMonitoringId the id of the screen monitoring session\n     * @return {promise} a promise that resolves with the screen monitoring response\n     */\n    stopAgentLevelScreenMonitoring: function (\n        userId: string,\n        screenMonitoringId: string\n    ) {\n        if (!screenMonitoringId) {\n            return Promise.reject(\n                new Error(\"Screen monitoring ID is required\")\n            );\n        }\n\n        if (!userId) {\n            return Promise.reject(new Error(\"User ID is required\"));\n        }\n\n        return apiCoreV2\n            .del(\n                this.uriBuilder.stopAgentLevelScreenMonitor(\n                    userId,\n                    screenMonitoringId\n                )\n            )\n            .then(function (response: any) {\n                LOG.info(\n                    \"Agent-level screen monitoring stopped for user: \" + userId\n                );\n                return response;\n            });\n    },\n};\n\n// Conditionally subscribe to topic when feature toggle is enabled\n// Use observable pattern to react to feature toggle changes\nconst screenMonitoringToggle = featureToggleService.getFeatureToggle(\n    FeatureToggle.WEM_437_SCREEN_MONITORING\n);\n\n// Subscribe to feature toggle changes and subscribe to topic when enabled\nlet topicSubscribed = false;\nscreenMonitoringToggle.subscribe(function (isEnabled: boolean) {\n    if (isEnabled && !topicSubscribed) {\n        try {\n            communicationService.subscribeToTopic(\n                \"conversations.screenMonitors\",\n                screenMonitoringService.activeScreenMonitors,\n                screenMonitoringService.getActiveScreenMonitors,\n                ScreenMonitor\n            );\n            topicSubscribed = true;\n            // Note: subscribeToTopic uses ko.computed internally, so it will handle\n            // activation when user is logged in and subscriptions are available\n        } catch (error) {\n            // Subscription might already exist, ignore error\n            LOG.error(\"Error subscribing to screen monitoring topic\", error);\n        }\n    }\n});\n\n/**\n * Pushes screen monitor data into active screen monitors, replacing any missing data,\n * but never overwriting existing data from push events. This\n * behavior ensures eventual consistency, provided that the\n * screenMonitorData is fetched after activeScreenMonitors becomes live.\n *\n * @param {object} screenMonitorData raw screen monitor data to push to active screen monitors\n */\nconst fillToActiveScreenMonitors = function (screenMonitorData: any) {\n    let screenMonitor = screenMonitoringService\n        .activeScreenMonitors()\n        .find((monitor: any) => monitor.id === screenMonitorData.id);\n    if (screenMonitor) {\n        LOG.debug(\n            \"Filling data into active screen monitors\",\n            screenMonitorData\n        );\n        (ScreenMonitor as any).fill(screenMonitor, screenMonitorData);\n    } else {\n        LOG.debug(\n            \"Adding screen monitor to activeScreenMonitors\",\n            screenMonitorData\n        );\n        screenMonitor = addToActiveScreenMonitors(screenMonitorData);\n    }\n    return screenMonitor;\n};\n\n/**\n * Adds a new screen monitor object to the list of active screen monitors based on\n * the provided screen monitor data, and sets up tracking so the screen monitor\n * will be removed when the user disconnects.\n * @param {object} screenMonitorData raw screen monitor data to add to active screen monitors\n */\nconst addToActiveScreenMonitors = function (screenMonitorData: any) {\n    const screenMonitor = new (ScreenMonitor as any)(screenMonitorData);\n    screenMonitoringService.activeScreenMonitors.push(screenMonitor);\n    return screenMonitor;\n};\n\n/**\n * Finds a screen monitor by conversation ID in the active screen monitors array\n * @param {string} conversationId - The conversation ID to search for\n * @returns {any} The screen monitor if found, undefined otherwise\n */\nconst findScreenMonitorById = function (conversationId: string): any {\n    return activeScreenMonitors().find(\n        (screenMonitor: any) => screenMonitor.id === conversationId\n    );\n};\n\n/**\n * Checks if a screen monitor meets the waiting condition (targetUser.id with connected state)\n * @param {any} screenMonitor - The screen monitor to check\n * @returns {boolean} True if condition is met, false otherwise\n */\nconst checkWaitingCondition = function (screenMonitor: any): boolean {\n    if (!screenMonitor) {\n        return false;\n    }\n\n    const participant = screenMonitor.screenMonitorParticipantForCurrentUser();\n    if (!participant) {\n        return false;\n    }\n\n    // Wait for targetUser.id with connected state\n    const screenMonitorings = participant.screenMonitorings;\n    const targetUserId =\n        screenMonitoringUtils.getConnectedTargetUserId(screenMonitorings);\n    return targetUserId !== null;\n};\n\n/**\n * Waits for a new screen monitor to be created and for the participant to be added\n * to the conversation after the user accepts the call in the volt UI.\n *\n * Flow: POST (201) → Volt UI opens → User accepts call → Backend adds participant → Poll until CONNECTED\n *\n * @param {string} conversationId - The ID of the conversation being monitored\n *\n * @returns {Promise<any>} Resolves with ScreenMonitor when participant has connected screenMonitoring state\n *   (targetUser.id with connected state). Rejects on timeout (after 15 polling attempts) or error.\n *\n * @description\n * ## Timing Details\n *\n * - **Initial Delay**: {@link INITIAL_POLL_DELAY_MS} (2s) - Gives volt UI time to open before first poll\n * - **Polling Intervals**: Exponential backoff `min(BASE_BACKOFF_DELAY_MS * BACKOFF_MULTIPLIER^tries, MAX_BACKOFF_DELAY_MS)` - starts at ~1s, increases to max 3s\n * - **Max Polling Attempts**: {@link MAX_POLLING_ATTEMPTS} attempts - After initial delay, polls up to MAX_POLLING_ATTEMPTS times with exponential backoff\n * - **withRequestRetry**: {@link MAX_RETRIES} (10 retries) at 1s intervals for active monitors polling when screenMonitor exists\n *\n * Polls every 1-3s until participant with targetUser.id (connected state) is found, or timeout after MAX_POLLING_ATTEMPTS attempts.\n */\nconst waitForNewScreenMonitorToBeCreated = function (conversationId: string) {\n    let resolvePromise!: (value: any) => void;\n    let rejectPromise!: (error: any) => void;\n    const promise = new Promise((resolve, reject) => {\n        resolvePromise = resolve;\n        rejectPromise = reject;\n    });\n\n    // Check if screenMonitor already exists\n    const screenMonitor = findScreenMonitorById(conversationId);\n\n    if (screenMonitor && checkWaitingCondition(screenMonitor)) {\n        // Already have what we need\n        resolvePromise(screenMonitor);\n        return promise;\n    }\n\n    // If screenMonitor exists but condition not met, poll for updates\n    if (screenMonitor) {\n        withRequestRetry(\n            () => screenMonitoringService.getActiveScreenMonitors(),\n            (conversationsData: any): boolean => {\n                const entity = conversationsData.entities?.find(\n                    (entity: any) => entity.id === conversationId\n                );\n                if (!entity?.participants?.length) {\n                    return true;\n                }\n\n                // Find current user's SM participant\n                const currentUserParticipant =\n                    screenMonitor.screenMonitorParticipantForCurrentUser();\n                if (!currentUserParticipant) {\n                    return true;\n                }\n\n                const foundParticipant = entity.participants.find(\n                    (participant: any) =>\n                        participant.purpose === \"user\" &&\n                        currentUserParticipant.userId() ===\n                            participant.userId &&\n                        !participant.endTime\n                );\n\n                if (!foundParticipant) {\n                    return true;\n                }\n\n                // Update screenMonitor with latest data from API response\n                const updatedScreenMonitor = fillToActiveScreenMonitors(entity);\n                if (\n                    updatedScreenMonitor &&\n                    checkWaitingCondition(updatedScreenMonitor)\n                ) {\n                    resolvePromise(updatedScreenMonitor);\n                    return false;\n                }\n\n                return true;\n            },\n            (error: any): boolean => {\n                rejectPromise(error);\n                errorCallbackFactory.createCallback({\n                    namespace: \"screenMonitorRequest.error\",\n                })(error);\n                return false;\n            },\n            { maxRetries: MAX_RETRIES, startIntervalMs: 1000 }\n        )();\n\n        return promise;\n    }\n\n    // ScreenMonitor doesn't exist yet - poll until it's created\n    const pollingObj = {\n        timeout: null as number | null,\n        xhrRequest: null as any,\n    };\n\n    const subscription = screenMonitoringService.activeScreenMonitors.subscribe(\n        function () {\n            const screenMonitor = findScreenMonitorById(conversationId);\n\n            if (screenMonitor && checkWaitingCondition(screenMonitor)) {\n                resolvePromise(screenMonitor);\n                cleanup();\n            }\n        }\n    );\n\n    const cleanup = function () {\n        if (pollingObj.timeout) {\n            clearTimeout(pollingObj.timeout);\n            pollingObj.timeout = null;\n        }\n        if (pollingObj.xhrRequest) {\n            pollingObj.xhrRequest.cancel();\n            pollingObj.xhrRequest = null;\n        }\n        if (subscription) {\n            subscription.dispose();\n        }\n    };\n\n    let tries = 0;\n\n    const pollForScreenMonitor = function () {\n        pollingObj.xhrRequest = screenMonitoringService.getScreenMonitor(\n            conversationId,\n            { shouldReturnRawData: true }\n        );\n\n        pollingObj.xhrRequest\n            .then(function (conversationData: any) {\n                if (\n                    !conversationData ||\n                    !(\"participants\" in conversationData)\n                ) {\n                    return;\n                }\n\n                let newScreenMonitor = new (ScreenMonitor as any)(\n                    conversationData\n                );\n                if (!newScreenMonitor.isDisconnected()) {\n                    newScreenMonitor =\n                        fillToActiveScreenMonitors(conversationData);\n                }\n\n                // Check if condition is met\n                if (checkWaitingCondition(newScreenMonitor)) {\n                    cleanup();\n                    resolvePromise(newScreenMonitor);\n                    return;\n                }\n\n                // If disconnected, stop polling\n                if (newScreenMonitor.isDisconnected()) {\n                    cleanup();\n                    resolvePromise(newScreenMonitor);\n                    return;\n                }\n            })\n            .catch(Promise.CancellationError, () => {})\n            .finally(function () {\n                const screenMonitor = findScreenMonitorById(conversationId);\n\n                // If found and condition met, we're done\n                if (screenMonitor && checkWaitingCondition(screenMonitor)) {\n                    cleanup();\n                    resolvePromise(screenMonitor);\n                    return;\n                }\n\n                // Check timeout - MAX_POLLING_ATTEMPTS polling attempts after initial delay\n                // With exponential backoff (1-3s per attempt), this provides sufficient time\n                // for user to accept call in volt UI and participant to be added\n                if (tries >= MAX_POLLING_ATTEMPTS) {\n                    cleanup();\n                    rejectPromise(\n                        new Error(\"Timeout waiting for screen monitor creation\")\n                    );\n                    return;\n                }\n\n                // Continue polling with exponential backoff\n                const delayMs = Math.min(\n                    BASE_BACKOFF_DELAY_MS * Math.pow(BACKOFF_MULTIPLIER, tries),\n                    MAX_BACKOFF_DELAY_MS\n                );\n                pollingObj.timeout = window.setTimeout(\n                    pollForScreenMonitor,\n                    delayMs\n                );\n                tries++;\n            });\n    };\n\n    // Start polling after initial delay\n    pollingObj.timeout = window.setTimeout(\n        pollForScreenMonitor,\n        INITIAL_POLL_DELAY_MS\n    );\n\n    return promise;\n};\nexport default screenMonitoringService;\n","export default {\n    positiveSentimentScore: {\n        iconClassName: \"icon-thumbs-up\",\n    },\n    negativeSentimentScore: {\n        iconClassName: \"icon-thumbs-down\",\n    },\n    neutralSentimentScore: {\n        iconClassName: \"fa fa-minus-circle\",\n        iconName: \"fa/subtract-circle-solid\",\n    },\n    positiveSentimentTrend: {\n        iconClassName: \"fa fa-angle-double-up\",\n    },\n    negativeSentimentTrend: {\n        iconClassName: \"fa fa-angle-double-down\",\n    },\n    neutralSentimentTrend: {\n        iconClassName: \"fa fa-minus\",\n    },\n    improvingSentimentTrend: {\n        iconClassName: \"deprecated/chevron-double-up\",\n    },\n    slightlyImprovingSentimentTrend: {\n        iconClassName: \"chevron-small-up\",\n    },\n    noChangeSentimentTrend: {\n        iconClassName: \"subtract\",\n    },\n    slightlyDecliningSentimentTrend: {\n        iconClassName: \"chevron-small-down\",\n    },\n    decliningSentimentTrend: {\n        iconClassName: \"deprecated/chevron-double-down\",\n    },\n};\n","import ko from \"knockout\";\nimport { map, max } from \"lodash\";\nimport ViewModel from \"viewModels/ViewModel\";\n\nconst PercentGraphView = ViewModel.extend(function (percentData) {\n    const self = this;\n\n    const estimatedWidthPerCharacter = 8; // px\n    const fourDigitPercentageWidth = 46; // px\n\n    self.getDurationPercentages = function () {\n        return map(percentData(), function (row) {\n            if (!row.label || row.label.length === 0) {\n                row.label = self.formatPercentage(row.percent());\n            }\n            if (!row.labelAriaLabel || row.labelAriaLabel.length === 0) {\n                row.labelAriaLabel = row.label;\n            }\n            return row;\n        });\n    };\n\n    self.formatPercentage = function (percent) {\n        return ko.i18n.formatNumber(percent / 100, {\n            style: \"percent\",\n            minimumFractionDigits: 2,\n            maximumFractionDigits: 2,\n        });\n    };\n\n    self.maxPercent = ko.computed(() =>\n        max([...map(percentData(), (a) => a.percent()), 0])\n    );\n\n    self.maxTextGroupWidth = ko.computed(function () {\n        // best effort to estimate how long the width is going to be\n        const maxCharLength = max(\n            map(percentData(), (a) =>\n                a.label\n                    ? a.label.length * estimatedWidthPerCharacter\n                    : fourDigitPercentageWidth\n            )\n        );\n        return maxCharLength + \"px\";\n    });\n});\n\nexport default PercentGraphView;\n","import ko from \"knockout\";\nimport Clipboard from \"clipboard\";\nimport { uniqueId } from \"lodash/fp\";\nimport ViewModel from \"viewModels/ViewModelTyped\";\nimport toastService from \"services/toastService\";\nimport errorCallbackFactory from \"util/errorCallbackFactory\";\nimport Icons from \"enums/Icons\";\n\nexport interface CopyButtonParams {\n    value: ko.Observable<string> | string;\n    lString?: ko.Observable<string> | string;\n    lAriaLabelKey?: ko.Observable<string> | string;\n}\n\nexport default class CopyButton extends ViewModel {\n    public readonly id: string;\n    public readonly screenReaderText?: string;\n    public readonly visible: ko.Computed<boolean>;\n    public readonly Icons = Icons;\n    private clipboard?: Clipboard;\n\n    constructor(\n        { value, lString, lAriaLabelKey }: CopyButtonParams,\n        componentElement: Element\n    ) {\n        super();\n        this.id = uniqueId(\"copy-button-\");\n\n        let ariaLabelKey = \"components.copy-button.button.label.v4\";\n\n        // if aria label key is specified and exists, use it, otherwise use default\n        if (lAriaLabelKey && ko.i18n.keyExists(ko.unwrap(lAriaLabelKey))) {\n            ariaLabelKey = ko.unwrap(lAriaLabelKey);\n        }\n\n        this.screenReaderText = ko.i18n.renderString(ariaLabelKey, {\n            text: ko.unwrap(value),\n        });\n\n        this.visible = this.computed(\n            () => Clipboard.isSupported() && !!ko.unwrap(value)\n        );\n\n        if (Clipboard.isSupported()) {\n            this.clipboard = new Clipboard(this.selector, {\n                text: () => ko.unwrap(value),\n                container: componentElement, // Use the component element as container\n            });\n\n            this.clipboard.on(\"success\", ({ text }) => {\n                // @ts-expect-error toastService is JS and notifyMessage has optional param useLongDelay\n                toastService.notifyMessage(\n                    ko.i18n.renderString(\n                        lString || \"components.copy-button.copySuccess\",\n                        {\n                            text,\n                        }\n                    ),\n                    { tag: this.selector, markdownToHtml: false }\n                );\n            });\n\n            this.clipboard.on(\n                \"error\",\n                errorCallbackFactory.createCallback({\n                    namespace: \"components.copy-button\",\n                })\n            );\n        }\n    }\n\n    get selector(): string {\n        return `#${this.id}`;\n    }\n\n    onDispose(): void {\n        if (this.clipboard) {\n            this.clipboard.destroy();\n        }\n    }\n}\n","import ko from \"knockout\";\n\nimport CopyButton, { CopyButtonParams } from \"./CopyButton\";\nimport template from \"./copy-button.html\";\nimport \"./copy-button.less\";\n\nko.components.register(\"copy-button\", {\n    viewModel: {\n        createViewModel: function (\n            params: CopyButtonParams,\n            componentInfo: any\n        ) {\n            return new CopyButton(params, componentInfo.element);\n        },\n    },\n    template: template,\n});\n","import MarkdownIt from \"markdown-it\";\nimport mila from \"markdown-it-link-attributes\";\n\nconst linkRenderer = new MarkdownIt(\"zero\", {\n    linkify: true,\n})\n    .use(mila, {\n        attrs: {\n            target: \"_blank\",\n        },\n    })\n    .enable(\"linkify\");\n\nexport default function renderLinks(input: string) {\n    return linkRenderer.renderInline(input);\n}\n","import ko from \"knockout\";\n\nimport CollapsableText from \"./CollapsableText\";\nimport template from \"./collapsable-text.html\";\nimport \"./collapsable-text.less\";\n\nko.components.register(\"collapsable-text\", {\n    viewModel: CollapsableText,\n    template: template,\n});\n","import ko from \"knockout\";\nimport ViewModel from \"viewModels/ViewModelTyped\";\nimport renderLinks from \"util/linkRenderer\";\nimport Icons from \"enums/Icons\";\ninterface CollapsableTextParams {\n    text: ko.MaybeObservable<string>;\n}\n\nexport default class CollapsableText extends ViewModel {\n    public value: ko.PureComputed<string>;\n    public readonly expanded: ko.Observable<boolean> = ko.observable(false);\n    public readonly overflowing: ko.Observable<boolean> = ko.observable(false);\n    public readonly Icons = Icons;\n    private node?: HTMLElement;\n\n    constructor({ text }: CollapsableTextParams) {\n        super();\n        this.value = this.pureComputed(() => renderLinks(ko.unwrap(text)));\n        this.subscribe(this.value, () => {\n            this.calculateOverflow();\n        });\n        this.onResize = this.onResize.bind(this);\n    }\n\n    koDescendantsComplete(node: HTMLElement) {\n        this.node = node;\n        this.calculateOverflow();\n    }\n\n    onResize() {\n        const expanded = this.expanded();\n        this.expanded(false);\n        this.calculateOverflow();\n        this.expanded(expanded);\n    }\n\n    calculateOverflow() {\n        if (this.node) {\n            const { scrollHeight, clientHeight } = this.node;\n            this.overflowing(scrollHeight > clientHeight);\n        }\n    }\n\n    toggleExpansion() {\n        this.expanded(!this.expanded());\n    }\n}\n","const isSegmentedId = function (recordingId) {\n    return (\n        /^[a-z0-9]{8}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{12}-.+/i.exec(\n            recordingId\n        ) !== null\n    );\n};\n\nconst getOriginalRecordingId = function (recordingId) {\n    if (!isSegmentedId(recordingId)) {\n        return recordingId;\n    }\n\n    return recordingId.substring(0, 36);\n};\n\nexport default {\n    isSegmentedId: isSegmentedId,\n    getOriginalRecordingId: getOriginalRecordingId,\n};\n","export default {\n    agentEmpathyScore: {\n        iconClassName: \"icon-face-empathy\",\n    },\n    unhelpfulBehaviorScore: {\n        iconClassName: \"icon-face-neutral\",\n    },\n    neutralEmpathyScore: {\n        iconClassName: \"fa fa-minus-circle\",\n        iconName: \"fa/subtract-circle-solid\",\n    },\n};\n","export enum ScreenMonitoringType {\n    AGENT_LEVEL = \"AgentLevel\",\n    CONVERSATION_LEVEL = \"ConversationLevel\",\n}\n\nexport default ScreenMonitoringType;\n","//TODO: REC-9815 - use uuid library instead of regex pattern\n/**\n * The below regex pattern is extracted from analytics-ui\n * https://bitbucket.org/inindca/analytics-ui/src/bc15b8dce98573f9ec60eb4e4a339bcda4019598/app/utils/guid.ts#lines-2\n */\nconst UUID_PATTERN =\n    /(^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$/i;\n\n/**\n * Validates if a string is a valid UUID.\n * @param {string} uuid - The string to validate\n * @returns {boolean} - True if the string is a valid UUID, false otherwise\n */\nfunction isValidUuid(uuid) {\n    if (!uuid) {\n        return false;\n    }\n    return UUID_PATTERN.test(uuid);\n}\n\nexport default {\n    isValidUuid: isValidUuid,\n};\n","import ko from \"knockout\";\nimport _ from \"lodash\";\nimport { flow, map, uniqBy } from \"lodash/fp\";\nimport Promise from \"bluebird\";\nimport moment from \"moment\";\nimport callService from \"services/callService\";\nimport wrapUpCodeService from \"services/wrapupCodeService\";\nimport LOG from \"services/loggingService\";\nimport userService from \"services/userService\";\nimport externalContactService from \"services/externalContactService\";\nimport analyticsService from \"services/analyticsService\";\nimport qualityAuth from \"services/qualityAuth\";\nimport qualityManagementService from \"services/qualityManagementService\";\nimport conversationsProtectionService from \"services/conversationsProtectionService\";\nimport navHelper from \"services/navHelper\";\nimport ViewModel from \"viewModels/ViewModel\";\nimport DateEditorView from \"viewModels/policies/editors/DateEditorView\";\nimport FileStateEnum from \"viewModels/util/FileStateEnum\";\nimport SparkVariables from \"enums/SparkVariables\";\nimport Icons from \"enums/Icons\";\nimport SiptracesView from \"viewModels/SiptracesView\";\nimport errorCallbackFactory from \"util/errorCallbackFactory\";\nimport qualityBroadcast from \"services/qualityBroadcast\";\nimport BroadCastEnum from \"viewModels/util/BroadCastEnum\";\nimport CategoriesView from \"viewModels/CategoriesView\";\nimport messageService from \"services/messageService\";\nimport screenMonitoringService from \"services/screenMonitoringService\";\nimport screenMonitoringUtils from \"util/screenMonitoringUtils\";\nimport featureToggleService, {\n    FeatureToggle,\n} from \"services/featureToggleService\";\nimport speechAndTextAnalyticsService from \"services/speechAndTextAnalyticsService\";\nimport OverallSentimentResources from \"enums/OverallSentimentResources\";\nimport PercentGraphView from \"viewModels/widgets/PercentGraphView\";\nimport \"components/copy-button\";\nimport \"components/collapsable-text\";\nimport segmentUtils from \"util/segmentUtils\";\nimport EmpathyResources from \"enums/EmpathyResources\";\nimport ScreenMonitoringType from \"enums/ScreenMonitoringType\";\nimport participantStatus from \"enums/participantStatus\";\nimport {\n    FULL_DATE_MEDIUM_TIME_OPTIONS,\n    SHORT_DATE_OPTIONS,\n} from \"util/DateTimeHelper\";\nimport uuidUtils from \"util/uuidUtils\";\nimport { setQueryParams } from \"util/uriUtil\";\n\nconst checkImages = function (avatarImages) {\n    // if any image size has a \"no_img\" value then return false so the default image will show\n    // the reason for returning false and not one with an image if it exists to to keep images consistent\n    // in the template we care about the x96 size, for brevity sake\n    return !_.includes(avatarImages(), \"no_img\");\n};\n\nfunction participantHasCalls(participant) {\n    return participant.calls && participant.calls.length > 0;\n}\n\nfunction participantHasMessages(participant) {\n    return participant.messages && participant.messages.length > 0;\n}\n\nfunction participantHasEmails(participant) {\n    return participant.emails && participant.emails.length > 0;\n}\n\nfunction participantHasInternalMessages(participant) {\n    return (\n        participant.internalMessages && participant.internalMessages.length > 0\n    );\n}\n\nfunction participantHasScreenMonitorings(participant) {\n    const screenMonitorings = ko.unwrap(participant.screenMonitorings);\n    return screenMonitorings && screenMonitorings.length > 0;\n}\n\nfunction participantHasConnectedCalls(participant) {\n    return (\n        participantHasCalls(participant) &&\n        _.some(participant.calls, { state: \"connected\" })\n    );\n}\n\nfunction participantHasConnectedMessages(participant) {\n    return (\n        participantHasMessages(participant) &&\n        _.some(participant.messages, { state: \"connected\" })\n    );\n}\n\nfunction participantHasParkedMessages(participant) {\n    return (\n        participantHasMessages(participant) &&\n        _.some(participant.messages, { state: \"parked\" })\n    );\n}\n\nfunction participantHasConnectedEmails(participant) {\n    return (\n        participantHasEmails(participant) &&\n        _.some(participant.emails, { state: \"connected\" })\n    );\n}\n\nfunction participantHasParkedEmails(participant) {\n    return (\n        participantHasEmails(participant) &&\n        _.some(participant.emails, { state: \"parked\" })\n    );\n}\n\nfunction participantHasCallbacks(participant) {\n    return participant.callbacks && participant.callbacks.length > 0;\n}\n\nfunction participantHasConnectedCallbacks(participant) {\n    return (\n        participantHasCallbacks(participant) &&\n        _.some(participant.callbacks, { state: \"connected\" })\n    );\n}\n\nfunction participantHasAuthenticatedCommunication(\n    participant,\n    analyticsParticipant\n) {\n    // check CS participant\n    if (participant) {\n        const communications = _.flatMap([\n            participant.calls,\n            participant.emails,\n            participant.chats,\n            participant.messages,\n        ]);\n        if (\n            communications.length > 0 &&\n            _.some(communications, { authenticated: true })\n        ) {\n            return true;\n        }\n    }\n\n    // check analytics participant\n    if (\n        analyticsParticipant &&\n        analyticsParticipant.sessions &&\n        analyticsParticipant.sessions.length > 0\n    ) {\n        if (_.some(analyticsParticipant.sessions, { authenticated: true })) {\n            return true;\n        }\n    }\n    return false;\n}\n\n//Gets initialized in constructor of ConversationDetailsView\nlet directionStrings = {};\n\nconst getLocalizedDirection = function (dir) {\n    if (_.isEmpty(dir)) {\n        return dir;\n    }\n\n    dir = dir.toLowerCase();\n\n    if (dir.indexOf(\"inbound\") > -1 && dir.indexOf(\"outbound\") > -1) {\n        return directionStrings.BOTH;\n    } else if (dir === \"inbound\") {\n        return directionStrings.INBOUND;\n    } else if (dir === \"outbound\") {\n        return directionStrings.OUTBOUND;\n    }\n};\n\nconst getWrapupName = function (wrapup) {\n    let wrapupName = wrapup.name;\n    if (!wrapupName && wrapup.code && _.startsWith(wrapup.code, \"ININ-\")) {\n        wrapupName = wrapup.code;\n    }\n    return wrapupName;\n};\n\nconst wrapUpCodeNamesById = {};\n\nconst MESSAGE_SUBTYPE_SMS = \"sms\";\n\n// Conversation type constants\nconst ConversationType = {\n    CALL: \"call\",\n    MESSAGE: \"message\",\n    EMAIL: \"email\",\n    CALLBACK: \"callback\",\n    SCREEN_MONITORING: \"screenMonitoring\",\n};\n\nconst ParticipantView = ViewModel.extend(function (\n    conversationId,\n    participant,\n    analyticsParticipantV6,\n    isCurrentUserOnCall,\n    hasMonitorCallPermission,\n    hasCoachCallPermission,\n    hasBargeInCallPermission,\n    hasMonitorMessagePermission,\n    hasAgentLevelScreenMonitorPermission,\n    hasConversationLevelScreenMonitorPermission,\n    options,\n    isAnyInternalParticipantMonitored,\n    isAnyInternalParticipantCoached,\n    isAnyInternalParticipantBargedIn,\n    isAnyInternalParticipantScreenMonitored,\n    isExternalParticipantMonitored,\n    isAlreadyCoached,\n    isAlreadyMonitored,\n    conversationMetrics,\n    conversationMetricsErr,\n    conversationType,\n    conversationDivisions,\n    isCurrentUserOnCallAsAgent\n) {\n    const self = this;\n    const endTime = ko.observable(participant.endTime);\n    const monitoredParticipantId = ko.observable(\n        participant.monitoredParticipantId\n    );\n    const coachedParticipantId = ko.observable(\n        participant.coachedParticipantId\n    );\n    const screenMonitoringTargetUserIds = ko.computed(function () {\n        // participant is a plain object, but screenMonitorings might be observable\n        const screenMonitorings = ko.unwrap(participant.screenMonitorings);\n        return screenMonitoringUtils.getAllUniqueTargetUserIds(\n            screenMonitorings\n        );\n    });\n    self.bargedParticipantId = ko.observable(participant.bargedParticipantId);\n    self.isSupervisorBarged = ko.observable(\n        participant.mediaRoles && participant.mediaRoles.includes(\"barge\")\n    );\n    const hasCalls = ko.observable(participantHasCalls(participant));\n    const hasMessages = ko.observable(participantHasMessages(participant));\n    const hasEmails = ko.observable(participantHasEmails(participant));\n    const hasScreenMonitorings = ko.observable(\n        participantHasScreenMonitorings(participant)\n    );\n    const hasConnectedCalls = ko.observable(\n        participantHasConnectedCalls(participant)\n    );\n    const hasConnectedMessages = ko.observable(\n        participantHasConnectedMessages(participant)\n    );\n    const hasConnectedEmails = ko.observable(\n        participantHasConnectedEmails(participant)\n    );\n    const hasCallbacks = ko.observable(participantHasCallbacks(participant));\n    const hasConnectedCallbacks = ko.observable(\n        participantHasConnectedCallbacks(participant)\n    );\n    const hasParkedMessages = ko.observable(\n        participantHasParkedMessages(participant)\n    );\n    const hasParkedEmails = ko.observable(\n        participantHasParkedEmails(participant)\n    );\n    self.isAlreadyCoached = ko.observable(isAlreadyCoached);\n\n    // Check if another user is already monitoring (only for message conversations)\n    self.isAlreadyMonitored = ko.observable(isAlreadyMonitored);\n\n    self.screenMonitorRequestInProgress = ko.observable(false);\n    self.conversationId = conversationId;\n    self.conversationDivisionIds = conversationDivisions;\n    self.monitorRequestInProgress = ko.observable(false);\n    self.coachRequestInProgress = ko.observable(false);\n    self.bargeInRequestInProgress = ko.observable(false);\n    self.name = participant.name;\n    self.dnis = ko.i18n.formatPhoneAddress(participant.dnis);\n    self.ani = ko.i18n.formatPhoneAddress(participant.ani);\n    self.conversationMetrics = ko.observable(conversationMetrics);\n    self.conversationMetricsErr = ko.observable(conversationMetricsErr);\n\n    self.isWEM1418orWEM437Enabled =\n        featureToggleService.isEnabled(\n            FeatureToggle.WEM_1418_IDUI_SPARK_V4_FLARE\n        ) ||\n        featureToggleService.isEnabled(FeatureToggle.WEM_437_SCREEN_MONITORING);\n\n    self.collapse = ko.observable(true);\n\n    self.updateCollapse = function () {\n        self.collapse(!self.collapse());\n    };\n\n    self.attributes =\n        participant.attributes !== undefined\n            ? ko.observable(\n                  Object.keys(participant.attributes).map((key) => ({\n                      name: key,\n                      value: participant.attributes[key],\n                  }))\n              )\n            : ko.observableArray([]);\n\n    const conversationParticipant = ko.observable(participant);\n    const analyticsParticipant = ko.observable(analyticsParticipantV6);\n\n    self.hasAuthenticatedCommunication = ko.observable(\n        participantHasAuthenticatedCommunication(\n            participant,\n            analyticsParticipantV6\n        )\n    );\n\n    self.isScreenMonitoringEnabled = featureToggleService.isEnabled(\n        FeatureToggle.WEM_437_SCREEN_MONITORING\n    );\n\n    // Expose Icons to templates for use in HTML bindings\n    self.Icons = Icons;\n\n    self.address = ko.i18n.formatPhoneAddress(participant.address);\n    self.user = ko.observable();\n    self.userImages = ko.observable();\n    self.participantId = participant.id;\n    self.deleteDate = ko.observable();\n    self.archiveDate = ko.observable();\n    self.userId = participant.userId;\n    self.disconnectType = ko.observable();\n\n    // True when this participant belongs to the current user and the user is\n    // active in the conversation. Used to prevent self-monitoring actions.\n    const isCurrentUserParticipant = self.computed(function () {\n        return (\n            isCurrentUserOnCall() &&\n            participant.userId === userService.currentUser()?.id\n        );\n    });\n    self.errorInfoCode = ko.observable();\n    self.externalContact = ko.observable();\n    self.externalContactId = participant.externalContactId;\n    self.id = participant.id;\n    self.isOpen = ko.observable(false);\n    self.isExpanded = ko.observable(true);\n\n    self.toggleExpandMonitorOrCoach = function () {\n        self.isExpanded(!self.isExpanded());\n    };\n\n    let direction;\n    let disconnectType;\n    let errorInfo;\n\n    if (\n        !_.isEmpty(participant.calls) &&\n        !_.isUndefined(participant.calls[0].direction)\n    ) {\n        direction = participant.calls[0].direction;\n        disconnectType = participant.calls[0].disconnectType;\n        errorInfo = participant.calls[0].errorInfo;\n    } else if (!_.isEmpty(participant.chats)) {\n        direction = participant.chats[0].direction;\n        disconnectType = participant.chats[0].disconnectType;\n        errorInfo = participant.chats[0].errorInfo;\n    } else if (\n        !_.isEmpty(participant.emails) &&\n        !_.isUndefined(participant.emails[0].direction)\n    ) {\n        direction = participant.emails[0].direction;\n        const lastEmail = participant.emails[participant.emails.length - 1];\n        disconnectType = lastEmail.disconnectType;\n        errorInfo = lastEmail.errorInfo;\n    } else if (!_.isEmpty(participant.messages)) {\n        const lastMessage =\n            participant.messages[participant.messages.length - 1];\n        disconnectType = lastMessage.disconnectType;\n        errorInfo = lastMessage.errorInfo;\n    }\n\n    self.direction = getLocalizedDirection(direction);\n\n    if (disconnectType) {\n        let disconnectTypeKey;\n        const PREFIX = \"conversationTimeline.tooltip.disconnectType.\";\n        disconnectType = disconnectType.toLowerCase();\n\n        if (disconnectType.indexOf(\"transfer\") !== -1) {\n            disconnectTypeKey = PREFIX + \"transfer\";\n        } else if (ko.i18n.keyExists(PREFIX + disconnectType)) {\n            disconnectTypeKey = PREFIX + disconnectType;\n        } else {\n            disconnectTypeKey = PREFIX + \"other\";\n        }\n\n        disconnectType = ko.i18n.renderString(disconnectTypeKey);\n        self.disconnectType(disconnectType);\n    }\n\n    if (errorInfo && errorInfo.code) {\n        errorInfo = errorInfo.code;\n        let errorInfoKey;\n        const PREFIX = \"conversationDetails.errorInfo.code.\";\n\n        if (ko.i18n.keyExists(PREFIX + errorInfo)) {\n            errorInfoKey = PREFIX + errorInfo;\n            errorInfo = ko.i18n.renderString(errorInfoKey);\n            self.errorInfoCode(errorInfo);\n        }\n    }\n\n    if (options.expandUser && participant.userId) {\n        userService\n            .getUser({ userId: participant.userId, state: \"deleted\" })\n            .then(function (user) {\n                self.user(user);\n                if (\n                    user.avatarImages &&\n                    user.avatarImages() &&\n                    checkImages(user.avatarImages)\n                ) {\n                    self.userImages(user.avatarImages());\n                    const imagesMap = {};\n                    imagesMap[participant.userId] = user.avatarImages();\n                    qualityBroadcast.publish(\n                        conversationId,\n                        BroadCastEnum.USER_IMAGES_AVAILABLE,\n                        imagesMap\n                    );\n                }\n            });\n    }\n\n    if (\n        participant.externalContactId &&\n        externalContactService.canViewExternalContact(\n            ko.unwrap(self.conversationDivisionIds)\n        )\n    ) {\n        externalContactService\n            .getCachedExternalContact(participant.externalContactId)\n            .then(self.externalContact)\n            .catch(function (err) {\n                errorCallbackFactory.createCallback({\n                    namespace: \"playback.externalParticipant\",\n                    logError: false, // log in the supplied callback function instead\n                    strategies: {\n                        404: function () {\n                            LOG.info(`External contact is not found.`);\n                        },\n                        403: function () {\n                            LOG.info(\n                                `Your account does not have permission to view the external contact.`\n                            );\n                        },\n                        DEFAULT: function () {\n                            LOG.error(\n                                `Error fetching external contact details for participant`,\n                                err\n                            );\n                        },\n                    },\n                })(err);\n            });\n    }\n\n    self.disconnectTypeDisplay = self.computed(function () {\n        if (self.disconnectType() && self.errorInfoCode()) {\n            return `${self.disconnectType()} - ${self.errorInfoCode()}`;\n        }\n        return self.disconnectType();\n    });\n\n    // check to see if there is an active user call that is monitoring this participant\n    const monitoredCall = self.computed(function () {\n        return _.find(callService.activeUserCalls(), function (call) {\n            return (\n                self.conversationId === call.id &&\n                call.isMonitor() &&\n                call.isConnected() &&\n                call.participantForCurrentUser().monitoredParticipantId() ===\n                    participant.id\n            );\n        });\n    });\n\n    // check to see if there is an active user call that is coaching this participant\n    const coachedCall = self.computed(function () {\n        return _.find(callService.activeUserCalls(), function (call) {\n            return (\n                self.conversationId === call.id &&\n                call.isCoach() &&\n                call.isConnected() &&\n                call.participantForCurrentUser().coachedParticipantId() ===\n                    participant.id\n            );\n        });\n    });\n\n    // check to see if there is an active user call that is bargedIn\n    const bargedInCall = self.computed(function () {\n        return _.find(callService.activeUserCalls(), function (call) {\n            return (\n                self.conversationId === call.id &&\n                call.isBargeIn() &&\n                call.isConnected() &&\n                call.participantForCurrentUser().bargedParticipantId() ===\n                    participant.id\n            );\n        });\n    });\n\n    const monitoredMessage = self.computed(function () {\n        return _.find(messageService.activeUserMessages(), function (message) {\n            return (\n                self.conversationId === message.id &&\n                message.isMonitor() &&\n                message.isConnected() &&\n                message.participantForCurrentUser().monitoredParticipantId() ===\n                    participant.id\n            );\n        });\n    });\n\n    const monitoredScreen = self.computed(function () {\n        if (!self.isScreenMonitoringEnabled) {\n            return null;\n        }\n        return _.find(\n            screenMonitoringService.activeUserScreenMonitors(),\n            function (screenMonitor) {\n                const screenMonitorParticipant =\n                    screenMonitor.screenMonitorParticipantForCurrentUser();\n                const screenMonitorings = screenMonitorParticipant\n                    ? screenMonitorParticipant.screenMonitorings\n                    : null;\n                const targetUserId =\n                    screenMonitoringUtils.getConnectedTargetUserId(\n                        screenMonitorings\n                    );\n                // Check SM participant is connected\n                const smParticipantConnected = screenMonitorParticipant\n                    ? screenMonitorParticipant.status() ===\n                      participantStatus.CONNECTED\n                    : false;\n                return (\n                    self.conversationId === screenMonitor.id &&\n                    screenMonitor.isScreenMonitor() &&\n                    smParticipantConnected &&\n                    targetUserId === participant.userId\n                );\n            }\n        );\n    });\n\n    const connectedScreenMonitoring = self.computed(function () {\n        if (!monitoredScreen()) {\n            return null;\n        }\n        const supervisorParticipant =\n            monitoredScreen().screenMonitorParticipantForCurrentUser();\n        return screenMonitoringUtils.getConnectedScreenMonitoring(\n            supervisorParticipant?.screenMonitorings\n        );\n    });\n\n    const screenMonitoringId = self.computed(() =>\n        connectedScreenMonitoring()?.screenMonitoring()?.id()\n    );\n    const screenMonitoringType = self.computed(() =>\n        connectedScreenMonitoring()?.monitoringType()\n    );\n\n    self.updateParticipant = function (\n        updatedParticipant,\n        updatedAnalyticsParticipant,\n        isAlreadyCoached,\n        isAlreadyMonitored\n    ) {\n        if (participant.id === updatedParticipant.id) {\n            conversationParticipant(updatedParticipant);\n            endTime(updatedParticipant.endTime);\n            monitoredParticipantId(updatedParticipant.monitoredParticipantId);\n            coachedParticipantId(updatedParticipant.coachedParticipantId);\n            self.bargedParticipantId(updatedParticipant.bargedParticipantId);\n            self.isSupervisorBarged(\n                updatedParticipant.mediaRoles &&\n                    updatedParticipant.mediaRoles.includes(\"barge\")\n            );\n            hasCalls(participantHasCalls(updatedParticipant));\n            hasMessages(participantHasMessages(updatedParticipant));\n            hasEmails(participantHasEmails(updatedParticipant));\n            hasScreenMonitorings(\n                participantHasScreenMonitorings(updatedParticipant)\n            );\n            hasConnectedCalls(participantHasConnectedCalls(updatedParticipant));\n            hasConnectedMessages(\n                participantHasConnectedMessages(updatedParticipant)\n            );\n            hasConnectedEmails(\n                participantHasConnectedEmails(updatedParticipant)\n            );\n            hasCallbacks(participantHasCallbacks(updatedParticipant));\n            hasConnectedCallbacks(\n                participantHasConnectedCallbacks(updatedParticipant)\n            );\n            hasParkedMessages(participantHasParkedMessages(updatedParticipant));\n            hasParkedEmails(participantHasParkedEmails(updatedParticipant));\n            self.hasAuthenticatedCommunication(\n                participantHasAuthenticatedCommunication(\n                    participant,\n                    updatedAnalyticsParticipant\n                )\n            );\n            self.isAlreadyCoached(isAlreadyCoached);\n            self.isAlreadyMonitored(isAlreadyMonitored);\n        } else {\n            LOG.error(\n                \"The updatedParticipant id does not match the current participant id.\",\n                {\n                    updatedParticipantId: updatedParticipant.id,\n                    currentParticipantId: participant.id,\n                }\n            );\n        }\n\n        if (\n            updatedAnalyticsParticipant &&\n            participant.id === updatedAnalyticsParticipant.participantId\n        ) {\n            analyticsParticipant(updatedAnalyticsParticipant);\n        }\n    };\n\n    self.isCallConversation = self.computed(function () {\n        return (\n            conversationType &&\n            conversationType().includes(ConversationType.CALL)\n        );\n    });\n\n    self.isMessageConversation = self.computed(function () {\n        return (\n            conversationType &&\n            conversationType().includes(ConversationType.MESSAGE)\n        );\n    });\n\n    self.isEmailConversation = self.computed(function () {\n        return (\n            conversationType &&\n            conversationType().includes(ConversationType.EMAIL)\n        );\n    });\n\n    self.isScreenMonitoringConversation = self.computed(function () {\n        return (\n            conversationType &&\n            conversationType().includes(ConversationType.SCREEN_MONITORING)\n        );\n    });\n\n    self.isCallbackConversation = self.computed(function () {\n        return (\n            conversationType &&\n            conversationType().includes(ConversationType.CALLBACK)\n        );\n    });\n\n    self.canMonitor = self.computed(function () {\n        return (\n            !isCurrentUserOnCall() &&\n            ((!endTime() && hasCalls()) || hasConnectedCalls())\n        );\n    });\n\n    self.isPermittedToMonitor = self.computed(function () {\n        return hasMonitorCallPermission() && hasCalls();\n    });\n\n    self.isMonitored = self.computed(function () {\n        return !!monitoredCall();\n    });\n\n    self.isMonitor = self.computed(function () {\n        return !!monitoredParticipantId() && hasCalls();\n    });\n\n    self.canCoach = self.computed(function () {\n        return (\n            !isCurrentUserOnCall() &&\n            ((!endTime() && hasCalls()) || hasConnectedCalls())\n        );\n    });\n\n    self.isPermittedToCoach = self.computed(function () {\n        return hasCoachCallPermission() && hasCalls();\n    });\n\n    self.isCoached = self.computed(function () {\n        return !!coachedCall();\n    });\n\n    self.isCoach = self.computed(function () {\n        return !!coachedParticipantId() && hasCalls();\n    });\n    self.isScreenMonitor = self.computed(function () {\n        return screenMonitoringTargetUserIds().length > 0;\n    });\n\n    self.isBargeIn = self.computed(function () {\n        return self.isSupervisorBarged() && hasCalls();\n    });\n\n    self.canBargeIn = self.computed(function () {\n        return (\n            !isCurrentUserOnCall() &&\n            ((!endTime() && hasCalls()) || hasConnectedCalls())\n        );\n    });\n\n    self.isPermittedToBargeIn = self.computed(function () {\n        return hasBargeInCallPermission() && hasCalls();\n    });\n\n    self.isBargedIn = self.computed(function () {\n        return !!bargedInCall();\n    });\n\n    self.canMonitorMessage = self.computed(function () {\n        if (self.isScreenMonitoringEnabled) {\n            return (\n                !isCurrentUserOnCall() &&\n                !hasParkedMessages() &&\n                ((!endTime() && hasMessages()) || hasConnectedMessages())\n            );\n        }\n        return (\n            !isCurrentUserOnCall() &&\n            ((!endTime() && hasMessages()) || hasConnectedMessages())\n        );\n    });\n\n    self.isPermittedToMonitorMessage = self.computed(function () {\n        return hasMonitorMessagePermission() && hasMessages();\n    });\n\n    self.canMonitorScreen = self.computed(function () {\n        return (\n            !isCurrentUserParticipant() &&\n            !hasParkedMessages() &&\n            !hasParkedEmails() &&\n            ((!endTime() &&\n                (hasCalls() ||\n                    hasMessages() ||\n                    hasEmails() ||\n                    hasCallbacks())) ||\n                hasConnectedCalls() ||\n                hasConnectedMessages() ||\n                hasConnectedEmails() ||\n                hasConnectedCallbacks())\n        );\n    });\n\n    self.isMonitoredScreen = self.computed(function () {\n        return !!monitoredScreen();\n    });\n\n    self.isPermittedToStartOrStopScreenMonitoring = self.computed(function () {\n        if (!self.isScreenMonitoringEnabled) {\n            return false;\n        }\n        if (!(hasCalls() || hasMessages() || hasEmails() || hasCallbacks())) {\n            return false;\n        }\n\n        // If screen monitoring is not active, use conversation level permission (for starting)\n        if (!self.isMonitoredScreen()) {\n            return hasConversationLevelScreenMonitorPermission();\n        }\n\n        // If screen monitoring is active, check permission based on monitoring type\n        if (screenMonitoringType() === ScreenMonitoringType.AGENT_LEVEL) {\n            return hasAgentLevelScreenMonitorPermission();\n        } else if (\n            screenMonitoringType() === ScreenMonitoringType.CONVERSATION_LEVEL\n        ) {\n            return hasConversationLevelScreenMonitorPermission();\n        } else {\n            return false;\n        }\n    });\n\n    self.isMonitoredMessage = self.computed(function () {\n        return !!monitoredMessage();\n    });\n\n    self.isMonitorMessage = self.computed(function () {\n        return !!monitoredParticipantId() && hasMessages();\n    });\n\n    self.isActive = self.computed(function () {\n        return !endTime();\n    });\n    self.isMachine = function () {\n        if (participant.purpose) {\n            const participantPurpose = participant.purpose.toLowerCase();\n            return (\n                participantPurpose === \"acd\" ||\n                participantPurpose === \"ivr\" ||\n                participantPurpose === \"dialer.system\" ||\n                participantPurpose === \"voicemail\" ||\n                participantPurpose === \"fax\"\n            );\n        }\n        return false;\n    };\n    self.isInternal = function () {\n        if (participant.purpose) {\n            return (\n                (participant.purpose.toLowerCase() === \"user\" ||\n                    participant.purpose.toLowerCase() === \"agent\") &&\n                !self.isMachine()\n            );\n        } else if (\n            participant.participantType &&\n            participant.participantType.toLowerCase() === \"internal\"\n        ) {\n            // workaround for https://inindca.atlassian.net/browse/AR-2731\n            return !!participant.userId;\n        }\n        return false;\n    };\n\n    self.isExternal = function () {\n        if (participant.purpose) {\n            return (\n                (participant.purpose.toLowerCase() === \"external\" ||\n                    participant.purpose.toLowerCase() === \"customer\") &&\n                !self.isMachine()\n            );\n        } else if (\n            participant.participantType &&\n            participant.participantType.toLowerCase() === \"external\"\n        ) {\n            // workaround for https://inindca.atlassian.net/browse/AR-2731\n            return true;\n        }\n        return false;\n    };\n\n    // Computed observables for action visibility\n    self.canShowMonitor = self.computed(function () {\n        return (\n            (self.canMonitor() && self.isPermittedToMonitor()) ||\n            self.isMonitored()\n        );\n    });\n\n    self.canShowCoach = self.computed(function () {\n        return (\n            self.isInternal() &&\n            ((self.canCoach() && self.isPermittedToCoach()) || self.isCoached())\n        );\n    });\n\n    self.canShowBargeIn = self.computed(function () {\n        return (\n            self.isInternal() &&\n            ((self.canBargeIn() && self.isPermittedToBargeIn()) ||\n                self.isBargedIn())\n        );\n    });\n\n    self.canShowMonitorMessage = self.computed(function () {\n        return (\n            self.isInternal() &&\n            ((self.canMonitorMessage() && self.isPermittedToMonitorMessage()) ||\n                self.isMonitoredMessage())\n        );\n    });\n\n    self.canShowMonitorScreen = self.computed(function () {\n        return (\n            self.isInternal() &&\n            ((self.canMonitorScreen() &&\n                self.isPermittedToStartOrStopScreenMonitoring()) ||\n                self.isMonitoredScreen())\n        );\n    });\n\n    // Unlike showActionButtonForSingleParticipantView, this computed does NOT use\n    // canShowMonitor/canShowCoach/canShowBargeIn/canShowMonitorMessage/canShowMonitorScreen\n    // checks. Those checks indirectly depend on isCurrentUserOnCall, which would hide the\n    // action button entirely. In the multiple participant view, we want the button to remain\n    // visible but in a disabled state (controlled by disableActionDropdown) when the supervisor\n    // is already on the call monitoring another agent. Using permission-only checks here\n    // (isPermittedTo*) ensures the button stays visible while disableActionDropdown handles\n    // the disabled state.\n    //\n    // SCREEN MONITORING (SM) from on-call participants:\n    // - When this participant represents the current user (isCurrentUserParticipant),\n    //   the action button is hidden to prevent self-SM or self-MCB.\n    // - When this participant is another agent, the action button remains visible\n    //   so SM can be initiated. MCB actions are individually disabled via\n    //   getActionStateFlags. SM becomes the primary action button.\n    // - Participants with only internalMessages (no calls/messages/emails/callbacks) do not\n    //   show the action button — no SM or MCB is allowed on internal message-only participants.\n    self.showActionButton = self.computed(function () {\n        if (self.isScreenMonitoringEnabled) {\n            // When this participant represents the current user,\n            // hide the action button — no self-SM or MCB allowed\n            if (isCurrentUserParticipant()) {\n                return false;\n            }\n\n            return (\n                self.isActive() &&\n                !hasParkedMessages() &&\n                !hasParkedEmails() &&\n                !self.bargedParticipantId() &&\n                (self.isPermittedToMonitor() ||\n                    self.isPermittedToCoach() ||\n                    self.isPermittedToBargeIn() ||\n                    self.isPermittedToMonitorMessage() ||\n                    self.isPermittedToStartOrStopScreenMonitoring()) &&\n                (hasConnectedCalls() ||\n                    hasConnectedMessages() ||\n                    hasConnectedEmails() ||\n                    hasConnectedCallbacks())\n            );\n        }\n        return (\n            (self.isPermittedToMonitor() ||\n                self.isPermittedToCoach() ||\n                self.isPermittedToBargeIn() ||\n                self.isPermittedToMonitorMessage()) &&\n            self.isActive() &&\n            self.isInternal() &&\n            (hasConnectedCalls() || hasConnectedMessages()) &&\n            !self.bargedParticipantId()\n        );\n    });\n\n    self.messageActionButton = ko.computed(function () {\n        if (self.isMonitoredMessage()) {\n            return {\n                label: ko.i18n.renderString(\"conversationDetails.stopMonitor\"),\n                accent: \"tertiary\",\n            };\n        }\n        return {\n            label: ko.i18n.renderString(\"conversationDetails.monitor\"),\n            accent: \"primary\",\n        };\n    });\n\n    self.actionButton = ko.computed(function () {\n        if (self.isMonitored()) {\n            return {\n                label: ko.i18n.renderString(\"conversationDetails.stopMonitor\"),\n                accent: \"tertiary\",\n            };\n        } else if (self.isCoached()) {\n            return {\n                label: ko.i18n.renderString(\"conversationDetails.stopCoach\"),\n                accent: \"tertiary\",\n            };\n        } else if (self.isBargedIn()) {\n            return {\n                label: ko.i18n.renderString(\"conversationDetails.stopBarging\"),\n                accent: \"tertiary\",\n            };\n        } else if (\n            !self.isPermittedToCoach() &&\n            !self.isPermittedToMonitor() &&\n            self.isPermittedToBargeIn()\n        ) {\n            return {\n                label: ko.i18n.renderString(\"conversationDetails.bargeIn\"),\n                accent: \"primary\",\n            };\n        } else if (\n            !self.isPermittedToMonitor() &&\n            self.isAlreadyCoached() &&\n            self.isPermittedToBargeIn()\n        ) {\n            return {\n                label: ko.i18n.renderString(\"conversationDetails.bargeIn\"),\n                accent: \"primary\",\n            };\n        } else if (!self.isPermittedToMonitor()) {\n            return {\n                label: ko.i18n.renderString(\"conversationDetails.coach\"),\n                accent: \"primary\",\n            };\n        }\n        return {\n            label: ko.i18n.renderString(\"conversationDetails.monitor\"),\n            accent: \"primary\",\n        };\n    });\n\n    self.screenMonitorActionButton = ko.computed(function () {\n        if (!self.isScreenMonitoringEnabled) {\n            return null;\n        }\n\n        if (self.isMonitoredScreen()) {\n            return {\n                label: ko.i18n.renderString(\n                    \"conversationDetails.stopMonitorScreen\"\n                ),\n                accent: \"tertiary\",\n                icon: Icons.STOP_SCREEN_MONITOR,\n            };\n        }\n        return {\n            label: ko.i18n.renderString(\"conversationDetails.monitorScreen\"),\n            accent: \"primary\",\n            icon: Icons.SCREEN_MONITOR,\n        };\n    });\n\n    /**\n     * ACTION BUTTON SYSTEM\n     *\n     * Conversation supervision actions (Monitor, Coach, Barge-In, Screen Monitor)\n     * with priority-based primary button and dropdown menu.\n     *\n     * FLOW:\n     * 1. getActionStateFlags() - Collects all state (active states, permissions, context)\n     * 2. get*Actions() helpers - Generate action objects based on state (one per action type)\n     * 3. getAllAvailableActions() - Combines all actions, sorts by priority\n     * 4. primaryActionButton() - First enabled action becomes primary button\n     * 5. dropdownActions() - Remaining actions appear in dropdown\n     *\n     * PRIORITY: Stop actions (1-10) > Start actions (11-20)\n     * - Stop actions never disabled, start actions may be disabled by permissions/state\n     * - Lower number = higher priority = appears first\n     *\n     * ACTION STRUCTURE:\n     * { type, label, accent, priority, disabled, click, iconName }\n     *\n     * ADDING NEW ACTION (e.g., \"whisper\"):\n     * 1. Add icons to src/enums/Icons.js (WHISPER, STOP_WHISPER)\n     * 2. Add priorities to ACTION_PRIORITY (use next available: 5 for stop, 15 for start)\n     * 3. Add icon mapping in getActionIconName()\n     * 4. Add state flags to getActionStateFlags()\n     * 5. Create getWhisperActions(state) helper (follow getMonitorActions pattern)\n     * 6. Add to getAllAvailableActions(): ...getWhisperActions(state),\n     * 7. Implement view model methods: whisper(), stopWhisper(), isWhispered(), isPermittedToWhisper()\n     * 8. Add i18n strings to src/strings/en-US.json\n     *\n     * BUSINESS RULES:\n     * - Monitor: call and message conversations only\n     * - Coach/Barge-In: call conversations only\n     * - Screen Monitor: all conversation types (including callback)\n     * - Callback without connected call: Monitor/Coach/Barge-In are hidden in single\n     *   participant view and disabled in multiple participant view; Screen Monitor remains enabled\n     * - Callback with connected call: all actions are enabled\n     * - Barge-in active: disables monitor and coach\n     * - Already monitored/coached: may disable corresponding actions\n     *\n     */\n\n    // Helper function to get icon name based on action type and feature toggles\n    self.getActionIconName = function (actionType) {\n        switch (actionType) {\n            case \"monitor\":\n                return Icons.MONITOR;\n            case \"stopMonitor\":\n                return Icons.STOP_MONITOR;\n            case \"coach\":\n                return Icons.COACH;\n            case \"stopCoach\":\n                return Icons.STOP_COACH;\n            case \"bargeIn\":\n                return Icons.BARGE_IN;\n            case \"stopBargeIn\":\n                return Icons.STOP_BARGE_IN;\n            case \"screenMonitor\":\n                return Icons.SCREEN_MONITOR;\n            case \"stopScreenMonitor\":\n                return Icons.STOP_SCREEN_MONITOR;\n            default:\n                return \"\";\n        }\n    };\n\n    // Action priority constants - stop actions have higher priority (lower numbers)\n    // Gap between stop and start actions allows insertion without renumbering existing code\n    const ACTION_PRIORITY = {\n        // Stop actions  - grouped together\n        STOP_MONITOR: 1,\n        STOP_COACH: 2,\n        STOP_BARGE_IN: 3,\n        STOP_SCREEN_MONITOR: 4,\n        // Gap for new stop actions: 5-10\n\n        // Start actions - grouped together\n        MONITOR: 11,\n        COACH: 12,\n        BARGE_IN: 13,\n        SCREEN_MONITOR: 14,\n        // Gap for new start actions: 15-20\n    };\n\n    // Helper function to get all state flags\n    function getActionStateFlags() {\n        return {\n            isMonitored: self.isMonitored() || self.isMonitoredMessage(),\n            isCoached: self.isCoached(),\n            isBargedIn: self.isBargedIn(),\n            isMonitoredScreen: self.isMonitoredScreen(),\n            canCoach:\n                self.isPermittedToCoach() &&\n                !self.coachRequestInProgress() &&\n                !isCurrentUserOnCallAsAgent(),\n            canMonitor:\n                (self.isPermittedToMonitor() ||\n                    self.isPermittedToMonitorMessage()) &&\n                !self.monitorRequestInProgress() &&\n                !isCurrentUserOnCallAsAgent(),\n            canBargeIn:\n                self.isPermittedToBargeIn() &&\n                !self.bargeInRequestInProgress() &&\n                !isCurrentUserOnCallAsAgent(),\n            canMonitorScreen:\n                self.isPermittedToStartOrStopScreenMonitoring() &&\n                !self.screenMonitorRequestInProgress() &&\n                !isCurrentUserParticipant(),\n            isAlreadyCoached: self.isAlreadyCoached(),\n            isAlreadyMonitored: self.isAlreadyMonitored(),\n            isCallConv: self.isCallConversation(),\n            isMessageConv: self.isMessageConversation(),\n            isCallbackConv: self.isCallbackConversation(),\n            hasCallsConnected: hasConnectedCalls(),\n        };\n    }\n\n    // Helper function to create monitor actions\n    function getMonitorActions(state) {\n        const actions = [];\n        const {\n            isMonitored,\n            canMonitor,\n            isBargedIn,\n            isAlreadyMonitored,\n            isCallConv,\n            isMessageConv,\n            isCallbackConv,\n            hasCallsConnected,\n        } = state;\n\n        if (isMonitored) {\n            const stopLabel =\n                isCallConv || isCallbackConv\n                    ? ko.i18n.renderString(\n                          \"conversationDetails.stopMonitorCall\"\n                      )\n                    : ko.i18n.renderString(\n                          \"conversationDetails.stopMonitorMessage\"\n                      );\n            actions.push({\n                type: \"stopMonitor\",\n                label: stopLabel,\n                accent: \"tertiary\",\n                priority: ACTION_PRIORITY.STOP_MONITOR,\n                disabled: false,\n                click: () => self.stopMonitor(),\n                iconName: self.getActionIconName(\"stopMonitor\"),\n                canShowAction:\n                    self.canShowMonitor() || self.canShowMonitorMessage(),\n                requestInProgress: self.monitorRequestInProgress,\n            });\n        } else if (isCallConv || isMessageConv || isCallbackConv) {\n            const monitorLabel =\n                isCallConv || isCallbackConv\n                    ? ko.i18n.renderString(\"conversationDetails.monitorCall\")\n                    : ko.i18n.renderString(\n                          \"conversationDetails.monitorMessage\"\n                      );\n            actions.push({\n                type: \"monitor\",\n                label: monitorLabel,\n                accent: \"primary\",\n                priority: ACTION_PRIORITY.MONITOR,\n                disabled:\n                    (isCallbackConv && !hasCallsConnected) ||\n                    !canMonitor ||\n                    isBargedIn ||\n                    (isAlreadyMonitored && isMessageConv),\n                click: () => self.monitor(),\n                iconName: self.getActionIconName(\"monitor\"),\n                canShowAction:\n                    self.canShowMonitor() || self.canShowMonitorMessage(),\n                requestInProgress: self.monitorRequestInProgress,\n            });\n        }\n\n        return actions;\n    }\n\n    // Helper function to create coach actions\n    function getCoachActions(state) {\n        const actions = [];\n        const {\n            isCoached,\n            canCoach,\n            isAlreadyCoached,\n            isBargedIn,\n            isCallConv,\n            isCallbackConv,\n            hasCallsConnected,\n        } = state;\n\n        if (isCoached) {\n            actions.push({\n                type: \"stopCoach\",\n                label: ko.i18n.renderString(\"conversationDetails.stopCoach.v2\"),\n                accent: \"tertiary\",\n                priority: ACTION_PRIORITY.STOP_COACH,\n                disabled: false,\n                click: () => self.stopCoach(),\n                iconName: self.getActionIconName(\"stopCoach\"),\n                canShowAction: self.canShowCoach(),\n                requestInProgress: self.coachRequestInProgress,\n            });\n        } else if (isCallConv || isCallbackConv) {\n            actions.push({\n                type: \"coach\",\n                label: ko.i18n.renderString(\"conversationDetails.coach\"),\n                accent: \"primary\",\n                priority: ACTION_PRIORITY.COACH,\n                disabled:\n                    (isCallbackConv && !hasCallsConnected) ||\n                    !canCoach ||\n                    isAlreadyCoached ||\n                    isBargedIn,\n                click: () => self.coach(),\n                iconName: self.getActionIconName(\"coach\"),\n                canShowAction: self.canShowCoach(),\n                requestInProgress: self.coachRequestInProgress,\n            });\n        }\n\n        return actions;\n    }\n\n    // Helper function to create barge-in actions\n    function getBargeInActions(state) {\n        const actions = [];\n        const {\n            isBargedIn,\n            canBargeIn,\n            isCallConv,\n            isCallbackConv,\n            hasCallsConnected,\n        } = state;\n\n        if (isBargedIn) {\n            actions.push({\n                type: \"stopBargeIn\",\n                label: ko.i18n.renderString(\n                    \"conversationDetails.stopBarging.v2\"\n                ),\n                accent: \"tertiary\",\n                priority: ACTION_PRIORITY.STOP_BARGE_IN,\n                disabled: false,\n                click: () => self.stopBarging(),\n                iconName: self.getActionIconName(\"stopBargeIn\"),\n                canShowAction: self.canShowBargeIn(),\n                requestInProgress: self.bargeInRequestInProgress,\n            });\n        } else if (isCallConv || isCallbackConv) {\n            actions.push({\n                type: \"bargeIn\",\n                label: ko.i18n.renderString(\"conversationDetails.bargeIn.v2\"),\n                accent: \"primary\",\n                priority: ACTION_PRIORITY.BARGE_IN,\n                disabled: (isCallbackConv && !hasCallsConnected) || !canBargeIn,\n                click: () => self.bargeIn(),\n                iconName: self.getActionIconName(\"bargeIn\"),\n                canShowAction: self.canShowBargeIn(),\n                requestInProgress: self.bargeInRequestInProgress,\n            });\n        }\n\n        return actions;\n    }\n\n    // Helper function to create screen monitor actions\n    function getScreenMonitorActions(state) {\n        const actions = [];\n        const { isMonitoredScreen, canMonitorScreen } = state;\n\n        if (isMonitoredScreen) {\n            actions.push({\n                type: \"stopScreenMonitor\",\n                label: ko.i18n.renderString(\n                    \"conversationDetails.stopMonitorScreen\"\n                ),\n                accent: \"tertiary\",\n                priority: ACTION_PRIORITY.STOP_SCREEN_MONITOR,\n                disabled: false,\n                click: () => self.stopScreenMonitor(),\n                iconName: self.getActionIconName(\"stopScreenMonitor\"),\n                canShowAction: self.canShowMonitorScreen(),\n                requestInProgress: self.screenMonitorRequestInProgress,\n            });\n        } else {\n            actions.push({\n                type: \"screenMonitor\",\n                label: ko.i18n.renderString(\n                    \"conversationDetails.monitorScreen\"\n                ),\n                accent: \"primary\",\n                priority: ACTION_PRIORITY.SCREEN_MONITOR,\n                disabled: !canMonitorScreen,\n                click: () => self.startScreenMonitor(),\n                iconName: self.getActionIconName(\"screenMonitor\"),\n                canShowAction: self.canShowMonitorScreen(),\n                requestInProgress: self.screenMonitorRequestInProgress,\n            });\n        }\n\n        return actions;\n    }\n\n    // Centralized action definitions with priority and conditions\n    self.getAllAvailableActions = ko.computed(function () {\n        if (!self.isScreenMonitoringEnabled) {\n            return [];\n        }\n\n        const state = getActionStateFlags();\n        const actions = [\n            ...getMonitorActions(state),\n            ...getCoachActions(state),\n            ...getBargeInActions(state),\n            ...getScreenMonitorActions(state),\n        ];\n\n        return actions.sort((a, b) => a.priority - b.priority);\n    });\n\n    // Primary action button (highest priority enabled action)\n    self.primaryActionButton = ko.computed(function () {\n        if (!self.isScreenMonitoringEnabled) {\n            return null;\n        }\n\n        const actions = self.getAllAvailableActions();\n        // Find the first enabled action (not disabled)\n        const enabledAction = actions.find((action) => !action.disabled);\n\n        if (enabledAction) {\n            return {\n                label: enabledAction.label,\n                accent: enabledAction.accent,\n                icon: enabledAction.iconName,\n            };\n        }\n\n        // Default fallback\n        const defaultLabel =\n            self.isCallConversation() || self.isCallbackConversation()\n                ? ko.i18n.renderString(\"conversationDetails.monitorCall\")\n                : ko.i18n.renderString(\"conversationDetails.monitorMessage\");\n        return {\n            label: defaultLabel,\n            accent: \"primary\",\n            icon: self.getActionIconName(\"monitor\"),\n        };\n    });\n\n    // Click handler for primary action button - matches by label and calls the action\n    // Look up the action at click time to avoid race conditions with state changes\n    self.onClickPrimaryActionButton = ko.computed(function () {\n        return function () {\n            if (!self.isScreenMonitoringEnabled) {\n                return;\n            }\n\n            const actions = self.getAllAvailableActions();\n            const buttonState = self.primaryActionButton();\n            // Find the action that matches the current button label at click time\n            const matchingAction = actions.find(\n                (action) => action.label === buttonState.label\n            );\n\n            if (matchingAction) {\n                matchingAction.click();\n            } else {\n                // Fallback to monitor if no matching action found (shouldn't happen in normal flow)\n                self.monitor();\n            }\n        };\n    });\n\n    // Simplified dropdown actions - all actions except the primary one\n    self.dropdownActions = ko.computed(function () {\n        if (!self.isScreenMonitoringEnabled) {\n            return [];\n        }\n\n        const allActions = self.getAllAvailableActions();\n        const primaryAction = self.primaryActionButton();\n\n        // Return all actions except the primary one, plus any parallel actions\n        return allActions\n            .filter((action) => {\n                // Include if it's not the primary action\n                if (action.label !== primaryAction.label) {\n                    return true;\n                }\n            })\n            .map((action) => ({\n                type: action.type,\n                label: action.label,\n                disabled: action.disabled, // Use the disabled state from action definition\n                click: action.click,\n                iconName: action.iconName,\n            }));\n    });\n\n    self.hasParticipantName = function () {\n        return participant.name && participant.name.trim().length > 0;\n    };\n\n    // Set this when there is a user for the participant and the participant name is not the user name.\n    self.userDisplayString = self.computed(function () {\n        if (self.user && self.user() && self.user().name) {\n            if (self.nameDisplayString() !== self.user().name()) {\n                return self.user().name();\n            }\n        }\n    });\n\n    self.hasWrapUpCode = self.computed(function () {\n        return !!conversationParticipant()?.wrapup;\n    });\n\n    self.hasName = ko.observable(true);\n\n    self.wrapUpCodeName = self.computed(function () {\n        let name;\n        if (self.hasWrapUpCode()) {\n            name = getWrapupName(conversationParticipant()?.wrapup);\n            self.hasName(!!name);\n        }\n        return name;\n    });\n\n    self.hasWrapUpNotes = self.computed(function () {\n        return !!conversationParticipant()?.wrapup?.notes;\n    });\n\n    self.wrapUpNotes = self.computed(function () {\n        if (self.hasWrapUpNotes()) {\n            return conversationParticipant()?.wrapup?.notes;\n        } else {\n            return \"\";\n        }\n    });\n\n    self.awaitingWrapup = self.computed(function () {\n        return (\n            !self.hasWrapUpCode() && conversationParticipant()?.wrapupRequired\n        );\n    });\n\n    self.pastWrapUpCodesView = {\n        popoverTitle: self.computed(function () {\n            return ko.i18n.renderString({\n                name: \"conversationDetails.pastWrapUps.title\",\n                data: {\n                    participantName: self.userDisplayString() || self.name,\n                },\n            });\n        }),\n        pastWrapUpCodes: self.computed(function () {\n            const pastWrapUpCodes = [];\n            if (analyticsParticipant() && analyticsParticipant().sessions) {\n                _.each(analyticsParticipant().sessions, function (session) {\n                    if (\n                        session &&\n                        session.segments &&\n                        session.mediaType !== \"callback\"\n                    ) {\n                        _.each(session.segments, function (segment) {\n                            if (\n                                segment.segmentType === \"wrapup\" &&\n                                segment.wrapUpCode\n                            ) {\n                                if (!wrapUpCodeNamesById[segment.wrapUpCode]) {\n                                    wrapUpCodeNamesById[segment.wrapUpCode] =\n                                        ko.observable();\n\n                                    if (\n                                        uuidUtils.isValidUuid(\n                                            segment.wrapUpCode\n                                        ) &&\n                                        qualityAuth.canViewWrapupCode(\n                                            ko.unwrap(\n                                                self.conversationDivisionIds\n                                            )\n                                        )\n                                    ) {\n                                        wrapUpCodeService\n                                            .getWrapupCodeById(\n                                                segment.wrapUpCode\n                                            )\n                                            .then(function (wrapUpFetchResult) {\n                                                wrapUpCodeNamesById[\n                                                    segment.wrapUpCode\n                                                ](\n                                                    getWrapupName(\n                                                        wrapUpFetchResult\n                                                    )\n                                                );\n                                            })\n                                            .catch(function (err) {\n                                                LOG.error(\n                                                    \"Error fetching wrap up code with id\",\n                                                    {\n                                                        wrapUpCode:\n                                                            segment.wrapUpCode,\n                                                        err,\n                                                    }\n                                                );\n                                            });\n                                    } else if (\n                                        _.startsWith(\n                                            segment.wrapUpCode,\n                                            \"ININ-\"\n                                        )\n                                    ) {\n                                        wrapUpCodeNamesById[segment.wrapUpCode](\n                                            segment.wrapUpCode\n                                        );\n                                    } else {\n                                        LOG.debug(\n                                            \"Skipping invalid wrap-up code format\"\n                                        );\n                                    }\n                                }\n\n                                const wrapUpNote = ko.observable(\n                                    segment.wrapUpNote\n                                );\n                                pastWrapUpCodes.push({\n                                    wrapUpCodeName:\n                                        wrapUpCodeNamesById[segment.wrapUpCode],\n                                    wrapUpCodeId: segment.wrapUpCode,\n                                    wrapUpNote: wrapUpNote,\n                                    hasWrapUpCodeName: ko.computed(function () {\n                                        return !!wrapUpCodeNamesById[\n                                            segment.wrapUpCode\n                                        ]();\n                                    }),\n                                    hasWrapUpNotes: ko.computed(function () {\n                                        return !!wrapUpNote();\n                                    }),\n                                });\n                            }\n                        });\n                    }\n                });\n            }\n            return pastWrapUpCodes;\n        }),\n    };\n\n    self.hasAdditionalWrapUpCodes = ko.computed(function () {\n        return (\n            self.pastWrapUpCodesView.pastWrapUpCodes() &&\n            self.pastWrapUpCodesView.pastWrapUpCodes().length > 1\n        );\n    });\n\n    self.toggleAdditionalWrapUpCodes = function (id) {\n        const popoverTargetId = \"popover-AdditionalWrapUpCodes-wrapper-\" + id;\n        const spanTargetId = \"popover-AdditionalWrapUpCodes-\" + id;\n        const popoverTarget = document.getElementById(popoverTargetId);\n        const spanTarget = document.getElementById(spanTargetId);\n        const isOpen = popoverTarget.isOpen ? false : true;\n        spanTarget.ariaExpanded = isOpen;\n        popoverTarget.isOpen = isOpen;\n    };\n\n    self.monitor = function () {\n        self.monitorRequestInProgress(true);\n        let response = null;\n        if (hasCalls()) {\n            response = callService.monitorCall(\n                self.conversationId,\n                participant.id,\n                true\n            );\n        } else if (hasMessages()) {\n            response = messageService.monitorMessage(\n                self.conversationId,\n                participant.id,\n                true\n            );\n        }\n        return response\n            .catch(\n                errorCallbackFactory.createCallback({\n                    namespace: \"conversationDetails.monitorRequest\",\n                })\n            )\n            .finally(function () {\n                self.monitorRequestInProgress(false);\n            });\n    };\n\n    self.stopMonitor = function () {\n        if (monitoredCall() || monitoredMessage()) {\n            self.monitorRequestInProgress(true);\n            let response = null;\n            if (hasCalls()) {\n                response = callService.endCall(\n                    monitoredCall().id,\n                    monitoredCall().participantForCurrentUser().id\n                );\n            } else if (hasMessages()) {\n                response = messageService.endMessage(\n                    monitoredMessage().id,\n                    monitoredMessage().participantForCurrentUser().id\n                );\n            }\n            return response\n                .catch(\n                    errorCallbackFactory.createCallback({\n                        namespace: \"conversationDetails.stopMonitorRequest\",\n                    })\n                )\n                .finally(function () {\n                    self.monitorRequestInProgress(false);\n                });\n        }\n    };\n\n    self.showActionButtonForSingleParticipantView = self.computed(function () {\n        if (self.isScreenMonitoringEnabled) {\n            return (\n                self.isActive() &&\n                (self.canShowMonitor() ||\n                    self.canShowCoach() ||\n                    self.canShowBargeIn() ||\n                    self.canShowMonitorMessage() ||\n                    self.canShowMonitorScreen()) &&\n                !self.bargedParticipantId()\n            );\n        }\n        return (\n            self.canShowMonitor() ||\n            self.canShowCoach() ||\n            self.canShowBargeIn() ||\n            (self.canShowMonitorMessage() &&\n                self.isInternal() &&\n                self.isActive() &&\n                hasConnectedMessages())\n        );\n    });\n\n    self.subscribe(self.isMonitored, function () {\n        if (self.isInternal()) {\n            isAnyInternalParticipantMonitored(self.isMonitored());\n        } else if (self.isExternal()) {\n            isExternalParticipantMonitored(self.isMonitored());\n        }\n        self.isOpen(false);\n    });\n\n    self.subscribe(self.isMonitoredMessage, function () {\n        if (self.isInternal()) {\n            isAnyInternalParticipantMonitored(self.isMonitoredMessage());\n        }\n        self.isOpen(false);\n    });\n\n    self.subscribe(self.isMonitoredScreen, function () {\n        if (self.isInternal()) {\n            isAnyInternalParticipantScreenMonitored(self.isMonitoredScreen());\n        }\n        self.isOpen(false);\n    });\n\n    self.coach = function () {\n        self.coachRequestInProgress(true);\n        return callService\n            .coachCall(self.conversationId, participant.id, true)\n            .catch(\n                errorCallbackFactory.createCallback({\n                    namespace: \"conversationDetails.coachRequest\",\n                })\n            )\n            .finally(function () {\n                self.coachRequestInProgress(false);\n            });\n    };\n\n    self.stopCoach = function () {\n        if (coachedCall()) {\n            self.coachRequestInProgress(true);\n            return callService\n                .endCall(\n                    coachedCall().id,\n                    coachedCall().participantForCurrentUser().id\n                )\n                .catch(\n                    errorCallbackFactory.createCallback({\n                        namespace: \"conversationDetails.stopCoachRequest\",\n                    })\n                )\n                .finally(function () {\n                    self.coachRequestInProgress(false);\n                });\n        }\n    };\n\n    self.startScreenMonitor = function () {\n        // Check WEM-437 feature toggle\n        if (!self.isScreenMonitoringEnabled) {\n            return;\n        }\n\n        self.screenMonitorRequestInProgress(true);\n        return screenMonitoringService\n            .startScreenMonitoring(self.conversationId, participant.id)\n            .catch(\n                errorCallbackFactory.createCallback({\n                    namespace: \"screenMonitorRequest.error\",\n                })\n            )\n            .finally(function () {\n                self.screenMonitorRequestInProgress(false);\n            });\n    };\n\n    self.stopScreenMonitor = function () {\n        // Check WEM-437 feature toggle\n        if (!self.isScreenMonitoringEnabled) {\n            return;\n        }\n\n        if (monitoredScreen()) {\n            const supervisorParticipant =\n                monitoredScreen().screenMonitorParticipantForCurrentUser();\n            self.screenMonitorRequestInProgress(true);\n            const promise =\n                screenMonitoringType() === ScreenMonitoringType.AGENT_LEVEL\n                    ? screenMonitoringService.stopAgentLevelScreenMonitoring(\n                          participant.userId,\n                          screenMonitoringId()\n                      )\n                    : screenMonitoringService.stopConversationLevelScreenMonitoring(\n                          self.conversationId,\n                          supervisorParticipant?.id,\n                          screenMonitoringId()\n                      );\n\n            return promise\n                .catch(\n                    errorCallbackFactory.createCallback({\n                        namespace: \"screenMonitorRequest.error\",\n                    })\n                )\n                .finally(function () {\n                    self.screenMonitorRequestInProgress(false);\n                });\n        }\n    };\n\n    self.bargeIn = function () {\n        self.bargeInRequestInProgress(true);\n        return callService\n            .bargeInCall(self.conversationId, participant.id, true)\n            .catch(\n                errorCallbackFactory.createCallback({\n                    namespace: \"conversationDetails.bargeInRequest\",\n                })\n            )\n            .finally(function () {\n                self.bargeInRequestInProgress(false);\n            });\n    };\n\n    self.stopBarging = function () {\n        if (bargedInCall()) {\n            self.bargeInRequestInProgress(true);\n            return callService\n                .endCall(\n                    bargedInCall().id,\n                    bargedInCall().participantForCurrentUser().id\n                )\n                .catch(\n                    errorCallbackFactory.createCallback({\n                        namespace: \"conversationDetails.stopBargingRequest\",\n                    })\n                )\n                .finally(function () {\n                    self.bargeInRequestInProgress(false);\n                });\n        }\n    };\n\n    self.onClickActionButton = function () {\n        if (self.isMonitored()) {\n            self.stopMonitor();\n        } else if (self.isCoached()) {\n            self.stopCoach();\n        } else if (self.isBargedIn()) {\n            self.stopBarging();\n        } else if (\n            !self.isPermittedToCoach() &&\n            !self.isPermittedToMonitor() &&\n            self.isPermittedToBargeIn()\n        ) {\n            self.bargeIn();\n        } else if (\n            !self.isPermittedToMonitor() &&\n            self.isAlreadyCoached() &&\n            self.isPermittedToBargeIn()\n        ) {\n            self.bargeIn();\n        } else if (!self.isPermittedToMonitor()) {\n            self.coach();\n        } else {\n            self.monitor();\n        }\n    };\n\n    self.messageOnClickActionButton = function () {\n        if (self.isMonitoredMessage()) {\n            self.stopMonitor();\n        } else {\n            self.monitor();\n        }\n    };\n\n    self.screenMonitorOnClickActionButton = function () {\n        if (self.isMonitoredScreen()) {\n            self.stopScreenMonitor();\n        } else {\n            self.startScreenMonitor();\n        }\n    };\n\n    self.subscribe(self.isBargedIn, function () {\n        isAnyInternalParticipantBargedIn(self.isBargedIn());\n        self.isOpen(false);\n    });\n\n    self.subscribe(self.isCoached, function () {\n        isAnyInternalParticipantCoached(self.isCoached());\n        self.isOpen(false);\n    });\n\n    self.disableActionButton = self.computed(function () {\n        return (\n            !self.isMonitored() &&\n            !self.isCoached() &&\n            !self.isBargedIn() &&\n            isCurrentUserOnCall()\n        );\n    });\n\n    // Controls whether the action dropdown is disabled in the multi-participant view.\n    // This is the main gating mechanism for the gux-action-button disabled state.\n    //\n    // DECISION FLOW:\n    // 1. Active monitoring session on THIS participant (monitor/coach/barge/SM) → return false\n    //    Dropdown not disabled — allows the user to stop the active session.\n    //\n    // 2. User is on call as an original agent (isCurrentUserOnCallAsAgent) → return false\n    //    Dropdown not disabled — agent can initiate SM on other agents. MCB actions are\n    //    individually disabled via getActionStateFlags. SM becomes the primary action button.\n    //    This also covers internal message consultants (participants with internalMessages).\n    //\n    // 3. User is on call but NOT as an agent (isCurrentUserOnCall, e.g., supervisor\n    //    via call monitor/coach/barge) → return true\n    //    Dropdown disabled — prevents supervisor from acting on multiple agents simultaneously.\n    //\n    // 4. Otherwise → falls through to permission-based checks for specific conversation types.\n    self.disableActionDropdown = self.computed(function () {\n        if (!self.isScreenMonitoringEnabled) {\n            return false;\n        }\n\n        const isCallConv = self.isCallConversation();\n        const isMessageConv = self.isMessageConversation();\n        const isCallbackConv = self.isCallbackConversation();\n\n        // If there's already an active monitoring session, don't disable dropdown\n        if (\n            self.isMonitored() ||\n            self.isCoached() ||\n            self.isBargedIn() ||\n            self.isMonitoredMessage() ||\n            self.isMonitoredScreen()\n        ) {\n            return false;\n        } else if (isCurrentUserOnCallAsAgent()) {\n            // User is on the call as an original agent — keep dropdown enabled\n            // so SM can be used. MCB actions are individually disabled via\n            // getActionStateFlags (!isCurrentUserOnCallAsAgent check).\n            // If user has no SM permission, or is already monitoring/SM-ing\n            // another agent, disable the dropdown entirely.\n            return (\n                !self.isPermittedToStartOrStopScreenMonitoring() ||\n                isAnyInternalParticipantScreenMonitored()\n            );\n        } else if (isCurrentUserOnCall()) {\n            return true;\n        }\n\n        // For call or callback conversation: disable if all 4 permissions are not there\n        if (isCallConv || isCallbackConv) {\n            const hasMonitorPermission = self.isPermittedToMonitor();\n            const hasCoachPermission = self.isPermittedToCoach();\n            const hasBargeInPermission = self.isPermittedToBargeIn();\n            const hasScreenMonitorPermission =\n                self.isPermittedToStartOrStopScreenMonitoring();\n\n            // If only coach permission is there and isAlreadyCoached is true, disable dropdown\n            if (\n                hasCoachPermission &&\n                !hasMonitorPermission &&\n                !hasBargeInPermission &&\n                !hasScreenMonitorPermission &&\n                self.isAlreadyCoached()\n            ) {\n                return true;\n            }\n        }\n\n        // For message conversation: disable if both permissions are not there\n        if (isMessageConv) {\n            const hasMonitorMessagePermission =\n                self.isPermittedToMonitorMessage();\n            const hasScreenMonitorPermission =\n                self.isPermittedToStartOrStopScreenMonitoring();\n\n            // If only monitor permission is there and isAlreadyMonitored is true, disable dropdown\n            if (\n                hasMonitorMessagePermission &&\n                !hasScreenMonitorPermission &&\n                self.isAlreadyMonitored()\n            ) {\n                return true;\n            }\n        }\n\n        return false;\n    });\n\n    self.hideMessageActionButton = self.computed(function () {\n        return !self.isMonitoredMessage() && isCurrentUserOnCall();\n    });\n\n    self.nameDisplayString = self.computed(function () {\n        let calculatedDisplayString = \"\";\n        if (self.isExternal()) {\n            if (self.externalContact()) {\n                if (\n                    self.externalContact().firstName &&\n                    self.externalContact().lastName\n                ) {\n                    calculatedDisplayString = ko.i18n.renderString({\n                        name: \"conversationDetails.externalContact.nameFormat\",\n                        data: {\n                            firstName: self.externalContact().firstName,\n                            lastName: self.externalContact().lastName,\n                        },\n                    });\n                } else if (\n                    self.externalContact().firstName ||\n