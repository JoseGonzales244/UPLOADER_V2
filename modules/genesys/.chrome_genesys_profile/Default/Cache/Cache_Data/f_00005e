n * New calibration from scoring index: #/analytics/interactions/{cid}/admin/calibrations/{id}\n * (engage route uses .../calibrations/{id} the same way.)\n */\nfunction extractCalibrationIdFromNavigationString(path: string): string | null {\n    if (!path) {\n        return null;\n    }\n    const hashStart = path.indexOf(\"#\");\n    const relevant = hashStart !== -1 ? path.slice(hashStart + 1) : path;\n    const pathOnly = relevant.split(\"?\")[0] ?? \"\";\n    const match = pathOnly.match(/\\/calibrations\\/([^/?#]+)/);\n    return match ? match[1] : null;\n}\n\ninterface IToastNotification {\n    title: string;\n    message: string;\n    type: string;\n    publishOnUserInteraction: boolean;\n    hideAfter?: number;\n    tag?: any;\n    body: string;\n}\n\ninterface EvaluationEventMessage {\n    evaluationNotificationEventType: string;\n}\n\nexport default class EmbeddedQualityFormEditor extends ViewModel {\n    private childIFrame!: HTMLIFrameElement | null;\n    formUrl: ko.Observable<string>;\n\n    constructor(\n        private formType: string,\n        private scorableId: string,\n        private conversationId: string,\n        private isAdminContext: boolean,\n        private deleteEvaluationCallback: (\n            conversationId: string,\n            data: any\n        ) => unknown,\n        private closeSidePanelCallback: () => unknown,\n        private assignmentPanel?: string,\n        private qualityFormVersion?: string\n    ) {\n        super();\n\n        const validFormTypes = _.keys(FormType);\n        const isValidFormType = _.includes(validFormTypes, formType);\n        if (!isValidFormType || !scorableId) {\n            loggingService.error(\"bad argument(s)\", {\n                formType,\n                scorableId,\n            });\n        }\n\n        // Initialize with empty string to prevent premature iframe loading\n        // The URL will be set asynchronously after getting a fresh token\n        this.formUrl = ko.observable(\"\");\