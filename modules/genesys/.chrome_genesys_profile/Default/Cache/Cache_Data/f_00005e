tion.calibratorId) {\n            calibration.calibrator = { id: authService.principalId() };\n        }\n        return apiCore.v2.put(\n            \"/quality/calibrations/\" + calibration.id,\n            calibration\n        );\n    },\n    deleteCalibration: function (calibrationId, options) {\n        if (!options) {\n            options = {};\n        }\n        if (!options.calibratorId) {\n            options.calibratorId = authService.principalId();\n        }\n        return apiCore.v2.del(\n            \"/quality/calibrations/\" + calibrationId,\n            options\n        );\n    },\n    updateAssignedEvaluation: function (\n        conversationId,\n        assignedEvaluationId,\n        assignedEvaluation\n    ) {\n        return apiCore.v2\n            .put(\n                \"/quality/conversations/\" +\n                    conversationId +\n                    \"/evaluations/\" +\n                    assignedEvaluationId,\n                assignedEvaluation\n            )\n            .then(function (response) {\n                return response;\n            });\n    },\n    /**\n     * Creates an evaluation. When QM_19313_EVALUATION_DEDUPLICATION is on, sends\n     * Idempotency-Key for deduplication (see \"Create-evaluation deduplication\" block above).\n     *\n     * @param {Object} evaluation - Evaluation payload (conversation, evaluationForm, agent, queue, evaluator, etc.)\n     * @returns {Promise} Resolves with created evaluation; backend may return 409 for duplicate key.\n     */\n    createEvaluation: function (evaluation) {\n        let headers;\n        if (\n            featureToggleService.isEnabled(\n                FeatureToggle.QM_19313_EVALUATION_DEDUPLICATION\n            )\n        ) {\n            headers = {\n                \"Idempotency-Key\":\n                    generateIdempotencyKeyForCreateEvaluation(evaluation),\n            };\n        }\n\n        const request = apiCore.v2.post(\n            \"/quality/conversation