  return navHelper.asHostHash(\n            addQueryParamToWindow({ evaluationId: evaluation.id })\n        );\n    };\n\n    const aggregateEvaluationData = function (\n        evaluationForm,\n        scoreRows,\n        evaluation,\n        evaluatorId\n    ) {\n        // Generate href for navigation using existing getEvaluationHref logic\n        // Handle both regular evaluators and scoring index cases\n        const evaluationHref = getEvaluationHref(evaluation);\n\n        scoreRows[\"evaluation-total\"][evaluatorId] = {\n            score: EMPTYSCORE,\n            comments: \"\",\n            href: evaluationHref,\n        };\n        scoreRows[\"evaluation-total\"].style = \"evaluation-total-score-row\";\n\n        /* -- Get evaluation comments if it exists -- */\n        if (\n            evaluation.hasOwnProperty(\"answers\") &&\n            evaluation.answers.comments !== \"\"\n        ) {\n            //Get the comments for the overall evaluation\n            scoreRows[\"evaluation-total\"][evaluatorId].comments =\n                evaluation.answers.comments;\n        }\n\n        _.each(evaluationForm.questionGroups, function (questionGroup) {\n            scoreRows[questionGroup.id][evaluatorId] = {\n                score: EMPTYSCORE,\n                comments: \"\",\n                href: evaluationHref,\n            };\n\n            // Recurse down to initialize question scores\n            _.each(questionGroup.questions, function (question) {\n                scoreRows[question.id][evaluatorId] = {\n                    score: EMPTYSCORE,\n                    comments: \"\",\n                    href: evaluationHref,\n                };\n            });\n        });\n\n        if (\n            evaluation.status === EvaluationStatus.FINISHED &&\n            evaluation.answers\n        ) {\n            // Fill in the score rows for the evaluation grid.\n            const totalScoreString = ko.i18n.formatNumber(\n                evaluation.answers.t