ackContext.AGENT;\n\n        const evaluationOptions = {\n            agentId: userService.currentUser().id,\n            conversationId: self.conversationId(),\n            userType: userType,\n        };\n\n        if (userType === \"agent\") {\n            evaluationOptions.isReleased = true;\n            evaluationOptions.evaluationState = [EvaluationStatus.FINISHED];\n        }\n\n        qualityManagementService\n            .getAssignedEvaluations(evaluationOptions)\n            .then(function (response) {\n                self.evaluations(response);\n            })\n            .catch(function (error) {\n                const httpStatus =\n                    error.type === \"http\" ? error.details.status : undefined;\n                if (!(httpStatus && httpStatus === 401)) {\n                    errorCallbackFactory.createCallback({\n                        namespace: \"playback.evaluationsRequest\",\n                    })(error);\n                }\n            })\n            .finally(function () {\n                self.isEvaluationsLoading(false);\n            });\n    };\n\n    const getCalibrations = function () {\n        if (userService.currentUser()) {\n            if (qualityAuthorization.canViewCalibration()) {\n                qualityManagementService\n                    .getCalibrations({\n                        conversationId: self.conversationId(),\n                        calibratorId: userService.currentUser().id,\n                    })\n                    .then(self.calibrations)\n                    .catch(\n                        errorCallbackFactory.createCallback({\n                            namespace: \"playback.calibrationsRequest\",\n                        })\n                    )\n                    .finally(function () {\n                        self.isCalibrationsLoading(false);\n                    });\n            }\n        }\n    };\n    getCalibrations();\n    self.subscribe(userService.currentUser, getCalibrations);\n\n    // header for a historical call\n    self.historicalInteractionType = ko.computed(function () {\n        if (self.conversationDetailsView.hasCalls()) {\n            if (self.conversationDetailsView.isAcdVoicemail()) {\n                return { icon: \"voicemail\", title: \"voicemail\" };\n            } else {\n                return { icon: \"phone\", title: \"audio\" };\n            }\n        }\n        if (self.conversationDetailsView.hasChats()) {\n            return { icon: \"fa/comment-regular\", title: \"chat\" };\n        }\n        if (self.conversationDetailsView.hasEmails()) {\n            return { icon: \"message-email\", title: \"email\" };\n        }\n        if (self.conversationDetailsView.hasMessages()) {\n            return { icon: \"fa/message-dots-regular\", title: \"message\" };\n        } else {\n            return null;\n        }\n    });\n\n    // header for a live call\n    self.liveInteractionType = ko.computed(function () {\n        if (self.conversationDetailsView.hasCalls()) return \"call\";\n        if (self.conversationDetailsView.hasChats()) return \"chat\";\n        if (self.conversationDetailsView.hasEmails()) return \"email\";\n        if (self.conversationDetailsView.hasMessages()) return \"message\";\n        return null;\n    });\n\n    self.liveHeader = self.subView(\n        PlaybackHeaderView,\n        ko.i18n.renderString(\"playback.recording.duration\"),\n        self.liveInteractionType,\n        self.isActiveInteraction,\n        self.hasParkedInteraction()\n    );\n\n    const initializeHeader = function () {\n        let formattedStartTime;\n\n        if (self.hasParkedInteraction()) {\n            self.liveHeader.endTime(self.parkedEndTime());\n        } else {\n            self.liveHeader.endTime(\n                ko.i18n.renderString(\"playback.recording.live\")\n            );\n        }\n        if (self.conversation() && self.conversation().startTime) {\n            formattedStartTime = ko.i18n.formatD