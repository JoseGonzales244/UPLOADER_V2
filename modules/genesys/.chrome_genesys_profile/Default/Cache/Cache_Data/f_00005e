              _.some(participant.callbacks, function (callback) {\n                        return _.some(callback.segments, function (segment) {\n                            return !segment.endTime;\n                        });\n                    })\n                );\n            });\n        }\n        return false;\n    });\n\n    self.parkedEndTime = self.computed(function () {\n        let parkedTime = ko.i18n.renderString(\"playback.recording.live\");\n        if (self.conversation() && self.conversation().participants) {\n            const participants = self.conversation().participants();\n            participants.forEach(function (participant) {\n                if (\n                    participant.purpose &&\n                    (participant.purpose.toLowerCase() === \"agent\" ||\n                        participant.purpose.toLowerCase() === \"user\") &&\n                    (participant.emails ||\n                        (participant.messages && isMessageParkingEnabled))\n                ) {\n                    if (participant.emails) {\n                        participant.emails.forEach(function (email) {\n                            if (email.state === \"parked\") {\n                                parkedTime = ko.i18n.formatDate(\n                                    ko.unwrap(email.parkTime),\n                                    timeFormatWithSeconds,\n                                    null,\n                                    SHORT_WEEKDAY_FULL_DATETIME_OPTIONS\n                                );\n                            }\n                        });\n                    }\n                    if (participant.messages) {\n                        participant.messages.forEach(function (message) {\n                            if (message.state === \"parked\") {\n                                parkedTime = ko.i18n.formatDate(\n                                    ko.unwrap(message.parkTime),\n                                    timeFormatWithSeconds,\n                                    null,\n                                    SHORT_WEEKDAY_FULL_DATETIME_OPTIONS\n                                );\n                            }\n                        });\n                    }\n                }\n            });\n        }\n        return parkedTime;\n    });\n\n    //Check if participant is connected\n    const isParticipantConnected = function (participant) {\n        let participants = [];\n        if (self.conversationDetailsView.hasCalls()) {\n            participants = participant.calls;\n        }\n        if (self.conversationDetailsView.hasMessages()) {\n            participants = participant.messages;\n        }\n        if (\n            isScreenMonitoringEnabled &&\n            self.conversationDetailsView.hasEmails()\n        ) {\n            participants = participant.emails;\n        }\n        if (\n            isScreenMonitoringEnabled &&\n            participant.screenMonitorings &&\n            participant.screenMonitorings.length > 0\n        ) {\n            participants = participant.screenMonitorings;\n        }\n\n        return _.some(participants, (item) =>\n            _.some(\n                item.segments,\n                (segment) =>\n                    segment.type === \"Interact\" ||\n                    segment.type === \"Coaching\" ||\n                    segment.type === \"Monitoring\" ||\n                    segment.type === \"Screenmonitoring\"\n            )\n        );\n    };\n    // check if map have particular agent map , if yes add or update coaching / monitoring session else create new map with new session\n    const addMonitorsAndCoachToMap = function (\n        agentToSupervisors,\n        supervisor,\n        agentUserId,\n        supervisorUserId\n    ) {\n        if (!agentToSupervisors.has(agentUserId)) {\n            agentToSupervisors.set(agentUserId, new Map());\n        }\n\n        const supervisors = agentToSupervisors.get(agentUserId);\n\n        // If WEM-437 feature toggle is enabled, merge properties when same user has multiple participants\n        // (e.g., one for monitor/coach and one for screenMonitor)\n        // Otherwise, use existing behavior (overwrite)\n        if (isScreenMonitoringEnabled && supervisors.has(supervisorUserId)) {\n            const existingSupervisor = supervisors.get(supervisorUserId);\n\n            // Merge only if both are active or both are inactive, otherwise keep only the active one\n            const bothActive =\n                existingSupervisor.isActive && supervisor.isActive;\n            const bothInactive =\n                !existingSupervisor.isActive && !supervisor.isActive;\n\n            if (bothActive || bothInactive) {\n                // Merge properties: preserve existing properties and add new ones\n                supervisors.set(supervisorUserId, {\n                    ...existingSupervisor,\n                    ...supervisor,\n                    // Merge boolean flags using OR logic to preserve both states\n                    isMonitor:\n                        existingSupervisor.isMonitor ||\n                        supervisor.isMonitor ||\n                        false,\n                    isCoach:\n                        existingSupervisor.isCoach ||\n                        supervisor.isCoach ||\n                        false,\n                    isScreenMonitor:\n                        existingSupervisor.isScreenMonitor ||\n                        supervisor.isScreenMonitor ||\n                        false,\n                    // Use the most recent participantView if available\n                    participantView:\n                        supervisor.participantView ||\n                        existingSupervisor.participantView,\n                    // isActive should match the state (both are same)\n                    isActive: existingSupervisor.isActive,\n                });\n            } else {\n                // One is active, one is inactive - keep only the active one\n                if (supervisor.isActive) {\n                    supervisors.set(supervisorUserId, supervisor);\n                }\n                // If existingSupervisor is active and supervisor is inactive, keep existingSupervisor (do nothing)\n            }\n        } else {\n            // Existing behavior: overwrite if entry exists, or set if it doesn't\n            supervisors.set(supervisorUserId, supervisor);\n        }\n\n        return agentToSupervisors;\n    };\n\n    self.agentToMonitorCoachMap = self.computed(function () {\n        const conversation = self.conversation();\n        let agentToSupervisors = new Map();\n        const participantIdToUserIdMap = new Map();\n\n        if (conversation?.participants) {\n            _.each(\n                ko.unwrap(self.conversation().participants),\n                function (participant) {\n                    // keep track of all participant ID's to user ID's\n                    participantIdToUserIdMap.set(\n                        participant.id,\n                        participant.userId\n                    );\n\n                    // External user will not have userID , add tag \"external\" to identify if external user is monitored / coached\n                    if (\n                        participant.participantType?.toLowerCase() ===\n                        \"external\"\n                    ) {\n                        participantIdToUserIdMap.set(\n                            participant.id,\n                            \"external\"\n                        );\n                    }\n                    // Get all unique targetUserIds from ScreenMonitoring object\n                    let participantTargetUserIds = [];\n                    if (isScreenMonitoringEnabled) {\n                        const participantScreenMonitorings = ko.unwrap(\n                            participant.screenMonitorings\n                        );\n              