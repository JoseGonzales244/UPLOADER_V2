              Array.isArray(\n                                        participantScreenMonitorings\n                                    ) &&\n                                    participantScreenMonitorings.some(function (\n                                        sm\n                                    ) {\n                                        if (!sm) return false;\n                                        const targetUser = ko.unwrap(\n                                            sm.targetUser\n                                        );\n                                        const smTargetUserId = targetUser\n                                            ? ko.unwrap(targetUser.id)\n                                            : null;\n                                        const state = ko.unwrap(sm.state);\n                                        return (\n                                            smTargetUserId === targetUserId &&\n                                            state &&\n                                            state.toLowerCase() === \"connected\"\n                                        );\n                                    });\n\n                                // Create a new supervisor object to avoid reference sharing\n                                const screenMonitorSupervisor = {\n                                    participantView: supervisor.participantView,\n                                    isActive: isScreenMonitorActive,\n                                    isScreenMonitor: true,\n                                    // Preserve other supervisor properties if they exist\n                                    isMonitor: supervisor.isMonitor || false,\n                                    isCoach: supervisor.isCoach || false,\n                                };\n                                agentToSupervisors = addMonitorsAndCoachToMap(\n                                    agentToSupervisors,\n                                