 self.conversationDetailsView.internalParticipantViews,\n                conversationId\n            );\n        }\n    };\n\n    self.deactivateCreateCalibrationView = function () {\n        self.sidepanel.removeView(\"newCalibration\");\n    };\n\n    const addCalibrationTab = function (calibrationId) {\n        if (qualityAuthorization.canViewCalibration()) {\n            if (!self.tabbedDetails.containsTab(calibrationId)) {\n                const tabContentViews = {};\n                const calibrationTabId = `${PLAYBACK_NAV_TAB_IDS.calibration}-${calibrationId}`;\n                tabContentViews[calibrationId] = {\n                    view: CalibrationResultsView,\n                    template: \"templates/calibrationResults\",\n                    arguments: [calibrationId, deleteCalibrationCallback],\n                    persist: true,\n                    tabId: calibrationTabId,\n                };\n                const tabMenuItems = getTabMenuItems(\n                    PlaybackContext.ADMIN,\n                    self.conversationId(),\n                    \"calibrations/\" + calibrationId,\n                    \"calibration\",\n                    calibrationTabId,\n                    TAB_PLACEMENTS.calibration\n                );\n                self.tabbedDetails.addTabViews(tabMenuItems, tabContentViews);\n            }\n        }\n    };\n\n    const prepCalibrationTab = function (calibrationId) {\n        if (\n            self\n                .calibrations()\n                .entities.find(\n                    (calibration) => calibration.id === calibrationId\n                ) !== undefined\n        ) {\n            stopTabDefaultBehavior();\n            addCalibrationTab(calibrationId);\n            self.tabbedDetails.setActiveTabView(\n                calibrationId,\n                calibrationId,\n                deleteCalibrationCallback\n            );\n        } else {\n            toasts.notifyMajorAlert(undefined, {\n                bodyMessageKey:\n                    \"calibrationResults.getCalibrationRequest.error.default\",\n            });\n            LOG.info(\"Calibration not found:\", calibrationId);\n            navHelper.navigateTo(\n                navHelper.asHostHash(\n                    `#/admin/${self.conversationId()}/details`\n                ),\n                undefined,\n                false\n            );\n        }\n    };\n\n    self.activateCalibrationTab = function (calibrationId) {\n        if (\n            self.calibrations &&\n            self.calibrations() &&\n            self.calibrations().entities\n        ) {\n            prepCalibrationTab(calibrationId);\n        } else {\n            self.subscribe(self.calibrations, function () {\n                prepCalibrationTab(calibrationId);\n            });\n        }\n    };\n\n    const addQualitySummaryTab = function () {\n        if (\n            qualityAuthorization.canAddEvaluation() ||\n            qualityAuthorization.canDeleteEvaluation() ||\n            qualityAuthorization.canAddCalibration() ||\n            qualityAuthorization.canViewSurvey()\n        ) {\n            if (!self.tabbedDetails.containsTab(\"qualitySummaryView\")) {\n                const tabContentViews = {\n                    qualitySummaryView: {\n                        view: QualitySummaryView,\n                        template: \"templates/qualitySummary\",\n                        arguments: [\n                            self.conversationId,\n                            self.hasParticipantToEvaluate,\n                            self.deleteEvaluation,\n                        ],\n                        persist: true,\n                        tabId: PLAYBACK_NAV_TAB_IDS.qualitySummary,\n                    },\n                };\n                const tabMenuItems = getTabMenuItems(\n                    PlaybackContext.ADMIN,\n                    self.conversationId(),\n                    \"qualitySummary\",\n                    \"qualitySummary\",\n                    PLAYBACK_NAV_TAB_IDS.qualitySummary,\n                    TAB_PLACEMENTS.qualitySummary\n                );\n                self.tabbedDetails.addTabViews(tabMenuItems, tabContentViews);\n            }\n        }\n    };\n\n    self.activateQualitySummaryTab = function () {\n        stopTabDefaultBehavior();\n        addQualitySummaryTab();\n        activateTabIfNeeded(\"qualitySummaryView\");\n    };\n\n    /* Customer Journey Tab */\n\n    self.activeCustomerJourneySessionId = ko.observable(null);\n\n    const addCustomerJourneyTab = function (journeyContexts) {\n        const hasJourneys = journeyContexts && !_.isEmpty(journeyContexts);\n        const journeyTabExists = self.tabbedDetails.containsTab(\"journeys\");\n        const context = hashContext || PlaybackContext.AGENT;\n\n        if (\n            !hasJourneys ||\n            journeyTabExists ||\n            !self.canViewConversationCustomerJourney\n        ) {\n            return;\n        }\n\n        const tabContentViews = {};\n        tabContentViews.journeys = {\n            view: CustomerJourneyView,\n            arguments: [journeyContexts, self.activeCustomerJourneySessionId],\n            template: \"templates/customerJourney\",\n            persist: true,\n            tabId: PLAYBACK_NAV_TAB_IDS.journeys,\n        };\n        const tabMenuItems = getTabMenuItems(\n            context,\n            self.conversationId(),\n            \"journeys\",\n            \"journeys\",\n            PLAYBACK_NAV_TAB_IDS.journeys,\n            TAB_PLACEMENTS.journeys\n        );\n        self.tabbedDetails.addTabViews(tabMenuItems, tabContentViews);\n    };\n\n    self.activateCustomerJourneyTab = function (sessionId) {\n        stopTabDefaultBehavior();\n        self.activeCustomerJourneySessionId(sessionId);\n        return new Bluebird(function (resolve) {\n            const conversationDetailsV6 = self.conversationDetailsV6();\n            if (conversationDetailsV6) {\n                // if we already have a conversation, use that\n                resolve(conversationDetailsV6);\n            } else {\n                // if called from the route handler, the conversation may not yet be available.\n                // setting up a self-disposing subscription handles this case\n                const convSubs = self.subscribe(\n                    self.conversationDetailsV6,\n                    function (nextConversation) {\n                        if (nextConversation) {\n                            convSubs.dispose();\n                            resolve(nextConversation);\n                        }\n                    }\n                );\n            }\n        }).then(function (conversationDetailsV6) {\n            const conversationJourneyContexts = pickContextData(\n                conversationDetailsV6\n            );\n            addCustomerJourneyTab(conversationJourneyContexts);\n            activateTabIfNeeded(\"journeys\");\n        });\n    };\n\n    /* End Customer Journey Tab */\n\n    /* GIA Transcript Tab */\n\n    const transcriptTabId = \"transcript\";\n\n    /**\n     * memoized function that conditionally adds the GIA transcript tab.\n     * conditions:\n     *  * user has recording:recording:view permission\n     *  * the feature toggle is enabled\n     *  OR\n     *  * user has recording:recordingSegment:view permission\n     *  * the feature toggle is enabled\n     *\n     * @returns {Bluebird<boolean>}\n     */\n    const addTranscriptTab = _.memoize(function () {\n        if (\n            !qualityAuthorization.hasViewRecordingPermission() &&\n            !qualityAuthorization.hasViewRecordingSegmentPermission()\n        ) {\n            LOG.info(\n                \"recording:view AND recordingSegment:view permission missing.  Not adding transcript tab.\",\n                {\n                    hasViewRecordingPermission:\n                        qualityAuthorization.hasViewRecordingPermission(),\n                    hasViewRecordingSegmentPermission:\n                        qualityAuthorization.hasViewRecordingSegmentPermission(),\n                }\n            );\n        } else {\n            const tabContentViews = {\n                [transcriptTabId]: {\n                    view: GIATranscriptView,\n                    template: \"templates/giaTranscript\",\n                    arguments: [\n                        self.computed(() => {\n                            let conversationDetails =\n                                self.conversationDetailsV6();\n                            // TODO: Once Tartarus is deprecated, determine if conversationDetails should\n                            // be left as null instead of populating conversationId\n                            if (conversationDetails === null) {\n                                conversationDetails = {\n                                    conversationId: self.conversationId(),\n                                };\n                            }\n                            return conversationDetails;\n                        }),\n                        self.isTranscriptLoading,\n                        self.recordingManagerView.httpErrorStatus,\n                        self.computed(() =>\n                            self.activeRecordingView()?.recording?.()\n                        ),\n                        self.recordingManagerView.conversationRecordings,\n                        self.isActiveInteraction,\n                        self.computed(() => {\n                            const activeRecordingView =\n                                self.activeRecordingView();\n                            if (\n                                activeRecordingView &&\n                                activeRecordingView.isRecordingAvailable\n                            ) {\n                                return activeRecordingView.isRecordingAvailable();\n                            }\n                            return undefined;\n                        }),\n                    ],\n                    classNames: {\n                        \"extend-details-tab-view\": !self.isFlareThemeEnabled,\n                        \"extend-panel-content-view\": self.isFlareThemeEnabled,\n                    },\n                    persistDOM: true,\n                    tabId: PLAYBACK_NAV_TAB_IDS.transcript,\n                },\n            };\n            const tabMenuItems = getTabMenuItems(\n                hashContext || PlaybackContext.ADMIN,\n                self.conversationId(),\n                \"transcript\",\n                \"transcript\",\n                PLAYBACK_NAV_TAB_IDS.transcript,\n                TAB_PLACEMENTS.transcript\n            );\n            self.tabbedDetails.addTabViews(tabMenuItems, tabContentViews);\n        }\n        return;\n    });\n\n    /* End GIA Transcript Tab */\n\n    /**\n     * Choose default to transcript or details tab according to response from transcript-ui.\n     */\n    self.chooseDefaultTab = function (event) {\n        if (!event) {\n            return;\n        }\n\n        const payload = event.data;\n        if (payload.key == \"hasAvailableTranscript\") {\n            // Remove event listener to avoid repeat messages\n            window.removeEventListener(\"message\", self.chooseDefaultTab);\n\n            // Set default behavior if redirect is needed without reloading the app\n            // Save the conversation ID to avoid redirecting when switching interactions\n            hasAvailableTranscript = {\n                conversationId: self.conversationId(),\n                enableDefault: payload.transfer,\n            };\n            if (self.tabRedirect()) {\n                self.navigateDefaultTab();\n            }\n        }\n    };\n\n    /**\n     * Redirects to the details tab if the recording does not have a transcript.\n     * Otherwise, formally navigate to the transcript tab\n     */\n    self.navigateDefaultTab = function () {\n        if (\n            hasAvailableTranscript &&\n            self.conversationId() === hasAvailableTranscript.conversationId &&\n            hasAvailableTranscript.enableDefault\n        ) {\n            // set tab view to transcript\n            if (\n                self.tabbedDetails.containsTab(transcriptTabId) &&\n                self.tabbedDetails.currentViewData().viewKey !== transcriptTabId\n            ) {\n                self.tabbedDetails.setActiveTabView(transcriptTabId);\n            }\n\n            // force the active nav item to transcript\n            activateLastNavItemForEndpoint(\n                self.conversationId(),\n                \"transcript\",\n                \"transcript\",\n                PLAYBACK_NAV_TAB_IDS.transcript,\n                TAB_PLACEMENTS.transcript,\n                self.tabbedDetails.navMenu\n            );\n            return;\n        }\n        self.activateConversationDetailsTab();\n    };\n\n    /**\n     * Defaults the base conversation route to the GIA transcript tab.\n     * Sets the event listener that will choose a path based a transcript-ui response.\n     * Navigates accordingly if event listener has already responded.\n     */\n    self.activateDefaultTab = function () {\n        if (\n            qualityAuthorization.hasViewRecordingPermission() ||\n            qualityAuthorization.hasViewRecordingSegmentPermission()\n        ) {\n            if (typeof hasAvailableTranscript !== \"undefined\") {\n                // If hasAvailableTranscript has already been set, then navigate accordingly\n                self.navigateDefaultTab();\n                return Bluebird.resolve();\n            }\n\n            // Listen while Transcript-UI checks for available transcript\n            self.tabRedirect(true);\n            window.removeEventListener(\"message\", self.chooseDefaultTab);\n            window.addEventListener(\"message\", self.chooseDefaultTab);\n\n            // Activate transcript tab while waiting for a response from Transcript-UI\n            return self.activateTranscriptTab();\n        }\n\n        hasAvailableTranscript = false;\n        self.navigateDefaultTab();\n        return Bluebird.resolve();\n    };\n\n    /**\n     * activate the GIA transcript tab. redirects to the details tab\n     * if the tab is both not present and fails to be added to the view.\n     */\n    self.activateTranscriptTab = function () {\n        const context =\n            hashContext === PlaybackContext.ADMIN\n                ? PlaybackContext.ADMIN\n                : PlaybackContext.AGENT;\n        const navigateDetailsUrl = navHelper.buildInteractionHash(\n            context,\n            self.conversationId(),\n            \"details\"\n        );\n        if (\n            !qualityAuthorization.hasViewRecordingPermission() &&\n            !qualityAuthorization.hasViewRecordingSegmentPermission()\n        ) {\n            toasts.notifyMessage(undefined, {\n                bodyMessageKey: \"config.error.forbidden\",\n            });\n            return navHelper.navigateTo(navigateDetailsUrl);\n        }\n        if (self.tabbedDetails.containsTab(transcriptTabId)) {\n            return Bluebird.resolve(\n                self.tabbedDetails.setActiveTabView(transcriptTabId)\n            );\n        }\n        return addTranscriptTab()\n            .then(() => {\n                self.tabbedDetails.setActiveTabView(transcriptTabId);\n            })\n            .catch(() => {\n                LOG.info(\"Failed to add transcript tab.  Redirecting...\", {\n                    from: window.location.hash,\n                    to: navigateDetailsUrl,\n                });\n                return navHelper.navigateTo(navigateDetailsUrl);\n            });\n    };\n\n    self.handleEvaluationNotification = function (evaluationNotification) {\n        if (\n            evaluationNotification.eventType ===\n            EvaluationSubmittedEventType.AI_SCORED\n        ) {\n            const evaluationId = evaluationNotification.id;\n            if (self.sidepanel.containsView(evaluationId)) {\n                if (self.sidepanel.isActiveView(evaluationId)) {\n                    // When we receive an AI_SCORED event for the evaluation that has an active side panel,\n                    // we will send a message to the child quality forms iFrame\n                    // so that it can fetch latest AI Scoring answer data\n                    const qfWindow = self.sidepanel.currentViewData().view;\n                    const notificationData = {\n                        evaluationNotificationEventType:\n                            evaluationNotification.eventType,\n                    };\n                    qfWindow.postMessageToIFrame(notificationData);\n                } else {\n                    // When we get the AI_SCORED type event for the hidden evaluation\n                    // we will refresh the side panel component.\n                    const isAdminContext =\n                        hashContext === PlaybackContext.ADMIN;\n                    self.removeSidePanelEvaluation(evaluationId);\n                    self.addSidePanelEvaluation(\n                        self.conversationId(),\n                        evaluationId,\n                        isAdminContext\n                    );\n                }\n            }\n        }\n        if (\n            evaluationNotification.eventType ===\n            EvaluationSubmittedEventType.DELETED\n        ) {\n            self.sidepanel.removeViews(true);\n            const currentEvaluationId = self.evaluationId();\n            if (\n                evaluationNotification.id &&\n                currentEvaluationId &&\n                evaluationNotification.id !== currentEvaluationId\n            ) {\n                self.activateSidePanelEvaluation(currentEvaluationId);\n            }\n        }\n        if (\n            evaluationNotification.eventType ===\n 