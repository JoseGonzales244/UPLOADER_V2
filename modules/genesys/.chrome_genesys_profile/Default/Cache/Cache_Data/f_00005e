ate\n                                ).toDate();\n                                const createdDate = response.createdDate\n                                    ? moment(response.createdDate)\n                                    : null;\n                                const formName = response.evaluationForm.name;\n                                const evaluationHref = navHelper.asHostUrl(\n                                    navHelper.buildInteractionHash(\n                                        \"admin\",\n                                        conversationId,\n                                        `qualitySummary/?evaluationId=${response.id}`\n                                    )\n                                );\n                                const newRow = buildRow(\n                                    response,\n                                    conversationId,\n                                    formName,\n                                    evaluationStatus,\n                                    evaluationAssignedDate,\n                                    createdDate,\n                                    evaluatorName,\n                                    assigneeName,\n                                    evaluationHref\n                                );\n                                if (newRow) {\n                                    const currentRows = self\n                                        .evaluationSummaryGrid()\n                                        .rows();\n                                    currentRows.unshift(newRow);\n                                    self.evaluationSummaryGrid().loading(true);\n                                    // Update the grid with the new rows\n                                    self.evaluationSummaryGrid().rows(\n                                        currentRows\n                                    );\n                                    self.evaluationSummaryGrid().loading(false);\n                                }\n                            }\n                        }\n                    }\n                })\n                .catch(function (error) {\n                    // Only delete if this request is still the current one in the Map\n                    // to prevent stale callbacks from removing newer requests\n                    if (pendingEvaluationRequests.get(evalId) === request) {\n                        pendingEvaluationRequests.delete(evalId);\n                    }\n\n                    // Log actual errors for debugging\n                    // Note: With Bluebird cancellation:true, cancelled promises are\n                    // silently dropped and never reach this handler\n                    loggingService.error(\n                        \"Failed to get assigned evaluation for notification:\",\n                        {\n                            conversationId: conversationId(),\n                            evaluationId: evalId,\n                            eventType: evaluationNotification.eventType,\n                            error: error,\n                        }\n                    );\n                });\n        }\n    };\n\n    const getEvaluationFormType = function (evaluation) {\n        return evaluation?.evaluationForm?.evaluationFormType === \"Automated\"\n            ? \"evaluationSummary.evaluationFormType.automated\"\n            : \"evaluationSummary.evaluationFormType.manual\";\n    };\n\n    const getStatusString = function (status) {\n        let evaluationStatus;\n        // We have to call toUpperCase because status may be from a\n        // query or notification, and they use different casing\n        switch (status.toUpperCase()) {\n            case EvaluationStatus.PENDING:\n                evaluationStatus = \"pending\";\n                break;\n            case EvaluationStatus.INPROGRESS:\n                evaluationStatus = \"inProgress\";\n                break;\n            case EvaluationStatus.FINISHED:\n                evaluationStatus = \"completed\";\n                break;\n            case EvaluationStatus.INREVIEW:\n                evaluationStatus = \"inReview\";\n                break;\n            case EvaluationStatus.RETRACTED:\n                evaluationStatus = \"retracted\";\n                break;\n            default:\n                evaluationStatus = \"finished\";\n        }\n        return `evaluationSummary.${evaluationStatus}`;\n    };\n\n    const buildRow = function (\n        evaluation,\n        conversationId,\n        formName,\n        evaluationStatus,\n        evaluationAssignedDate,\n        evaluationCreatedDate,\n        displayName,\n        assigneeName,\n        evaluationHref,\n        isFormDeleted\n    ) {\n        let handleRowClick;\n        if (isFormDeleted) {\n            handleRowClick = function () {\n                toasts.notifyMajorAlert(\n                    ko.i18n.renderString(\n                        \"evaluationSummary.formNotFound.cannotExpand\"\n                    )\n                );\n            };\n        } else {\n            handleRowClick = function (bindingContext, event) {\n                event.preventDefault();\n                const currentParams = getDecodedQueryParamsFromWindow();\n                const newQueryParams = {\n                    ...getDecodedQueryParamsFromUri(evaluationHref),\n                    [\"assignmentPanel\"]: false,\n                };\n                if (currentParams?.qualityFormVersion) {\n                    newQueryParams[\"qualityFormVersion\"] =\n                        currentParams.qualityFormVersion;\n                }\n                const path = setQueryParams(evaluationHref, newQueryParams);\n                navHelper.navigateTo(path, undefined, false);\n            };\n        }\n        const newRow = {\n            conversationId: conversationId,\n            evaluationId: evaluation.id,\n            formName:\n                formName |