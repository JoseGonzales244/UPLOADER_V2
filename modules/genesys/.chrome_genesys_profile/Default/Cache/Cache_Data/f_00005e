         return response;\n            });\n    },\n\n    getDownloadRecording: function (\n        conversationId,\n        recordingId,\n        downloadFormatId,\n        formatId,\n        fileName\n    ) {\n        const parameters = {\n            download: \"true\",\n            fileName: _.isEmpty(fileName) ? recordingId : fileName,\n            locale: localeService.getAppLocale(),\n        };\n\n        if (downloadFormatId === \"emailFormatId\") {\n            parameters[downloadFormatId] = _.isEmpty(formatId)\n                ? \"eml\"\n                : formatId;\n        } else if (\n            downloadFormatId === \"chatFormatId\" ||\n            downloadFormatId === \"messageFormatId\"\n        ) {\n            parameters[downloadFormatId] = _.isEmpty(formatId)\n                ? \"zip\"\n                : formatId;\n        } else {\n            parameters[downloadFormatId] = _.isEmpty(formatId)\n                ? \"wav\"\n                : formatId;\n        }\n\n        return apiCore.v2.get(\n            \"/conversations/\" + conversationId + \"/recordings/\" + recordingId,\n            parameters\n        );\n    },\n\n    updateRecording: function (recording, options) {\n        return apiCore.v2\n            .put(\n                \"/conversations/\" +\n                    recording.conversationId +\n                    \"/recordings/\" +\n                    (recording.id ? recording.id : recording.recordingId),\n                recording,\n                options\n            )\n            .then(function (response) {\n                return new Recording(response);\n            });\n    },\n\n    createAnnotation: function (recording, annotationText, position) {\n        return apiCore.v2\n            .post(\n                \"/conversations/\" +\n                    recording.conversationId +\n                    \"/recordings/\" +\n                    recording.id +\n                    \"/annotations\",\n                {\n             