ew,\n        ko.computed(() => {\n            return {\n                ...voicemailMetadata(),\n                media: \"voicemail\",\n            };\n        }),\n        {\n            afterRender: self.audioRendered,\n            header: ko.observable(self.audioPlayerView.header),\n        }\n    );\n    // --> end of RecordingView vars\n\n    self.isAcdVoicemail = true;\n    self.isWorking = ko.observable(false);\n    self.showDeleteConfirmation = ko.observable(false);\n\n    /**\n     * Event Handlers for confirming voice mail deletion using gux-modal.\n     */\n    self.deleteVoiceMailModalId = `delete-${voicemailId}`;\n\n    self.showDeleteVoicemailModal = function () {\n        const modal = document.getElementById(self.deleteVoiceMailModalId);\n        if (modal) {\n            modal.showModal();\n        }\n    };\n\n    self.closeDeleteVoicemailModal = function () {\n        const modal = document.getElementById(self.deleteVoiceMailModalId);\n        if (modal) {\n            return modal.close();\n        }\n        return Promise.resolve();\n    };\n\n    self.deleteVoicemail = async function () {\n        await self.closeDeleteVoicemailModal();\n        self.isWorking(true);\n        self.showDeleteConfirmation(false);\n        return voicemailService\n            .deleteVoicemail(voicemailId)\n            .then(function () {\n                self.voicemail(null);\n                self.hasAudio(false);\n                self.isDeleted(true);\n            })\n            .catch(\n                errorCallbackFactory.createCallback({\n                    namespace: \"playback.acdVoicemailDelete\",\n                })\n            )\n            .finally(function () {\n                self.isWorking(false);\n            });\n    };\n    self.keep = function () {\n        if (isPure7570Enabled && !self.canKeepIndefinitely()) {\n            return;\n        }\n        self.isWorking(true);\n        const policy = { voicemailRetentionPolicyType: \"RETAIN_IND