es, function (entity) {\n                    return entity.id == callId;\n                });\n                const {\n                    monitoredParticipantId,\n                    coachedParticipantId,\n                    bargedParticipantId,\n                    mediaRoles,\n                } = _.find(entity.participants, function (participant) {\n                    return (\n                        participant.purpose === \"user\" &&\n                        call.participantForCurrentUser().userId() ==\n                            participant.user.id &&\n                        !participant.endTime\n                    );\n                });\n\n                //Uisng waitingFor we know which supervisoer requested to Monitor / Coach / Barge and\n                //we will retry until we get monitor/coach/bagrge participant ids available in api\n\n                if (\n                    (waitingFor == CALL_TYPES.MONITOR &&\n                        monitoredParticipantId) ||\n                    (waitingFor == CALL_TYPES.COACH && coachedParticipantId) ||\n                    (waitingFor == CALL_TYPES.BARGE && bargedParticipantId) ||\n                    waitingFor == \"\"\n                ) {\n                    call.participantForCurrentUser().monitoredParticipantId(\n                        monitoredParticipantId\n                    );\n                    call.participantForCurrentUser().coachedParticipantId(\n                        coachedParticipantId\n                    );\n                    call.participantForCurrentUser().bargedParticipantId(\n                        bargedParticipantId\n                    );\n                    call.participantForCurrentUser().isSupervisorBarged(\n                        mediaRoles && mediaRoles.includes(\"barge\")\n                    );\n                    resolvePromise(call);\n                    return;\n                }\n                return true;\n            },\n            function (error) {\n                rejectPromise(error);\n                errorCallbackFactory.createCallback({\n                    namespace: \"conversationDetails.call.error\",\n                })(error);\n            },\n            { maxRetries: MAX_RETRIES, startIntervalMs: 1000 }\n        )();\n    }\n\n    const pollingObj = {\n        timeout: null,\n        xhrRequest: null,\n    };\n\n    const subscription = callService.activeCalls.subscribe(function () {\n        const call = _.find(activeCalls(), { id: callId });\n\n        if (call) {\n            resolvePromise(call);\n\n            if (pollingObj.timeout) {\n                clearTimeout(pollingObj.timeout);\n            }\n\n            if (pollingObj.xhrRequest) {\n                pollingObj.xhrRequest.cancel();\n            }\n\n            subscription.dispose();\n        }\n    });\n\n    let tries = 0;\n    let callIsDisconnected = false;\n\n    const getCallTimeout = function () {\n        pollingObj.xhrRequest = callService.getCall(callId, {\n            shouldReturnRawData: true,\n        });\n\n        pollingObj.xhrRequest\n            .then(function (callData) {\n                if (_.has(callData, \"participants\")) {\n                    if (subscription) {\n                        // get rid of the subscription on success becuase we\n                        // just got the latest data from the backend.\n                        subscription.dispose();\n                    }\n\n                    let call = new Call(callData);\n                    // only add in the call if it is active.\n                    if (!call.isDisconnected()) {\n                        call = fillToActiveCalls(callData);\n                    }\n                    callIsDisconnected = call.isDisconnected();\n                    resolvePromise(call);\n                }\n            })\n            .catch(Promise.CancellationError, _.noop)\n            .finally(function () {\n                const call = _.find(activeCalls(), { id: