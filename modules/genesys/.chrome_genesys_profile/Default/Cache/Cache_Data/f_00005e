d;\n    pauseReason: string | undefined;\n}\n\ninterface PhraseClickMessage {\n    offsetWords: number;\n    topicPhrase: string;\n    startTimeMs: number;\n}\n\ninterface PauseAnnotation {\n    id?: string;\n    name?: string;\n    type?: string;\n    durationMs?: number;\n    absoluteLocation?: number;\n    location?: number;\n    absoluteDurationMs?: number;\n    recordingLocation?: number;\n    recordingDurationMs?: number;\n    user?: Models.User;\n    description?: string;\n    selfUri?: string;\n    reason?: string;\n}\n\nexport enum ToastNotificationTypeEnum {\n    MESSAGE = \"MESSAGE\",\n    MINOR_ALERT = \"MINOR_ALERT\",\n    MAJOR_ALERT = \"MAJOR_ALERT\",\n    CRITICAL_ALERT = \"CRITICAL_ALERT\",\n}\n\nexport default class GIATranscriptView extends ViewModel {\n    private queryParams = getDecodedQueryParamsFromWindow();\n    public transcriptUiURL: ko.Computed<string>;\n    public isLoading: ko.Observable<boolean>;\n    public fetchRecordingsErrorStatus: ko.Observable<number>;\n    public conversationRecordings: ko.ObservableArray<Models.Recording>;\n    public transcriptAriaLabel = ko.i18n.renderString(\n        \"playback.nav.transcript\"\n    );\n\n    private childIFrameElement: HTMLIFrameElement | undefined;\n    private conversationDetailsV6: ko.Computed<Models.AnalyticsConversation>;\n    private mediaType: ko.Computed<string | undefined>;\n    private recording: ko.Computed<Models.Recording>;\n    private isActiveInteraction: ko.Computed<boolean>;\n    private hasRecordingViewContent: ko.Computed<boolean | undefined>;\n    private transcriptUIReady = ko.observable(false);\n    private boundMessageHandler = (event: MessageEvent) => {\n        this.handleTranscriptUIReady(this, event);\n        this.handleMessageEvent(event);\n    };\n\n    constructor(\n        conversationDetailsV6: ko.Computed<Models.AnalyticsConversation>,\n        isTranscriptLoading: ko.Observable<boolean>,\n        fetchRecordingsErrorStatus: ko.Observable<number>,\n        recording: ko.Computed<Models.Recording>,\n        conversationRecordings: ko.ObservableArray<Models.Recording>,\n        isActiveInteraction?: ko.Computed<boolean>,\n        hasRecordingViewContent?: ko.Computed<boolean | undefined>\n    ) {\n        super();\n        this.conversationDetailsV6 = conversationDetailsV6;\n        this.isLoading = isTranscriptLoading;\n        this.fetchRecordingsErrorStatus = fetchRecordingsErrorStatus;\n        this.recording = recording;\n        this.conversationRecordings = conversationRecordings;\n        this.isActiveInteraction =\n            isActiveInteraction ?? ko.pureComputed(() => false);\n        this.hasRecordingViewContent =\n            hasRecordingViewContent ??\n            ko.pureComputed((): boolean | undefined => undefined);\n\n        // Compute mediaType from recording.\n        // Returns \"unavailable\" when:\n        //   - isActiveInteraction is true (live interaction), OR\n        //   - hasRecordingViewContent is defined and false (activeRecordingView exists but has no playable content) e.g. 404 case.\n        // Returns undefined when hasRecordingViewContent is undefined (no activeRecordingView yet)\n        // Returns the actual media type when recording is available.\n        this.mediaType = ko.pureComputed(() => {\n            const recording = this.recording();\n            if (recording?.media) {\n                return ko.unwrap(recording.media);\n            }\n            const hasContent = this.hasRecordingViewContent();\n            if (\n                this.isActiveInteraction() ||\n                (hasContent !== undefined && !hasContent)\n            ) {\n                return \"unavailable\";\n            }\n            return undefined;\n        });\n\n        // Computed URL that switches between transcript-ui and transcript-ui-v2\n        // based on feature toggle and media type\n        this.transcriptUiURL = this.computed(() => {\n            const isEmailTranscriptV2Enabled = featureToggleService.isEnabled(\n                FeatureToggle.EMAIL_TRANSCRIPT_UI_V2\n            );\n            const currentMediaType = this.mediaType();\n            const isEmailInteraction = currentMediaType === \"email\";\n\n            const baseConfig =\n                isEmailTranscriptV2Enabled && isEmailInteraction\n                    ? config.giaTranscriptV2\n                    : config.giaTranscript;\n\n            // Apply version override from query params if provided\n            return this.queryParams.giaTranscriptVersion\n                ? baseConfig.uri + \"/\" + this.queryParams.giaTranscriptVersion\n                : baseConfig.uri;\n        });\n\n        window.addEventListener(\"message\", this.boundMessageHandler);\n        this.transcriptUIReady.subscribe(\n            this.handleTranscriptUIReadyChanged.bind(this)\n        );\n    }\n\n    onDispose() {\n        window.removeEventListener(\"message\", this.boundMessageHandler);\n    }\n\n    private handleTranscriptUIReadyChanged() {\n        if (this.transcriptUIReady()) {\n            this.publishTranscriptUIData();\n            this.transcriptUIReady(false);\n        }\n    }\n\n    private publishActiveCommunication(\n        mediaType: string | undefined,\n        recording: Models.Recording | undefined\n    ) {\n        if (mediaType !== \"email\") {\n            if (!recording) {\n                // live recording and message will not have recording\n                if (mediaType) {\n                    this.publish({\n                        topic: \"activeCommunication\",\n                        data: {\n                            mediaType: mediaType,\n                            activeCommunicationId: undefined,\n                            pauses: [],\n                            recordingId: undefined,\n                            recordingStartTime: undefined,\n                            recordingEndTime: undefined,\n                        },\n                    });\n                }\n                // wait until media type and recording are available before publishing\n                return;\n            }\n            const startTimeIso = recording.startTime\n                ? new Date(recording.startTime)\n                : undefined;\n            const endTimeIso = recording.endTime\n                ? new Date(recording.endTime)\n                : undefined;\n            const activeCommunicationId =\n                this.getActiveCommunicationId(recording);\n\n            const pauseData: Pause[] = [];\n            _.each(\n                recording.annotations,\n                function (annotation: PauseAnnotation) {\n                    if (annotation.type === \"Pause\") {\n                        pauseData.push({\n                            location: annotation.recordingLocation,\n                            absoluteDurationMs: annotation.absoluteDurationMs,\n                            pauseReason: annotation.reason,\n                        });\n                    }\n                }\n            );\n\n            const data: ActiveCommunication = {\n                mediaType: mediaType,\n                activeCommunicationId: activeCommunicationId,\n                pauses: pauseData,\n                recordingId: recording.id,\n                recordingStartTime: startTimeIso\n                    ? startTimeIso.getTime()\n                    : undefined,\n                recordingEndTime: endTimeIso ? endTimeIso.getTime() : undefined,\n            };\n\n            this.publish({\n                topic: \"activeCommunication\",\n                data: data,\n            });\n\n            if (mediaType === \"message\" || mediaType === \"chat\") {\n                this.publish({\n                    topic: \"recordingDetails\",\n                    data: JSON.parse(JSON.stringify(recording)),\n                });\n            }\n        }\n\n        if (mediaType === \"email\") {\n            /*\n             * Cloning the object before publishing it as recording object contains functions\n             * and objects with functions cannot be cloned using the structured clone algorithm\n             * which is used by window.postMessage()\n             */\n            const conversationRecordingsForEmail =\n                this.conversationRecordings().filter(\n                    (conversation) =>\n                        conversation.media &&\n                        conversation.media.toLocaleLowerCase() === \"email\"\n                );\n            this.publish({\n                topic: \"conversationRecordings\",\n                data: JSON.parse(\n                    JSON.stringify(conversationRecordingsForEmail)\n                ),\n            });\n        }\n    }\n\n    private getActiveCommunicationId(recording: Models.Recording) {\n        if (\n            recording.recordingFileRole ===\n                recordingFileRoleCustomerExperience &&\n            this.checkParticipantPurposeAgent(recording)\n        ) {\n            return undefined;\n        } else {\n            return ko.unwrap(recording.sessionId);\n        }\n    }\n\n    private checkParticipantPurposeAgent(recording: Models.Recording) {\n        let isAgent = false;\n        if (\n            this.conversationDetailsV6 &&\n            this.conversationDetailsV6().participants\n        ) {\n            _.each(\n                this.conversationDetailsV6().participants,\n                function (participant) {\n                    if (\n                        participant.purpose &&\n                        participant.purpose.toLowerCase() === \"agent\"\n                    ) {\n                        _.each(participant.sessions, function (session) {\n                            if (\n                                !isAgent &&\n                                session.sessionId === recording.sessionId\n                            ) {\n                                isAgent = true;\n                            }\n                        });\n                    }\n                }\n            );\n        }\n        return isAgent;\n    }\n\n    private publishJumpToPhrase(phraseId: number | AnnotationClickEvent) {\n        this.publish({\n            topic: \"jumpToPhrase\",\n            data: phraseId,\n        });\n    }\n\n    private publishUpdatePosition(annotationClickEvent: PlayerSynchEvent) {\n        this.publish({\n            topic: \"playerSynchronization\",\n            data: annotationClickEvent,\n        });\n    }\n\n    private publishJumpToEmailPhrase(message: PhraseClickMessage) {\n        this.publish({\n            topic: \"jumpToEmailTopicPhrase\",\n            data: message,\n        });\n    }\n\n    private publish(data: HostToChildPublication) {\n        if (!this.childIFrameElement) {\n            loggingService.error(\"Could not find iframe element to publish to\");\n            return;\n        }\n        const { contentWindow } = this.childIFrameElement;\n        if (!contentWindow) {\n            loggingService.error(\"Failed to get child frame contentWindow\");\n            return;\n        }\n        contentWindow.postMessage(data, this.transcriptUiURL());\n    }\n\n    private publishTranscriptUIData() {\n        this.publish({\n            topic: \"fetchRecordingsError\",\n            data: this.fetchRecordingsErrorStatus(),\n        });\n        const environmentalData: {\n            [key: string]: string | undefined;\n        } = {};\n\n        environmentalData.locale = localeService.getAppLocale();\n\n        if (ko.i18n.getTimezone()) {\n            environmentalData.timezone = ko.i18n.getTimezone();\n        }\n\n        this.publish({\n            topic: \"environmentalData\",\n            data: {\n                ...environmentalData,\n            },\n        });\n\n        this.publish({\n            topic: \"conversationDetails\",\n            data: this.conversationDetailsV6(),\n        });\n\n        // Used for user switch back to transcript tab, after switching to a different tab.\n        if (this.mediaType()) {\n            this.publishActiveCommunication(this.mediaType(), this.recording());\n        }\n    }\n\n    private handleTranscriptUIReady(\n        self: GIATranscriptView,\n        event: MessageEvent\n    ) {\n        if (!event) {\n            return;\n        }\n        const payload = event.data;\n        if (payload.key == \"transcriptUIReady\") {\n            self.transcriptUIReady(true);\n        }\n    }\n\n    private handleMessageEvent(event: any) {\n        if (!event) {\n            return;\n        }\n        const payload = event.data;\n        if (payload.key && payload.key === \"jumpToLocation\") {\n            const recording = this.recording();\n            if (!recording) {\n                return;\n            }\n            event.preventDefault();\n            qualityBroadcast.publish(\n                recording.id,\n                \"transcriptUIJumpToLocation\",\n                payload\n            );\n        }\n        if (payload.key && payload.key === \"transcriptUIPlayControlRequest\") {\n            const recording = this.recording();\n            if (!recording) {\n                return;\n            }\n            qualityBroadcast.publish(\n                recording.id,\n                \"transcriptUIPlayControlRequest\",\n                payload.transfer\n            );\n        }\n        if (payload.key && payload.key === \"evaluationViewPhraseSelect\") {\n            if (payload.emailPhrase) {\n                this.publishJumpToEmailPhrase(payload.emailPhrase);\n            } else {\n                const { topicNumber, phraseId, location } =\n                    speechAndTextAnalyticsService\n                        .sentimentsList()\n                        .find((sentiment) => {\n                            return (\n                                sentiment.topicNumber === payload.topicNumber\n                            );\n                        });\n                if (\n                    topicNumber !== undefined &&\n                    phraseId !== undefined &&\n                    location !== undefined\n                ) {\n                    const recording = this.recording();\n                    if (!recording) {\n                        return;\n                    }\n                    this.publishJumpToPhrase({\n                        topicNumber,\n                        phraseId,\n                    });\n                    qualityBroadcast.publish(\n                        recording.id,\n                        \"transcriptUIJumpToLocation\",\n                        {\n                            transfer: location,\n                        }\n                    );\n                }\n            }\n        }\n        if (payload.key && payload.key === \"toastNotification\") {\n            event.preventDefault();\n            switch (payload.transfer.type) {\n                case ToastNotificationTypeEnum.MESSAGE:\n                    toastService.notifyMessage(\n                        payload.transfer.title,\n                        {\n                            bodyMessageKey: payload.transfer.bodyMessageKey,\n                            messageData: payload.transfer.messageData,\n                        },\n                        payload.transfer.useLongDelay\n                    );\n                    break;\n                case ToastNotificationTypeEnum.MINOR_ALERT:\n                    toastService.notifyMinorAlert(payload.transfer.title, {\n                        bodyMessageKey: payload.transfer.bodyMessageKey,\n                        messageData: payload.transfer.messageData,\n                    });\n                    break;\n                case ToastNotificationTypeEnum.MAJOR_ALERT:\n                    toastService.notifyMajorAlert(payload.transfer.title, {\n                        bodyMessageKey: payload.transfer.bodyMessageKey,\n                        messageData: payload.transfer.messageData,\n                    });\n                    break;\n                case ToastNotificationTypeEnum.CRITICAL_ALERT:\n                    toastService.notifyCriticalAlert(payload.transfer.title, {\n                        bodyMessageKey: payload.transfer.bodyMessageKey,\n                        messageData: payload.transfer.messageData,\n                    });\n                    break;\n                default:\n                    loggingService.error(\n                        \"Toast notification type was not provided by transcript UI\"\n                    );\n            }\n        }\n    }\n\n    onFrameLoaded(self: GIATranscriptView, event: Event) {\n        this.childIFrameElement = event.target as HTMLIFrameElement;\n\n        // Fallback to publish anyway if not given a response from Transcript UI\n        setTimeout(this.publishTranscriptUIData.bind(this), 1000);\n\n        const syncWithTranscriptUI = () => {\n            const mediaType = this.mediaType();\n            const recording = this.recording();\n            if (mediaType || recording) {\n                this.publishActiveCommunication(mediaType, recording);\n\n                if (recording && recording.id) {\n                    qualityBroadcast.subscribe(\n                        recording.id,\n                        \"transcriptUIAnnotationClick\",\n                        (message: number) => this.publishJumpToPhrase(message)\n                    );\n                    qualityBroadcast.subscribe(\n                        recording.id,\n                        \"transcriptUIPositionUpdate\",\n                        (message: PlayerSynchEvent) =>\n                            this.publishUpdatePosition(message)\n                    );\n                }\n                this.isLoading(false);\n            }\n        };\n\n        this.subscribe(this.recording, syncWithTranscriptUI);\n        this.subscribe(this.isActiveInteraction, syncWithTranscriptUI);\n        syncWithTranscriptUI();\n    }\n}\n","export enum PlaybackContext {\n    ADMIN = \"admin\",\n    AGENT = \"agent\",\n}\n","export enum HttpStatusCode {\n    NOT_FOUND = 404,\n}\n","import ko from \"knockout\";\nimport { filter } from \"lodash\";\nimport ViewModel from \"viewModels/ViewModelTyped\";\nimport SwitchedView from \"viewModels/SwitchedView\";\nimport announceTextToScreenreader from \"util/screenReaderUtil\";\n\nexport type ViewData = {\n    view: typeof ViewModel;\n    arguments?: any[];\n    template: string;\n    persist: boolean;\n    showHeader: boolean;\n    viewTitle: string;\n    onClose?: () => void;\n};\n\ntype ViewMapEntry = ViewData & { viewKey: string };\nconst SIDE_PANEL_FOCUS_TIMEOUT = 100;\n\nexport default class SidePanelView extends ViewModel {\n    private switchedView = this.subView(SwitchedView);\n    private switchedViewsMap = ko\n        .observable({})\n        .extend({ deferred: true }) as ko.Observable<{\n        [index: string]: ViewMapEntry;\n    }>;\n\n    private readonly SIDE_PANEL_REGION_FALLBACK_ARIA_LABEL =\n        ko.i18n.renderString(\"sidepanel.region.ariaLabel\");\n\n    public currentViewData = this.computed(() => {\n        const viewKey = this.switchedView.getActiveView() as string;\n        const activeView = this.switchedViewsMap()[viewKey];\n        const isPersistDOM = activeView && activeView.persist;\n        const view = isPersistDOM\n            ? activeView.view\n            : ko.unwrap(this.switchedView[viewKey]);\n\n        if (!view) {\n            return null;\n        }\n\n        return {\n            view: view,\n            viewTitle: activeView.viewTitle,\n            showHeader:\n                activeView.showHeader == null ? true : activeView.showHeader,\n            viewKey: viewKey,\n            onClose: activeView.onClose,\n            template: activeView.template,\n            persist: !!isPersistDOM,\n        } as ViewMapEntry;\n    });\n\n    public sidePanelAriaLabel = this.computed(() => {\n        const title = this.currentViewData()?.viewTitle?.trim();\n        return title || this.SIDE_PANEL_REGION_FALLBACK_ARIA_LABEL;\n    });\n\n    public persistedViews: ko.Computed<ViewMapEntry[]> = this.computed(() => {\n        return filter(this.switchedViewsMap(), \"persist\");\n    });\n\n    close(): void {\n        const currentData = this.currentViewData();\n        const { onClose, viewTitle } = currentData || {};\n        this.switchedView.setActiveView();\n        if (onClose) {\n            onClose();\n        }\n\n        if (currentData && viewTitle) {\n            announceTextToScreenreader({\n                name: \"sidepanel.screenreader.closed\",\n                data: { title: viewTitle },\n            });\n        }\n\n        // Return focus to the previously focused element when sidepanel closes\n        setTimeout(() => {\n            if (this.previouslyFocusedElement) {\n                (this.previouslyFocusedElement as HTMLElement).focus();\n            }\n        }, SIDE_PANEL_FOCUS_TIMEOUT);\n    }\n\n    containsView(viewKey: string): boolean {\n        return this.switchedViewsMap()[viewKey] !== undefined;\n    }\n\n    addView(viewKey: string, viewData: ViewData): void {\n        if (this.containsView(viewKey)) {\n            return;\n        }\n\n        const newSubViewsMap = this.switchedViewsMap();\n\n        newSubViewsMap[viewKey] = { viewKey, ...viewData };\n\n        const args = [\n            viewKey,\n            viewData.persist ? undefined : viewData.view,\n            ...(viewData.arguments || []),\n        ];\n\n        if (viewData.persist) {\n            newSubViewsMap[viewKey].view = this.subView(\n                viewData.view,\n                ...(viewData.arguments || [])\n            );\n        }\n\n        if (viewData.persist) {\n            this.switchedView.addPersistentView(...args);\n        } else {\n            this.switchedView.addView(...args);\n        }\n\n        this.switchedViewsMap(newSubViewsMap);\n    }\n\n    removeView(viewKey: string): void {\n        if (viewKey === this.switchedView.getActiveView()) {\n            this.close();\n        }\n        this.switchedView.disposeView(viewKey);\n        const newSubViewsMap = this.switchedViewsMap();\n        delete newSubViewsMap[viewKey];\n        this.switchedViewsMap(newSubViewsMap);\n    }\n\n    removeViews(removeActiveView: boolean): void {\n        for (const viewKey in this.switchedViewsMap()) {\n            if (\n                removeActiveView ||\n                viewKey !== this.switchedView.getActiveView()\n            )\n                this.removeView(viewKey);\n        }\n    }\n\n    // Track the element that had focus before opening sidepanel\n    private previouslyFocusedElement: Element | null = null;\n\n    setActiveView(viewKey: string, ...args: any[]): void {\n        const currentViewData = this.currentViewData();\n        if (!currentViewData || this.switchedView.getActiveView() !== viewKey) {\n            // Store the currently focused element before opening sidepanel\n            this.previouslyFocusedElement = document.activeElement;\n\n            this.switchedView.setActiveView(viewKey, ...args);\n\n            const newViewData = this.switchedViewsMap()[viewKey];\n            if (newViewData && newViewData.viewTitle) {\n                announceTextToScreenreader({\n                    name: \"sidepanel.screenreader.opened\",\n                    data: { title: newViewData.viewTitle },\n                });\n            }\n\n            // Focus management: Move focus to the sidepanel when it opens\n            setTimeout(() => {\n                const sidepanel = document.getElementById(\"side-panel\");\n                if (sidepanel) {\n                    sidepanel.focus();\n                }\n            }, SIDE_PANEL_FOCUS_TIMEOUT);\n        }\n    }\n\n    isActiveView(viewKey: string): boolean {\n        return this.switchedView.getActiveView() === viewKey;\n    }\n}\n","export interface TabVisibilityHandlerOptions {\n    onVisible: () => void;\n    onHidden?: () => void;\n    debounceMs?: number;\n    shouldExecute?: () => boolean;\n    visibilityDocument?: Document;\n}\n\nexport function getVisibilityDocument(): Document {\n    try {\n        if (window.top && window.top !== window && window.top.document) {\n            return window.top.document;\n        }\n    } catch (e) {\n        // Cross-origin iframe\n    }\n    return document;\n}\n\n/**\n * Creates a handler that executes a callback when tab becomes visible.\n * Returns a cleanup function to remove listeners and clear timers.\n *\n * @param options.onVisible - Callback to execute when tab becomes visible\n * @param options.onHidden - Optional callback to execute immediately when tab becomes hidden\n * @param options.debounceMs - Debounce time in ms (default: 0)\n * @param options.shouldExecute - Optional function to check if callback should execute (default: () => true)\n * @param options.visibilityDocument - Optional custom document to monitor (default: top-level or current document)\n */\nexport function createTabVisibilityHandler(\n    options: TabVisibilityHandlerOptions\n): () => void {\n    const {\n        onVisible,\n        onHidden,\n        debounceMs = 0,\n        shouldExecute = () => true,\n        visibilityDocument = getVisibilityDocument(),\n    } = options;\n\n    let debounceTimeout: ReturnType<typeof setTimeout> | null = null;\n    let isDisposed = false;\n\n    const handleVisibilityChange = () => {\n        const isNowVisible = !visibilityDocument.hidden;\n\n        if (debounceTimeout) {\n            clearTimeout(debounceTimeout);\n            debounceTimeout = null;\n        }\n\n        if (!isNowVisible) {\n            // Execute onHidden callback immediately when tab becomes hidden\n            if (onHidden && !isDisposed && shouldExecute()) {\n                onHidden();\n            }\n            return;\n        }\n\n        const executeCallback = () => {\n            if (isDisposed || visibilityDocument.hidden || !shouldExecute()) {\n                return;\n            }\n\n            onVisible();\n            debounceTimeout = null;\n        };\n\n        if (debounceMs > 0) {\n            debounceTimeout = setTimeout(executeCallback, debounceMs);\n        } else {\n            executeCallback();\n        }\n    };\n\n    visibilityDocument.addEventListener(\n        \"visibilitychange\",\n        handleVisibilityChange\n    );\n\n    return () => {\n        isDisposed = true;\n\n        if (debounceTimeout) {\n            clearTimeout(debounceTimeout);\n            debounceTimeout = null;\n        }\n\n        visibilityDocument.removeEventListener(\n            \"visibilitychange\",\n            handleVisibilityChange\n        );\n    };\n}\n\nexport function isTabVisible(visibilityDocument?: Document): boolean {\n    const doc = visibilityDocument || getVisibilityDocument();\n    return !doc.hidden;\n}\n","import ko from \"knockout\";\nimport _ from \"lodash\";\nimport moment from \"moment\";\nimport Bluebird from \"bluebird\";\nimport authService from \"services/authService\";\nimport notificationService from \"services/notificationService\";\nimport LOG from \"services/loggingService\";\nimport navHelper from \"services/navHelper\";\nimport toasts from \"services/toastService\";\nimport qualityManagementService from \"services/qualityManagementService\";\nimport userService from \"services/userService\";\nimport qualityAuthorization from \"services/qualityAuth\";\nimport apiCore from \"services/apiCore\";\nimport featureToggleService, {\n    FeatureToggle,\n} from \"services/featureToggleService\";\nimport errorCallbackFactory from \"util/errorCallbackFactory\";\nimport screenMonitoringUtils from \"util/screenMonitoringUtils\";\nimport EmbeddedQualityFormEditor from \"viewModels/EmbeddedQualityFormEditor\";\nimport ConversationDetailsView fro