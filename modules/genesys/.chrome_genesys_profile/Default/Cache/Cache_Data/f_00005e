ow, map, uniqBy } from \"lodash/fp\";\nimport moment from \"moment\";\nimport $ from \"jquery\";\nimport Promise from \"bluebird\";\nimport config from \"config\";\nimport authService from \"services/authService\";\nimport apiCore from \"services/apiCore\";\nimport ExponentialIntervalGenerator from \"util/ExponentialIntervalGenerator\";\nimport pubSub from \"util/PubSub\";\nimport LOG from \"services/loggingService\";\n\nconst NOTIFICATION_URI = \"/notifications/channels\";\nconst HB_TIMER_EXPIRATION = 35000;\nlet hbTimer;\n\nlet connection;\nconst defaults = {\n    useWebSocket: true,\n    maxReconnectInterval: 5 * 1000, //5 seconds\n    nsRoot: config,\n    reconnectTimeout: 30 * 60 * 1000, //30 minutes\n};\n\nconst options = $.extend({}, defaults, config.notifications || {});\n\nconst exponentialBackoff = new ExponentialIntervalGenerator(\n    options.maxReconnectInterval\n);\nlet reconnectTimeoutObj = null;\nlet isConnectionSetupSettled = false;\nconst randomId = ko.observable();\nlet lastConnectionTime = moment.now();\nlet connectUri;\n\n/**\n * Connect to a notification stream via websockets.\n * @param {object} params parameters required for connection\n * @return {WebSocket} The newly created websocket object\n */\nconst connect = function () {\n    if (connectUri) {\n        connection = new WebSocket(connectUri);\n\n        connection.onopen = function () {\n            resetHeartbeatExpirationTimer();\n\n            LOG.debug(\"WS: open\");\n            notificationService.connected(true);\n\n            // we've created a connection, so lets reset the interval if we lose it\n            // again in the future\n            exponentialBackoff.reset();\n\n            if (reconnectTimeoutObj) {\n                // remove the timeout callback if we connect before the timeout has been\n                // executed\n                clearTimeout(reconnectTimeoutObj);\n            }\n\n            lastConnectionTime = moment.now();\n        };\n\n        connectio