     const currentPage = self.gridOptions().pageNumber || 1;\n        const pageSize = self.gridOptions().pageSize || 25;\n        const totalBeforeDelete =\n            self.gridOptions().total || rowCountBeforeDelete;\n\n        // selectedRows will return a single object when one row is selected\n        // it will return an array when multiple rows are selected.\n        _.each(selectedRows, function (row) {\n            deletedRows.push(\n                deleteEvaluationCallback(row.conversationId, row.evaluationId)\n            );\n        });\n\n        Promise.allSettled(deletedRows).then(function (promiseResults) {\n            let failedResults = 0;\n            //Check for a single error on row delete\n            _.each(promiseResults, function (deletedRowPromise) {\n                if (deletedRowPromise.isRejected()) {\n                    failedResults++;\n                    loggingService.error(\"Failed to delete evaluation\", {\n                        settledValue: deletedRowPromise._settledValue,\n                    });\n                } else {\n                    const deletedEvaluation = deletedRowPromise._settledValue();\n                    if (deletedEvaluation && deletedEvaluation.id) {\n                        const deletedEvaluationId = deletedEvaluation.id;\n                        const remainingSelectedRows = self\n                            .evaluationSummaryGrid()\n                            .selectedRows()\n                            .filter((row) => {\n                                return row.evaluationId !== deletedEvaluationId;\n                            });\n\n                        self.evaluationSummaryGrid().selectedRows(\n                            remainingSelectedRows\n                        );\n                    }\n                }\n            });\n\n            if (\n                failedResults !== promiseResults.length &&\n                failedResults !== 0\n            ) {\n                toastService.notifyCriticalAlert(\n                    \"evaluationSummary.error.delete\",\n                    {\n                        bodyMessage: \"evaluationSummary.error.delete.body\",\n                        messageData: failedResults,\n                    }\n                );\n            } else if (failedResults === promiseResults.length) {\n                toastService.notifyCriticalAlert(\n                    \"evaluationSummary.error.delete.all\"\n                );\n            }\n\n            // After bulk delete, refresh the grid when at least one delete succeeded and:\n            // 1. Current page will be empty but evaluations still exist on other pages\n            //    → navigate to the closest valid page and re-fetch\n            // 2. Current page will have fewer rows than pageSize and it's NOT the last page\n            //    → items from later pages should backfill the current page\n            //\n            // No refresh needed when:\n            // - All deletes failed (nothing changed on the server)\n            // - Total reaches 0 (everything deleted, empty grid is correct)\n            // - Single page with partial delete (rows already removed locally)\n            // - Last page with partial delete and no next page to backfill from\n            //\n            // Note: We use the pre-delete snapshot values (captured before any\n            // delete calls or notification handlers fired) so that concurrent\n            // websocket DELETED notifications cannot corrupt the calculations.\n            const successfulDeletes = promiseResults.length - failedResults;\n            if (successfulDeletes > 0) {\n                const expectedRemainingOnPage = Math.max(\n                    0,\n                    rowCountBeforeDelete - successfulDeletes\n                );\n                const expectedTotal = Math.max(\n                    0,\n                    totalBeforeDelete - successfulDeletes\n                );\n                const pageWillBeEmpty =\n                    expectedRemainingOnPage === 0 && expectedTotal > 0;\n                const hasNextPage = currentPage < pageCountBeforeDelete;\n                const needsBackfill =\n                    expectedRemainingOnPage > 0 &&\n                    expectedRemainingOnPage < pageSize &&\n                    hasNextPage;\n\n                if (pageWillBeEmpty || needsBackfill) {\n                    const newPageCount = Math.max(\n                        1,\n                        Math.ceil(expectedTotal / pageSize)\n                    );\n                    const newPage = Math.min(currentPage, newPageCount);\n                    self.gridOptions({\n                        ...self.gridOptions(),\n                        pageNumber: newPage,\n                    });\n                    self.evaluationSummaryGrid().loading(true);\n                    const refreshOptions = { ...self.gridOptions() };\n                    delete refreshOptions.total;\n                    delete refreshOptions.pageCount;\n                    self.refreshEvaluationSummaryGrid(refreshOptions).finally(\n                        function () {\n                            self.isDeleteEvaluationInProgress(false);\n                        }\n                    );\n                    return;\n                }\n            }\n\n            self.isDeleteEvaluationInProgress(false);\n        });\n    };\n\n    self.refreshEvaluationSummaryGrid = function (incomingOptions) {\n        return qualityManagementService\n            .getConversationEvaluations(conversationId(), incomingOptions)\n            .then(function (response) {\n                const params = [\"pageNumber\", \"pageCount\", \"pageSize\", \"total\"];\n                const newOptions = _.assign(\n                    {},\n                    _.pick(response, params),\n                    incomingOptions\n                );\n                self.gridOptions(newOptions);\n                self.listEntities(response.entities);\n                return null;\n            })\n            .catch(\n                errorCallbackFactory.createCallback({\n                    namespace: \"playback.evaluationSummaryRequest\",\n                })\n            )\n            .finally(function () {\n                self.evaluationSummaryGrid().loading(false);\n            });\n    };\n\n    self.gridOptions = ko.observable({\n        pageNumber: 1,\n    });\n\n    // Add the appropriate information to the dataTable\n    self.evaluationSummaryGrid({\n        columns: EVALUATION_SUMMARY_COLUMNS,\n        rows: ko.observableArray([]),\n        selectedRows: ko.observableArray([]),\n        loading: ko.observable(true),\n        onDataOptionsChange: self.refreshEvaluationSummaryGrid,\n        dataOptions: self.gridOptions,\n    });\n\n    self.handlePageChange = function (_data, event) {\n        self.evaluationSummaryGrid().loading(true);\n        self.gridOptions({\n            ...self.gridOptions(),\n            pageNumber: event.detail.currentPage,\n            pageSize: event.detail.itemsPerPage,\n        });\n        const dataOptions = ko.unwrap(self.gridOptions());\n        self.evaluationSummaryGrid().dataOptions(dataOptions);\n        delete dataOptions.total;\n        self.refreshEvaluationSummaryGrid(dataOptions);\n    };\n\n    self.handleRowSelection = function (_data, event) {\n        const selectedRows = [];\n        if (event.detail.selectedRowIds.length > 0) {\n            for (let i = 0; i < event.detail.selectedRowIds.length; i++) {\n                const rowId = parseInt(\n                    _.replace(event.detail.selectedRowIds[i], \"form-row-\", \"\")\n                );\n                if (self.evaluationSummaryGrid().rows()[rowId]) {\n                    selectedRows.push(\n                        self.evaluationSummaryGrid().rows()[rowId]\n                    );\n                }\n            }\n        }\n        self.evaluationSummaryGrid().selectedRows(selectedRows);\n    };\n\n    // Look for row selection to handle evaluation deletion\n    self.canDeleteRows = self.computed(function () {\n        return (\n            qualityAuthorization.canDeleteEvaluation() &&\n            !_.isEmpty(self.evaluationSummaryGrid().selectedRows())\n        );\n    });\n\n    notificationService\n        .subscribe(topic, self.handleEvaluationNotification)\n        .finally(function () {\n            self.refreshEvaluationSummaryGrid(self.gridOptions());\n        });\n\n    self.onDispose = function () {\n        // Cancel any in-flight evaluation API requests\n        pendingEvaluationRequests.forEach(function (promise) {\n            if (promise && typeof promise.cancel === \"function\") {\n                promise.cancel();\n            }\n        });\n        pendingEvaluationRequests.clear();\n        notificationService.batchUnsubscribe(topic);\n    };\n});\n\nexport default EvaluationSummaryView;\n","import ko from \"knockout\";\nimport _ from \"lodash\";\nimport qualityManagementService from \"services/qualityManagementService\";\nimport ViewModel from \"viewModels/ViewModel\";\nimport errorCallbackFactory from \"util/errorCallbackFactory\";\nimport navHelper from \"services/navHelper\";\nimport SurveyErrorReason from \"enums/SurveyErrorReason\";\n\n//this function is only here because Math.round() by itself sometimes does not produce correct results\n//i.e if you put in Math.round(1.005 * 100) / 100, you would 1.00, instead of 1.01\nconst roundUpDecimals = function (num) {\n    return +(Math.round(num + \"e+2\") + \"e-2\");\n};\n\nconst SurveySummaryView = ViewModel.extend(function (conversationId) {\n    const self = this;\n\n    let SURVEY_SUMMARY_COLUMNS;\n\n    SURVEY_SUMMARY_COLUMNS = [\n        {\n            label: \"surveySummary.formNameTitle\",\n            id: \"formName\",\n        },\n        {\n            label: \"surveySummary.statusTitle\",\n            id: \"status\",\n        },\n        {\n            label: \"surveySummary.surveyTypeTitle\",\n            id: \"surveyType\",\n        },\n        {\n            label: \"surveySummary.scoreTitle\",\n            id: \"score\",\n        },\n        {\n            label: \"surveySummary.npsScore\",\n            id: \"npsScore\",\n        },\n    ];\n\n    self.surveySummaryGrid = ko.observableArray();\n\n    const getStatusString = function (status) {\n        let surveyStatus;\n        if (status.toLowerCase() === \"pending\") {\n            surveyStatus = \"surveySummary.pending\";\n        } else if (status.toLowerCase() === \"sent\") {\n            surveyStatus = \"surveySummary.sent\";\n        } else if (status.toLowerCase() === \"inprogress\") {\n            surveyStatus = \"surveySummary.inProgress\";\n        } else if (status.toLowerCase() === \"expired\") {\n            surveyStatus = \"surveySummary.expired\";\n        } else if (status.toLowerCase() === \"finished\") {\n            surveyStatus = \"surveySummary.finished\";\n        } else if (status.toLowerCase() === \"optout\") {\n            surveyStatus = \"surveySummary.optOut\";\n        } else {\n            surveyStatus = \"surveySummary.error\";\n        }\n        return surveyStatus;\n    };\n\n    const getErrorInfo = function (surveyErrorDetails) {\n        const reason = surveyErrorDetails.surveyErrorReason.toLowerCase();\n        let messageKey;\n        let lastActionId;\n        if (reason === SurveyErrorReason.BOUNCE) {\n            messageKey = \"surveySummaryView.bounced\";\n            lastActionId = surveyErrorDetails.flowDiagnosticInfo.lastActionId;\n        } else if (reason === SurveyErrorReason.COMPLAINT) {\n            messageKey = \"surveySummaryView.complaint\";\n            lastActionId = surveyErrorDetails.flowDiagnosticInfo.lastActionId;\n        } else if (reason === SurveyErrorReason.INTERNAL_PARTICIPANT) {\n            messageKey = \"surveySummaryView.internalParticipants\";\n        } else if (reason === SurveyError