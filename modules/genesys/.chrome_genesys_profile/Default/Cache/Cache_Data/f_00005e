 null {\n    // Unwrap in case screenMonitorings is a knockout observableArray\n    const unwrappedScreenMonitorings = ko.unwrap(screenMonitorings);\n    if (\n        !unwrappedScreenMonitorings ||\n        !Array.isArray(unwrappedScreenMonitorings) ||\n        unwrappedScreenMonitorings.length === 0\n    ) {\n        return null;\n    }\n    return (\n        unwrappedScreenMonitorings.find(function (item: any) {\n            if (!item) {\n                return false;\n            }\n            // Unwrap observable - screenMonitorings items are ObservableModel instances\n            // where properties like state are knockout observables\n            const state = ko.unwrap(item.state);\n            return (\n                state === \"connected\" ||\n                (typeof state === \"string\" &&\n                    state.toLowerCase() === \"connected\")\n            );\n        }) || null\n    );\n};\n\n/**\n * Helper function to get targetUser.id from screenMonitorings array where state is connected\n * @param {ObservableArray|Array} screenMonitorings - The screenMonitorings array from a participant object\n * @return {String|null} targetUser.id from connected screen monitoring, or null\n */\nconst getConnectedTargetUserId = function (\n    screenMonitorings: any\n): string | null {\n    const activeScreenMonitoringSession =\n        getConnectedScreenMonitoring(screenMonitorings);\n    if (!activeScreenMonitoringSession) {\n        return null;\n    }\n    // Unwrap observables - targetUser and its id may be knockout observables\n    const targetUser = ko.unwrap(activeScreenMonitoringSession.targetUser);\n    if (!targetUser) {\n        return null;\n    }\n    return ko.unwrap(targetUser.id) ?? null;\n};\n\n/**\n * Helper function to get all unique targetUser.id values from screenMonitorings array (regardless of state)\n * @param {ObservableArray|Array} screenMonitorings - The screenMonitorings array from a participant object\n * @return {Array} Array of