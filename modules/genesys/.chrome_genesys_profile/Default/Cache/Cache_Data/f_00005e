            // else if policy is KEEP_INDEFINITELY, calculatedDeleteDate = null\n        }\n        return calculatedDeleteDate;\n    });\n\n    self.formattedDeleteDate = self.computed(() =>\n        self.deleteDate()\n            ? ko.i18n.formatDate(\n                  self.deleteDate(),\n                  null,\n                  null,\n                  LONG_DATE_OPTIONS\n              )\n            : null\n    );\n\n    // Keep Indefinitely: visible when deleteDate exists.\n    // When PURE-7570 FT is on, additionally requires canDelete permission.\n    // When FT is off, only deleteDate is checked (existing behavior).\n    self.canKeepIndefinitely = self.computed(function () {\n        return self.deleteDate() && (!isPure7570Enabled || self.canDelete);\n    });\n\n    _.assign(self, audioOptions);\n\n    // Get voicemail metadata\n    voicemailService\n        .getVoicemail(voicemailId)\n        .then(function (voicemailResponse) {\n            voicemailMetadata(voicemailResponse);\n        })\n        .catch(handleError);\n\n    // Only fetch media if user has stream permission\n    if (self.canStream) {\n        getVoicemailMedia(voicemailId, { formatId: \"mp3\" })\n            .then(function (voicemail) {\n                self.voicemail(voicemail);\n            })\n            .catch(function (error) {\n                if (isPure7570Enabled) {\n                    // Skip recordingRequestError when voicemail is already marked deleted\n                    // (404 handled by handleError via isDeleted) to avoid showing both\n                    // \"No Voicemail Recording\" and \"There is no recording\" simultaneously.\n                    if (!self.isDeleted()) {\n                        self.recordingRequestError(true);\n                    }\n                } else {\n                    errorCallbackFactory.createCallback({\n                        namespace: \"playback.acdVoicemailRequest\",\n                    })(error);\n                    self.recordingRequestError(true);\n                }\n                self.httpErrorStatus(error.details?.status);\n            })\n            .finally(function () {\n                self.isRecordingLoading(false);\n            });\n    } else {\n        // No stream permission — skip media fetch, mark loading complete\n        self.isRecordingLoading(false);\n    }\n\n    self.computed(function () {\n        if (self.voicemail()) {\n            self.hasAudio(!!self.voicemail().mediaFileUri);\n            if (isAudioElementRendered()) {\n                const unwrapped = ko.toJS(self.voicemail);\n                self.audioPlayerView.setChannels([\n                    {\n                        audioUri: unwrapped.mediaFileUri,\n                        waveformData: unwrapped.waveformData,\n                        waveformUri: unwrapped.waveUri,\n                    },\n                ]);\n            }\n        }\n    });\n\n    self.pause = function () {\n        if (self.audioPlayerView.isPlaying()) {\n            self.audioPlayerView.pause();\n        }\n    };\n\n    self.play = function () {\n        if (self.audioPlayerView.isPlaying()) {\n            self.audioPlayerView.play();\n        }\n    };\n});\n\nexport default AcdVoicemailView;\n","import ko from \"knockout\";\nimport _ from \"lodash\";\nimport Promise from \"bluebird\";\nimport moment from \"moment\";\nimport qualityManagementService from \"services/qualityManagementService\";\nimport qualityAuth from \"services/qualityAuth\";\nimport errorCallbackFactory from \"util/errorCallbackFactory\";\nimport ViewModel from \"viewModels/ViewModel\";\nimport qualityBroadcast from \"services/qualityBroadcast\";\nimport BroadcastEnum from \"viewModels/util/BroadCastEnum\";\nimport PlaybackHeaderView from \"viewModels/PlaybackHeaderView\";\nimport RecordingRestoreDetailsView from \"./RecordingRestoreDetailsView\";\nimport FileStateEnum from \"viewModels/util/FileStateEnum\";\nimport featureToggleService, {\n    FeatureT