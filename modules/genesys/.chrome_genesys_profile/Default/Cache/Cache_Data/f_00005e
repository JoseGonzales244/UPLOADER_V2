 self.calibration().evaluationForm().questionGroups(),\n                        (evaluationQuestionGroup) =>\n                            evaluationQuestionGroup.id ===\n                            questionGroupScore.questionGroupId\n                    );\n\n                    _.each(\n                        questionGroupScore.questionScores,\n                        function (questionScore) {\n                            if (\n                                questionScore.markedNA ||\n                                questionGroupScore.markedNA\n                            ) {\n                                scoreRows[questionScore.questionId][\n                                    evaluatorId\n                                ].score = ko.i18n.renderString(\n                                    \"playback.calibrationSummary.score.na\"\n                                );\n                            } else if (questionScore.score !== undefined) {\n                                let scoreValue = questionScore.score;\n\n                                // For multi-select questions, sum up the scores from multipleSelectQuestionOptionScores\n                                if (\n                                    questionScore.hasOwnProperty(\n                                        \"multipleSelectQuestionOptionScores\"\n                                    ) &&\n                                    questionScore\n                                        .multipleSelectQuestionOptionScores\n                                        .length > 0\n                                ) {\n                                    scoreValue = _.sumBy(\n                                        questionScore.multipleSelectQuestionOptionScores,\n                                        \"score\"\n                                    );\n                                }\n\n                                scoreRows[questionScore.questionId][\n                                    evaluatorId\n                                ].score = (\n                                    (scoreValue *\n                                        evaluationQuestionGroup.weight()) /\n                                    100.0\n                                )\n                                    .toFixed(2)\n                                    .replace(/\\.?0+$/, \"\");\n                            }\n                            if (\n                                questionScore.hasOwnProperty(\"comments\") &&\n                                questionScore.comments !== \"\"\n                            ) {\n                                scoreRows[questionScore.questionId][\n                                    evaluatorId\n                                ].comments = questionScore.comments;\n                            }\n                        }\n                    );\n                }\n            );\n        }\n    };\n\n    const buildRows = function (keys, rows) {\n        const calibrationRows = [];\n        _.each(rows, function (row) {\n            const newRow = {};\n            _.each(keys, function (key) {\n                if (row.hasOwnProperty(key)) {\n                    newRow[key] = row[key];\n                    newRow.rowStyle = row.style;\n                    if (row.comments) {\n                        newRow.comments = row.comments;\n                    }\n                } else {\n                    newRow[key] = EMPTYSCORE;\n                }\n            });\n            calibrationRows.push(newRow);\n        });\n        return calibrationRows;\n    };\n\n    const createCellTemplate = function (id, href) {\n        return `\n            <a data-evaluator-id=\"${id}\" href=\"#\" data-bind=\"\n                text: $data['${id}'].score,\n                navigateTo: '${href}'\n            \"></a>\n            <div class=\"calibration-evaluation-comments\" data-bind=\"if: $data['${id}'].comments\">\n                <i class=\"fa fa-comments\" data-bind=\"tooltip:$data['${id}'].comments\"></i>\n            </div>\n        `;\n    };\n\n    const buildCalibrationGridData = function (calibration) {\n        const unwrappedCalibration = ko.toJS(calibration);\n        if (unwrappedCalibration.evaluationForm) {\n            self.evaluationFormName(unwrappedCalibration.evaluationForm.name);\n            self.highScore(unwrappedCalibration.highScore);\n            self.lowScore(unwrappedCalibration.lowScore);\n            self.averageScore(unwrappedCalibration.averageScore);\n            self.variance(self.highScore() - self.lowScore());\n            let evaluatorColumns;\n            let evaluatorsToSort = unwrappedCalibration.evaluators;\n            let expertEvaluator;\n            let columns;\n\n            self.calibrationResultsGrid({\n                columns: ko.observableArray([]),\n                rows: ko.observableArray([]),\n            });\n\n            try {\n                if (unwrappedCalibration.expertEvaluator) {\n                    expertEvaluator = _.find(\n                        unwrappedCalibration.evaluators,\n                        function (evaluator) {\n                            return (\n                                unwrappedCalibration.expertEvaluator.id ===\n                                evaluator.id\n                            );\n                        }\n                    );\n                    evaluatorsToSort = _.reject(\n                        unwrappedCalibration.evaluators,\n                        function (evaluator) {\n                            return (\n                                unwrappedCalibration.expertEvaluator &&\n                                unwrappedCalibration.expertEvaluator.id ===\n                                    evaluator.id\n                            );\n                        }\n                    );\n                }\n\n                /* -- Create the columns for dataTable -- */\n                evaluatorColumns = _.map(\n