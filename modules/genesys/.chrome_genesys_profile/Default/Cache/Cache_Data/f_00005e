ing singular)\n    const needsNormalization = rawData.participants.some(function (\n        participant: any\n    ) {\n        return (\n            participant &&\n            participant.screenMonitoring &&\n            !participant.screenMonitorings\n        );\n    });\n\n    if (!needsNormalization) {\n        return rawData;\n    }\n\n    // Clone to avoid mutating the original\n    const normalized = JSON.parse(JSON.stringify(rawData));\n    normalized.participants = normalized.participants.map(function (\n        participant: any\n    ) {\n        // If participant has flat structure, convert to array structure\n        if (\n            participant &&\n            participant.screenMonitoring &&\n            !participant.screenMonitorings\n        ) {\n            // The id in screenMonitoringItem is the communication ID (screenMonitoringCommunicationId)\n            // The screenMonitoring object contains the screen monitoring session ID\n            const screenMonitoringItem = {\n                id: participant.screenMonitoringCommunicationId,\n                state: participant.state,\n                targetUser: participant.targetUser,\n                screenMonitoring: participant.screenMonitoring,\n                monitoringType: participant.monitoringType,\n                count: participant.count,\n                connectedTime: participant.connectedTime,\n                disconnectedTime: participant.disconnectedTime,\n            };\n\n            // Create array structure\n            participant.screenMonitorings = [screenMonitoringItem];\n        }\n        return participant;\n    });\n\n    return normalized;\n};\n\nexport default {\n    getConnectedScreenMonitoring: getConnectedScreenMonitoring,\n    getConnectedTargetUserId: getConnectedTargetUserId,\n    getAllUniqueTargetUserIds: getAllUniqueTargetUserIds,\n    normalizeScreenMonitoringData: normalizeScreenMonitoringData,\n};\n","export default {\n    evaluation: \"evaluation\",\n    sur