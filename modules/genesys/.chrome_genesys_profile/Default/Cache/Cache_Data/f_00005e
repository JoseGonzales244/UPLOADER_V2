es();\n            },\n\n            /**\n             * gets the users and if necessary, expands userIds\n             * @returns {Promise}\n             */\n            getUsers() {\n                return Promise.all(\n                    flow(\n                        filter(function (participant) {\n                            const isWEM437Enabled =\n                                featureToggleService.isEnabled(\n                                    FeatureToggle.WEM_437_SCREEN_MONITORING\n                                );\n                            /*\n                            In Message Conversation, Participant is said to be consultant if:\n                            the participant has atleast one internal message and no regular messages\n                            But if there are both messages and internal message then:\n                            either it will be agent who initiated consult or agent transfered call to consultant\n                            */\n                            const isMessageConsultant =\n                                participant.internalMessages?.length > 0 &&\n                                !participant.messages?.length > 0;\n\n                            const isScreenMonitoringSupervisor =\n                                isWEM437Enabled &&\n                                participant.screenMonitorings != null &&\n                                Array.isArray(participant.screenMonitorings) &&\n                                participant.screenMonitorings.length > 0;\n\n                            return (\n                                participant.purpose &&\n                                (participant.purpose.toLowerCase() === \"user\" ||\n                                    participant.purpose.toLowerCase() ===\n                                        \"agent\") &&\n                                !participant.monitoredParticipantId &&\n                                !participant.coachedParticipantId &