 true : false;\n    let authorizations = [].concat(permissions);\n\n    if (divisionIds && divisionIds.length > 0) {\n        authorizations = authorizations.concat(\n            _.flatMap(permissions, function (permission) {\n                return _.map(divisionIds, function (divisionId) {\n                    return permission + \":\" + divisionId;\n                });\n            })\n        );\n    }\n    authorizations = authorizations.concat(roles);\n    return authService.hasAuthorization(\n        { any: authorizations },\n        ignoreDivisions\n    );\n}\n\nexport default {\n    /**\n     * Recordings\n     */\n\n    canApplyProtectionStatus(divisionIds) {\n        return checkPermission(\n            [DELETION_PROTECTION_ENTITY + APPLY],\n            [],\n            divisionIds\n        );\n    },\n\n    canRevokeProtectionStatus(divisionIds) {\n        return checkPermission(\n            [DELETION_PROTECTION_ENTITY + REVOKE],\n            [],\n            divisionIds\n        );\n    },\n\n    canViewRecording(divisionIds) {\n        return checkPermission(\n            [RECORDING_ENTITY + VIEW],\n            ADMIN_EVALUATOR_SUPERVISOR_AGENT,\n            divisionIds\n        );\n    },\n\n    canViewRecordingSegment(divisionIds) {\n        return checkPermission(\n            [RECORDING_SEGMENT_ENTITY + VIEW],\n            ADMIN_EVALUATOR_SUPERVISOR_AGENT,\n            divisionIds\n        );\n    },\n\n    canViewSnippetRecording(divisionIds) {\n        return checkPermission(\n            [SNIPPET_RECORDING_ENTITY + VIEW],\n            ADMIN_EVALUATOR_SUPERVISOR_AGENT,\n            divisionIds\n        );\n    },\n\n    hasViewRecordingPermission(divisionIds) {\n        return checkPermission(\n            [RECORDING_ENTITY + VIEW],\n            ADMIN_EVALUATOR_SUPERVISOR,\n            divisionIds\n        );\n    },\n\n    hasViewRecordingSegmentPermission(divisionIds) {\n        return checkPermission(\n            [RECORDING_SEGMENT_ENTITY + VIEW],\n            ADMIN_EVALUATOR_SUPERVISOR,\n            divisionIds\n        );\n    },\n\n    canDownloadRecording(divisionIds) {\n        return checkPermission([RECORDING_ENTITY + DOWNLOAD], [], divisionIds);\n    },\n\n    canViewRecordingAudit(divisionIds) {\n        return checkPermission(\n            [RECORDING_ENTITY + VIEW_AUDIT],\n            ADMIN_EVALUATOR_SUPERVISOR,\n            divisionIds\n        );\n    },\n\n    canRestoreRecording(divisionIds) {\n        return checkPermission(\n            [RECORDING_ENTITY + RESTORE],\n            ADMIN_EVALUATOR_SUPERVISOR_AGENT,\n            divisionIds\n        );\n    },\n\n    canDeleteRecording(divisionIds) {\n        return checkPermission(\n            [RECORDING_ENTITY + DELETE],\n            ADMIN_EVALUATOR_SUPERVISOR,\n            divisionIds\n        );\n    },\n\n    canEditRetention(divisionIds) {\n        return checkPermission(\n            [RECORDING_ENTITY + EDIT_RETENTION],\n            ADMIN_EVALUATOR_SUPERVISOR,\n            divisionIds\n        );\n    },\n\n    canEditSnippetRecordingRetention(divisionIds) {\n        return checkPermission(\n            [SNIPPET_RECORDING_ENTITY + EDIT_RETENTION],\n            ADMIN_EVALUATOR_SUPERVISOR,\n            divisionIds\n        );\n    },\n\n    canDownloadSnippetRecording(divisionIds) {\n        return checkPermission(\n            [SNIPPET_RECORDING_ENTITY + DOWNLOAD],\n            [],\n            divisionIds\n        );\n    },\n\n    canRestoreSnippetRecording(divisionIds) {\n        return checkPermission(\n            [SNIPPET_RECORDING_ENTITY + RESTORE],\n            ADMIN_EVALUATOR_SUPERVISOR_AGENT,\n            divisionIds\n        );\n    },\n\n    /**\n     * Annotations\n     */\n\n    canViewAnnotation(divisionIds) {\n        return checkPermission(\n            [ANNOTATION_ENTITY + VIEW],\n            ADMIN_EVALUATOR_SUPERVISOR_AGENT,\n            divisionIds\n        );\n    },\n\n    canAddAnnotation(divisionIds) {\n        return checkPermission(\n            [ANNOTATION_ENTITY + ADD],\n            ADMIN_EVALUATOR_SUPERVISOR_AGENT,\n            divisionIds\n        );\n    },\n\n    canEditAnnotation(divisionIds) {\n        return checkPermission(\n            [ANNOTATION_ENTITY + EDIT],\n            ADMIN_EVALUATOR_SUPERVISOR,\n            divisionIds\n        );\n    },\n\n    canDeleteAnnotation(divisionIds) {\n        return checkPermission(\n            [ANNOTATION_ENTITY + DELETE],\n            ADMIN_EVALUATOR_SUPERVISOR_AGENT,\n            divisionIds\n        );\n    },\n\n    canViewAnnotationAudit(divisionIds) {\n        return checkPermission(\n            [ANNOTATION_ENTITY + VIEW_AUDIT],\n            ADMIN_EVALUATOR_SUPERVISOR,\n            divisionIds\n        );\n    },\n\n    /**\n     * Encryption Keys\n     */\n\n    canViewEncryptionKey() {\n        return checkPermission(\n            [ENCRYPTION_KEY_ENTITY + VIEW],\n            QUALITY_ADMIN_ROLE\n        );\n    },\n\n    canEditEncryptionKey() {\n        return checkPermission(\n            [ENCRYPTION_KEY_ENTITY + EDIT],\n            QUALITY_ADMIN_ROLE\n        );\n    },\n\n    /**\n     * Evaluations\n     */\n\n    canAddEvaluation(divisionIds) {\n        return checkPermission(\n            [EVALUATION_ENTITY + ADD],\n            [QUALITY_ADMIN_ROLE],\n            divisionIds\n        );\n    },\n\n    canDeleteEvaluation(divisionIds) {\n        return checkPermission(\n            [EVALUATION_ENTITY + DELETE],\n            [QUALITY_ADMIN_ROLE],\n            divisionIds\n        );\n    },\n\n    canViewEvaluation(divisionIds) {\n        return checkPermission(\n            [EVALUATION_ENTITY + VIEW],\n            ADMIN_EVALUATOR_AGENT,\n            divisionIds\n        );\n    },\n\n    canEditEvaluation(divisionIds) {\n        return checkPermission(\n            [EVALUATION_ENTITY + EDIT],\n            [QUALITY_ADMIN_ROLE],\n            divisionIds\n        );\n    },\n\n    canEditScore(divisionIds) {\n        return checkPermission(\n            [EVALUATION_ENTITY + EDIT_SCORE],\n            ADMIN_EVALUATOR,\n            divisionIds\n        );\n    },\n\n    canEditAgentSignoff(divisionIds) {\n        return checkPermission(\n            [EVALUATION_ENTITY + EDIT_AGENT_SIGNOFF],\n            ADMIN_EVALUATOR_AGENT,\n            divisionIds\n        );\n    },\n\n    canViewEvaluationAudit(divisionIds) {\n        return checkPermission(\n            [EVALUATION_ENTITY + VIEW_AUDIT],\n            ADMIN_EVALUATOR,\n            divisionIds\n        );\n    },\n\n    /**\n     * Calibrations\n     */\n    canAddCalibration() {\n        return checkPermission(\n            [CALIBRATION_ENTITY + ADD],\n            [QUALITY_ADMIN_ROLE]\n        );\n    },\n\n    canDeleteCalibration() {\n        return checkPermission(\n            [CALIBRATION_ENTITY + DELETE],\n            [QUALITY_ADMIN_ROLE]\n        );\n    },\n\n    canViewCalibration() {\n        return checkPermission(\n            [CALIBRATION_ENTITY + VIEW],\n            [QUALITY_ADMIN_ROLE]\n        );\n    },\n\n    canEditCalibration() {\n        return checkPermission(\n            [CALIBRATION_ENTITY + EDIT],\n            [QUALITY_ADMIN_ROLE]\n        );\n    },\n\n    canViewCalibrationAudit() {\n        return checkPermission(\n            [CALIBRATION_ENTITY + VIEW_AUDIT],\n            [QUALITY_ADMIN_ROLE]\n        );\n    },\n\n    /**\n     * Audits\n     */\n\n    canViewAudit() {\n        return checkPermission(\n            [AUDIT_INTERACTION_DETAILS_ENTITY + VIEW],\n            ADMIN_EVALUATOR_SUPERVISOR\n        );\n    },\n\n    /**\n     * Retention Policies\n     */\n\n    canAddRetentionPolicy() {\n        return checkPermission(\n            [RETENTION_POLICY_ENTITY + ADD],\n            [QUALITY_ADMIN_ROLE]\n        );\n    },\n\n    canDeleteRetentionPolicy() {\n        return checkPermission(\n            [RETENTION_POLICY_ENTITY + DELETE],\n            [QUALITY_ADMIN_ROLE]\n        );\n    },\n\n    canViewRetentionPolicy() {\n        return checkPermission(\n            [RETENTION_POLICY_ENTITY + VIEW],\n            [QUALITY_ADMIN_ROLE]\n        );\n    },\n\n    canEditRetentionPolicy() {\n        return checkPermission(\n            [RETENTION_POLICY_ENTITY + EDIT],\n            [QUALITY_ADMIN_ROLE]\n        );\n    },\n\n    canViewOrphanRecording() {\n        return checkPermission([ORPHAN_RECORDING_ENTITY + VIEW], []);\n    },\n\n    canDeleteOrphanRecording() {\n        return checkPermission([ORPHAN_RECORDING_ENTITY + DELETE], []);\n    },\n\n    canEditOrphanRecording() {\n        return checkPermission([ORPHAN_RECORDING_ENTITY + EDIT], []);\n    },\n\n    /**\n     * Survey Forms\n     */\n\n    canAddSurveyForm() {\n        return checkPermission([SURVEY_FORM_ENTITY + ADD], []);\n    },\n\n    canDeleteSurveyForm() {\n        return checkPermission([SURVEY_FORM_ENTITY + DELETE], []);\n    },\n\n    canViewSurveyForm() {\n        return checkPermission([SURVEY_FORM_ENTITY + VIEW], []);\n    },\n\n    canEditSurveyForm() {\n        return checkPermission([SURVEY_FORM_ENTITY + EDIT], []);\n    },\n\n    canDisableSurveyForm() {\n        return checkPermission([SURVEY_FORM_ENTITY + DISABLE], []);\n    },\n\n    /**\n     * Surveys\n     */\n\n    canViewSurvey(divisionIds) {\n        return checkPermission([SURVEY_ENTITY + VIEW], [], divisionIds);\n    },\n\n    /**\n     * Evaluation Forms\n     */\n\n    canAddEvaluationForm() {\n        return checkPermission(\n            [EVALUATION_FORM_ENTITY + ADD],\n            [QUALITY_ADMIN_ROLE]\n        );\n    },\n\n    canDeleteEvaluationForm() {\n        return checkPermission(\n            [EVALUATION_FORM_ENTITY + DELETE],\n            [QUALITY_ADMIN_ROLE]\n        );\n    },\n\n    canViewEvaluationForm() {\n        return checkPermission(\n            [EVALUATION_FORM_ENTITY + VIEW],\n            ADMIN_EVALUATOR_AGENT\n        );\n    },\n\n    canEditEvaluationForm() {\n        return checkPermission(\n            [EVALUATION_FORM_ENTITY + EDIT],\n            [QUALITY_ADMIN_ROLE]\n        );\n    },\n\n    /**\n     * Screen Recordings\n     */\n\n    canViewScreenRecording(divisionIds) {\n        return checkPermission(\n            [SCREEN_RECORDING_ENTITY + VIEW],\n            [],\n            divisionIds\n        );\n    },\n\n    canStopScreenRecording(divisionIds) {\n        return checkPermission(\n            [SCREEN_RECORDING_ENTITY + STOP],\n            [],\n            divisionIds\n        );\n    },\n\n    canEditScreenRecordingRetention(divisionIds) {\n        return checkPermission(\n            [SCREEN_RECORDING_ENTITY + EDIT_RETENTION],\n            [],\n            divisionIds\n        );\n    },\n\n    canViewScreenRecordingAudits(divisionIds) {\n        return checkPermission(\n            [SCREEN_RECORDING_ENTITY + VIEW_AUDIT],\n            [],\n            divisionIds\n        );\n    },\n\n    canRestoreScreenRecordings(divisionIds) {\n        return checkPermission(\n            [SCREEN_RECORDING_ENTITY + RESTORE],\n            [],\n            divisionIds\n        );\n    },\n\n    /**\n     * Recording Settings for screen recordings\n     */\n\n    canEditScreenRecordingSettings() {\n        return checkPermission([SETTINGS_ENTITY + EDIT_SCREEN_RECORDINGS], []);\n    },\n\n    /**\n     * Edit WEM-440 regional recording storage settings\n     */\n\n    canEditRegionalRecordingStorageSettings(divisionIds) {\n        return checkPermission(\n            [SETTINGS_ENTITY + EDIT_REGIONAL_STORAGE],\n            [],\n            divisionIds\n        );\n    },\n\n    /**\n     * Call monitor\n     */\n\n    canMonitorCall(divisionIds) {\n        return checkPermission([CALL_ENTITY + MONITOR], [], divisionIds);\n    },\n\n    /**\n     * Call coach\n     */\n\n    canCoachCall(divisionIds) {\n        return checkPermission([CALL_ENTITY + COACH], [], divisionIds);\n    },\n\n    /**\n     * Schedule Coaching\n     */\n    canScheduleCoaching: function (divisionIds) {\n        return checkPermission([APPOINTMENT_ENTITY + ADD], [], divisionIds);\n    },\n\n    /**\n     * Call barge\n     */\n\n    canBargeInCall(divisionIds) {\n        return checkPermission([CALL_ENTITY + BARGE], [], divisionIds);\n    },\n\n    /**\n     * Message Monitoring\n     */\n\n    canMonitorMessaging(divisionIds) {\n        return checkPermission([MESSAGE_ENTITY + MONITOR], [], divisionIds);\n    },\n\n    /**\n     * Live screen monitoring - Agent level\n     */\n    canScreenMonitorAgentLevel(divisionIds) {\n        return checkPermission(\n            [REALTIME_MONITOR_ENTITY + MONITOR_AGENT],\n            [],\n            divisionIds\n        );\n    },\n\n    /**\n     * Live screen monitoring - Conversation level\n     */\n    canScreenMonitorConversationLevel(divisionIds) {\n        return checkPermission(\n            [REALTIME_MONITOR_ENTITY + MONITOR_CONVERSATION],\n            [],\n            divisionIds\n        );\n    },\n\n    /**\n     * Analytics\n     */\n\n    canViewAnalyticsDataretentionSettings() {\n        return checkPermission([DATA_RETENTION_ENTITY + VIEW], []);\n    },\n\n    /**\n     * Relate\n     */\n    canViewRelateContact() {\n        return checkPermission([RELATE_CONTACT_ENTITY + VIEW], []);\n    },\n\n    /**\n     * External Contacts\n     */\n    canViewExternalContactsContact(divisionIds) {\n        return checkPermission(\n            [EXTERNAL_CONTACTS_CONTACT_ENTITY + VIEW],\n            [],\n            divisionIds\n        );\n    },\n\n    /**\n     * Wrap-up Codes\n     */\n    canViewWrapupCode(divisionIds) {\n        return checkPermission([WRAPUP_CODE_ENTITY + VIEW], [], divisionIds);\n    },\n\n    /**\n     * Speech and Text Analytics\n     */\n    canViewSpeechAndTextAnalyticsData() {\n        return checkPermission([STA_DATA_ENTITY + VIEW], []);\n    },\n\n    /**\n     * ACD Voicemail (PURE-7570)\n     */\n    canStreamAcdVoicemail() {\n        return checkPermission([ACD_VOICEMAIL_ENTITY + STREAM], []);\n    },\n\n    canDownloadAcdVoicemail() {\n        return checkPermission([ACD_VOICEMAIL_ENTITY + DOWNLOAD], []);\n    },\n};\n","import ko from \"knockout\";\nimport apiCore from \"services/apiCore\";\nimport qualityAuth from \"services/qualityAuth\";\n\nconst sentimentsList = ko.observableArray();\nconst DEFAULT_PAGE_NUMBER = 1;\nconst DEFAULT_PAGE_SIZE = 25;\n\nconst updateSentimentsList = function (event) {\n    if (!event) {\n        return;\n    }\n\n    const payload = event.data;\n    if (payload.key == \"transcriptUIAnnotations\") {\n        sentimentsList(payload.transfer);\n    }\n};\n\nconst resetSentimentsList = function () {\n    sentimentsList([]);\n};\n\n/**\n * The getConversationMetrics API requires both of the following permissions:\n * 1. speechAndTextAnalytics:data:view\n * 2. recording:recording:view or recording:recordingSegment:view\n * Note: The public-api docs does not mention about recording segment view permission.\n */\nconst canViewConversationMetrics = function (divisionIds) {\n    return (\n        qualityAuth.canViewSpeechAndTextAnalyticsData() &&\n        (qualityAuth.canViewRecording(divisionIds) ||\n            qualityAuth.canViewRecordingSegment(divisionIds))\n    );\n};\n\nconst getConversationMetrics = function (conversationId) {\n    return apiCore.v2.get(\n        \"/speechandtextanalytics/conversations/\" + conversationId\n    );\n};\n\nwindow.addEventListener(\"message\", updateSentimentsList);\n\n/**\n * Get the list of conversation categories associated with the conversation ID.\n * @param {String} conversationId the conversation ID to look up conversation categories with\n * @param {number} pageNumber the page number to get detected categories from\n * @param {number} pageSize the number of categories that each page of results should contain\n */\nconst getConversationCategories = async function (\n    conversationId,\n    pageNumber = DEFAULT_PAGE_NUMBER,\n    pageSize = DEFAULT_PAGE_SIZE\n) {\n    const queryParameters = [];\n    queryParameters.push(\"pageNumber=\" + pageNumber);\n    queryParameters.push(\"pageSize=\" + pageSize);\n\n    return apiCore.v2.get(\n        \"/speechandtextanalytics/conversations/\" +\n            conversationId +\n            \"/categories?\" +\n            queryParameters.join(\"&\")\n    );\n};\n\n/**\n * Get a list of categories depending on the requested list of ids\n * @param {string} ids a comma-delimited string of requested ids\n */\nconst batchGetCategories = async function (ids) {\n    const queryParameters = [];\n    queryParameters.push(\"ids=\" + ids);\n    return apiCore.v2.get(\n        \"/speechandtextanalytics/categories?\" + queryParameters.join(\"&\")\n    );\n};\n\nexport default {\n    sentimentsList: sentimentsList,\n    getConversationMetrics: getConversationMetrics,\n    resetSentimentsList: resetSentimentsList,\n    getConversationCategories: getConversationCategories,\n    batchGetCategories: batchGetCategories,\n    canViewConversationMetrics: canViewConversationMetrics,\n};\n","// these should match QMAnnotationType on the server\nexport default {\n    pause: {\n        iconClassName: \"fa fa-pause\",\n        iconName: \"control-pause\",\n        labelKey: \"annotation.pauseTitle\",\n    },\n    securepause: {\n        iconClassName: \"fa fa-pause\",\n        iconName: \"control-pause\",\n        labelKey: \"annotation.securePauseTitle\",\n    },\n    hold: {\n        iconClassName: \"fa fa-asterisk\",\n        iconName: \"fa/asterix-regular\",\n        labelKey: \"annotation.holdTitle\",\n    },\n    bookmark: {\n        iconClassName: \"fa fa-bookmark\",\n        iconName: \"fa/bookmark-regular\",\n        labelKey: \"annotation.bookmarkTitle\",\n    },\n    unknown: {\n        iconClassName: \"fa fa-asterisk\",\n        iconName: \"fa/asterix-regular\",\n        labelKey: \"annotation.unknownTitle\",\n    },\n    combinedannotations: {\n        iconClassName: \"fa fa-elli