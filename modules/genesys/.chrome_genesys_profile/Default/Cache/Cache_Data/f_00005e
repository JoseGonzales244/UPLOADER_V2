   multiple evaluations for the same conversation/form/agent/etc.).\n//\n// 4. Backend contract\n//    - Backend returns 201 on first create for a key, and 409 Conflict for a\n//      duplicate key. The UI treats 409 (or body code quality.evaluation.already.in.progress)\n//      as \"duplicate evaluation detected\" and shows the corresponding message.\n//\n// ---------------------------------------------------------------------------\n\n// Namespace for create-evaluation idempotency keys.\nconst CREATE_EVALUATION_IDEMPOTENCY_NAMESPACE =\n    \"a8f5e2d1-4b3c-4e9a-8f2d-7c1b6e9a0d4f\";\n\n// Incremented on successful create so the next request gets a different key (see behavior 3 above).\nlet createEvaluationIdempotencyRotation = 0;\n\n/**\n * Resets the idempotency rotation counter. For test isolation only.\n * @internal\n */\nexport function __resetCreateEvaluationIdempotencyForTests() {\n    createEvaluationIdempotencyRotation = 0;\n}\n\n/**\n * Generates a deterministic idempotency key from component strings (UUID v5).\n *\n * @param {string[]} components - Array of strings to include in the key\n * @returns {string} Deterministic idempotency key (UUID v5)\n */\nfunction generateIdempotencyKey(components) {\n    const name = components.join(\"|\");\n    return uuidv5(name, CREATE_EVALUATION_IDEMPOTENCY_NAMESPACE);\n}\n\n/**\n * Generates an idempotency key for createEvaluation requests (UUID v5).\n * See the \"Create-evaluation deduplication\" block above for full behavior.\n * Key = uuidv5(conversationId | evaluationFormId | agentId | queueId | evaluatorId | rotation).\n *\n * @param {Object} evaluation - The evaluation object to create\n * @returns {string} Idempotency key (UUID v5)\n */\nfunction generateIdempotencyKeyForCreateEvaluation(evaluation) {\n    const components = [\n        evaluation.conversation?.id || \"\",\n        evaluation.evaluationForm?.id || \"\",\n        evaluation.agent?.id || \"no-agent\",\n        evaluation.queue?.id || \"no-queue\",\