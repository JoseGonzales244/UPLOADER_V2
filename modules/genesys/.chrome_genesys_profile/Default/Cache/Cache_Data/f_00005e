onitorableViews.length > 0) {\n                    uniqueViews.push(...monitorableViews);\n                } else {\n                    // Prefer the last participant that is not part of the\n                    // agentToMonitorCoachMap (i.e., not monitor/coach/screenMonitor/\n                    // messageMonitor). This ensures bargeIn or regular agent\n                    // participants are picked over screen monitor participants\n                    // when both exist for the same user.\n                    const lastEligibleParticipantForInternalUserList =\n                        isScreenMonitoringEnabled\n                            ? _.findLast(\n                                  participantViews(),\n                                  (otherView) =>\n                                      sameParticipants(view, otherView) &&\n                                      !otherView.isMonitor() &&\n                                      !otherView.isMonitorMessage() &&\n                                      !otherView.isCoach() &&\n                                      !otherView.isScreenMonitor()\n                              )\n                            : null;\n\n                    uniqueViews.push(\n                        lastEligibleParticipantForInternalUserList ||\n                            _.findLast(participantViews(), (otherView) =>\n                                sameParticipants(view, otherView)\n                            )\n                    );\n                }\n            }\n        });\n\n        return uniqueViews;\n    };\n\n    self.uniqueInternalParticipantViews = self.computed(() => {\n        const sameInternalParticipants = (view1, view2) => {\n            return view1.userId === view2.userId;\n        };\n        const uniqueViews = getUniqueParticipantViews(\n            self.conversationDetailsView.internalParticipantViews,\n            sameInternalParticipants\n        );\n        // filters out users who have monitored or coached the conversation\n        const agentsView = uniqueViews.filter((view) => {\n            return (\n                !view.isMonitor() &&\n                !view.isMonitorMessage() &&\n                !view.isCoach() &&\n                !view.isScreenMonitor()\n            );\n        });\n        return agentsView;\n    });\n\n    self.uniqueExternalParticipantViews = self.computed(() => {\n        const sameExternalParticipants = (view1, view2) => {\n            // if externalContactId is undefined then compare the displayed values\n            return (\n                view1.externalContactId === view2.externalContactId &&\n                view1.userDisplayString() === view2.userDisplayString() &&\n                view1.nameDisplayString() === view2.nameDisplayString() &&\n                view1.addressDisplayString() === view2.addressDisplayString() &&\n                view1.extraAddressDisplayInformation() ===\n                    view2.extraAddressDisplayInformation()\n            );\n        };\n        return getUniqueParticipantViews(\n            self.conversationDetailsView.externalParticipantViews,\n            sameExternalParticipants\n        );\n    });\n\n    self.isSingleInternalParticipantView = self.computed(() => {\n        if (\n            self.uniqueInternalParticipantViews().length === 1 &&\n            _.isEmpty(self.agentToMonitorCoachObservable())\n        ) {\n            return true;\n        }\n        return false;\n    });\n\n    self.isSingleExternalParticipantView = self.computed(() => {\n        if (self.uniqueExternalParticipantViews().length === 1) {\n            return true;\n        }\n        return false;\n    });\n\n    self.toggleInternalParticipantPopover = function () {\n        self.hideInternalParticipantPopover(\n            !self.hideInternalParticipantPopover()\n        );\n        self.dismissExternalParticipantPopover();\n    };\n\n    self.toggleExternalParticipantPopover = function () {\n        self.hideExternal