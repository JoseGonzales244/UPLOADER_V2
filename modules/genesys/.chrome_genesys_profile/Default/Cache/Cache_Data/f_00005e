n.not.deleted.title\",\n                        {\n                            bodyMessageKey:\n                                \"playback.nav.evaluation.not.deleted.msg\",\n                        }\n                    );\n                });\n        }\n    };\n\n    self.closePanel = function () {\n        self.sidepanel.close();\n    };\n\n    /**\n     * Adds the audit tab to the conversation page, then loads the template, along with the appropriate view\n     * It also adds the css along with the label to the Audit Tab\n     * @returns void\n     */\n\n    const addAuditTabView = function (\n        templatePath,\n        argumentsList,\n        persistClasses,\n        setPersistDOM\n    ) {\n        const tabContentViews = {};\n        tabContentViews.audit = {\n            view: AuditView,\n            template: templatePath,\n            arguments: argumentsList,\n            persist: true,\n            classNames: persistClasses,\n            persistDOM: setPersistDOM,\n            hash: navHelper.buildInteractionHash(\n                \"admin\",\n                self.conversationId(),\n                \"audit\"\n            ),\n            localHash: `#/admin/${self.conversationId()}/audit`,\n            tabId: PLAYBACK_NAV_TAB_IDS.audit,\n        };\n        const tabMenuItems = getTabMenuItems(\n            PlaybackContext.ADMIN,\n            self.conversationId(),\n            \"audit\",\n            \"audit\",\n            PLAYBACK_NAV_TAB_IDS.audit,\n            TAB_PLACEMENTS.audit\n        );\n        self.tabbedDetails.addTabViews(tabMenuItems, tabContentViews);\n    };\n\n    const addAuditTab = function () {\n        if (\n            qualityAuthorization.canViewAudit() &&\n            !self.tabbedDetails.containsTab(\"audit\")\n        ) {\n            const templatePath = \"templates/auditView\";\n            const argumentsList = [\n                self.conversation,\n                self.computed(() => {\n                    const activeRe