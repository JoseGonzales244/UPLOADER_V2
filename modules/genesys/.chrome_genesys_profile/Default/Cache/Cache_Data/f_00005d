gn the text in the middle of the switch's form\n        position: absolute;\n        top: 50%;\n        .transform( translateY(-50%) );\n    }\n\n    .fs-state-inactive .fs-label {\n        right: @spacing-xs;\n    }\n\n    .fs-state-active .fs-label {\n        left: @spacing-xs;\n    }\n\n    .fs-btn {\n        background-color: #e5e5e5;\n        background-image: linear-gradient(to bottom, #f7f7f7 0, #e5e5e5 100%);\n        border: 0;\n        border-radius: 1em;\n        height: 28px;\n        outline: none;\n        padding: 0;\n        position: absolute;\n        top: 50%;\n        .transform( translateY(-50%) );\n        width: 28px;\n        z-index: 1;\n    }\n\n    &.flipswitch-animate .fs-btn {\n        // utilize a transition animation instead of transform so that the button's\n        // location won't have to care about keeping track of the width of the flipswitch.\n        .transition(all 500ms linear 0s);\n    }\n\n    .flipswitch_animation (@name) {\n        .animation(@name 500ms linear 0s);\n    }\n\n    // ===================================================================================\n    // Off State\n    // ===================================================================================\n\n    &.flipswitch-off .fs-state {\n        border: 1px solid @pc-darkgrey;\n    }\n\n    &.flipswitch-off.flipswitch-animate .fs-state {\n        .flipswitch_animation(flipswitch_off_inactive_state);\n    }\n\n    &.flipswitch-off.flipswitch-animate .fs-state-active {\n        .flipswitch_animation(flipswitch_off_active_state);\n    }\n\n    &.flipswitch-off .fs-btn {\n        left: 1px;\n        margin: 0;\n    }\n\n    // ===================================================================================\n    // On State\n    // ===================================================================================\n\n    &.flipswitch-on .fs-state {\n        border: 0;\n        .transform( scale(0, 1) );\n    }\n\n    &.flipswitch-on.flipswitch-animate .